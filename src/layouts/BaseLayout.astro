---
import { SITE } from '@/config/site';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import TermPopover from '@/components/ui/TermPopover.astro';
import '@/styles/global.css';
import unifiedPagesStylesheet from '@/styles/unified-pages.css?url';

interface Props {
  title?: string;
  description?: string;
  structuredDataType?: 'CollectionPage' | 'TechArticle' | 'WebPage';
  indexable?: boolean;
  searchMetadata?: {
    id: string;
    nameEn: string;
    lookup: string;
    domain: string;
    domainNameZh: string;
    difficulty: string;
    status: string;
  };
}

const {
  title = SITE.name,
  description = SITE.description,
  structuredDataType = 'WebPage',
  indexable = true,
  searchMetadata,
} = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const currentPath = Astro.url.pathname;
/**
 * 内页壳层只有一层导航：顶栏（学习主线三项）+ 页脚（支撑层）。
 * 曾经这里还会再渲染一条全站「内容分类条」，用另一套名词把同一批内容重新分了一遍，
 * 于是每个内页顶部都叠着两组平行入口。那层已经删掉——页面内部的分组属于各板块自己，
 * 不再由全站壳层代劳。
 */
const pagesWithEmbeddedScope = new Set(['/', '/learn/', '/learn/questions/', '/learn/cases/']);
const loadUnifiedPagesStyles = !pagesWithEmbeddedScope.has(currentPath);
const canonicalUrl = SITE.publicOrigin
  ? new URL(Astro.url.pathname.replace(/^\//, ''), `${SITE.publicOrigin}/`).toString()
  : undefined;
const socialImageUrl = SITE.publicOrigin
  ? new URL('og-default.png', `${SITE.publicOrigin}/`).toString()
  : undefined;
const structuredData =
  canonicalUrl && indexable
    ? {
        '@context': 'https://schema.org',
        '@type': structuredDataType,
        name: pageTitle,
        description,
        url: canonicalUrl,
        inLanguage: 'zh-CN',
        isPartOf: {
          '@type': 'WebSite',
          name: SITE.name,
          url: SITE.publicOrigin,
        },
      }
    : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f8fafc" />
    <meta
      name="robots"
      content={SITE.publicOrigin && indexable ? 'index,follow' : 'noindex,nofollow'}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {loadUnifiedPagesStyles && <link rel="stylesheet" href={unifiedPagesStylesheet} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {
      structuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }
    {
      searchMetadata && (
        <>
          <meta data-pagefind-meta="termId[content]" content={searchMetadata.id} />
          <meta data-pagefind-meta="nameEn[content]" content={searchMetadata.nameEn} />
          <meta data-pagefind-meta="lookup[content]" content={searchMetadata.lookup} />
          <meta data-pagefind-meta="domainNameZh[content]" content={searchMetadata.domainNameZh} />
          <meta data-pagefind-meta="status[content]" content={searchMetadata.status} />
          <meta data-pagefind-filter="domain[content]" content={searchMetadata.domain} />
          <meta data-pagefind-filter="difficulty[content]" content={searchMetadata.difficulty} />
          <meta data-pagefind-filter="status[content]" content={searchMetadata.status} />
        </>
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader currentPath={currentPath} />
    <slot />
    <SiteFooter />
    <TermPopover />
    <script>
      const root = document.documentElement;
      root.classList.add('js');
      const reveals = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      if ('IntersectionObserver' in window && reveals.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        for (const element of reveals) observer.observe(element);
      } else {
        for (const element of reveals) element.classList.add('is-visible');
      }
    </script>
  </body>
</html>
