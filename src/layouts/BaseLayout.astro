---
import { SITE } from '@/config/site';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  structuredDataType?: 'CollectionPage' | 'TechArticle' | 'WebPage';
  indexable?: boolean;
  searchMetadata?: {
    id: string;
    nameEn: string;
    lookup: string;
    domain: string;
    domainNameZh: string;
    difficulty: string;
    status: string;
  };
}

const {
  title = SITE.name,
  description = SITE.description,
  structuredDataType = 'WebPage',
  indexable = true,
  searchMetadata,
} = Astro.props;
const pageTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonicalUrl = SITE.publicOrigin
  ? new URL(Astro.url.pathname.replace(/^\//, ''), `${SITE.publicOrigin}/`).toString()
  : undefined;
const socialImageUrl = SITE.publicOrigin
  ? new URL('og-default.png', `${SITE.publicOrigin}/`).toString()
  : undefined;
const structuredData =
  canonicalUrl && indexable
    ? {
        '@context': 'https://schema.org',
        '@type': structuredDataType,
        name: pageTitle,
        description,
        url: canonicalUrl,
        inLanguage: 'zh-CN',
        isPartOf: {
          '@type': 'WebSite',
          name: SITE.name,
          url: SITE.publicOrigin,
        },
      }
    : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#090a0c" />
    <meta
      name="robots"
      content={SITE.publicOrigin && indexable ? 'index,follow' : 'noindex,nofollow'}
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {
      structuredData && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
      )
    }
    {
      searchMetadata && (
        <>
          <meta data-pagefind-meta="termId[content]" content={searchMetadata.id} />
          <meta data-pagefind-meta="nameEn[content]" content={searchMetadata.nameEn} />
          <meta data-pagefind-meta="lookup[content]" content={searchMetadata.lookup} />
          <meta data-pagefind-meta="domainNameZh[content]" content={searchMetadata.domainNameZh} />
          <meta data-pagefind-meta="status[content]" content={searchMetadata.status} />
          <meta data-pagefind-filter="domain[content]" content={searchMetadata.domain} />
          <meta data-pagefind-filter="difficulty[content]" content={searchMetadata.difficulty} />
          <meta data-pagefind-filter="status[content]" content={searchMetadata.status} />
        </>
      )
    }
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader currentPath={Astro.url.pathname} />
    <slot />
    <SiteFooter />
  </body>
</html>
