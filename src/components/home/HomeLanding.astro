---
import {
  LEARNING_MODULES,
  LEARNING_QUESTIONS,
  LEARNING_TIERS,
  getQuestionsForTier,
} from '@/data/learning';
import { loadProjectContent } from '@/lib/content/io';
import { deriveSiteMetrics } from '@/lib/site/metrics';

const project = await loadProjectContent();
const metrics = deriveSiteMetrics(project);
const orderedQuestionIds = LEARNING_QUESTIONS.map((question) => question.id);
---

<main
  id="main-content"
  class="home-landing"
  data-question-order={JSON.stringify(orderedQuestionIds)}
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>落地型 AI 产品经理学习系统</p>
        <h1 id="hero-heading" data-reveal style="--reveal-delay: 60ms">
          从看懂 AI，到做出<span class="hl">可上线</span>的 AI 产品
        </h1>
        <p class="hero-sub" data-reveal style="--reveal-delay: 120ms">
          不是背名词，而是学会判断<b>「该不该用 AI、选什么方案、如何落地、何时上线」</b
          >，并把它做成可评审的产品方案。
        </p>
        <div class="cta-row" data-reveal style="--reveal-delay: 180ms">
          {
            /*
            主入口必须是「学习起点」而不是第一道题：零基础用户点进判断题时还没有任何词汇量，
            题干里的场景与选项对他是噪声。题目退到次入口，由做得出判断的人自己选。
            TODO(I2-03)：/map/ 认知链路页建好后，主 CTA 改为 /map/#foundation；
            在此之前指向 /routes/（已存在的展开阅读清单），不留死链。
          */
          }
          <a class="cta-primary" href="/routes/">从链路第 1 站开始 →</a>
          <a class="cta-ghost" href="/learn/questions/q01-rules-or-ai/" data-hero-start>
            直接做第 01 题
          </a>
          <a class="cta-ghost" href="/search/">我只想搜一个名词</a>
        </div>
      </div>
      <figure class="specimen" data-reveal style="--reveal-delay: 140ms">
        <figcaption class="specimen-label">判断三问 · 每一题都在回答</figcaption>
        <ol class="specimen-questions">
          {
            LEARNING_TIERS.map((tier) => (
              <li>
                <span>{tier.code}</span>
                <p>{tier.prompt}</p>
              </li>
            ))
          }
        </ol>
      </figure>
    </div>
    <dl class="hero-stats" data-reveal style="--reveal-delay: 220ms">
      <div><dd>{LEARNING_QUESTIONS.length}</dd><dt>QUESTIONS</dt></div>
      <div><dd>{LEARNING_TIERS.length}</dd><dt>TIERS</dt></div>
      <div><dd>{LEARNING_MODULES.length}</dd><dt>STAGES</dt></div>
    </dl>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [...LEARNING_QUESTIONS, ...LEARNING_QUESTIONS].map((question) => (
          <span>
            {question.shortTitle} <b>/</b>
          </span>
        ))
      }
    </div>
  </div>

  <section id="learning-structure" class="structure" aria-labelledby="structure-heading">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow">01/ Learning path</p>
        <h2 id="structure-heading">一条从「认得出」到「取舍得了」的路径</h2>
        <p>
          三层递进，每层把六个阶段完整走一遍：先认得出概念，再判断得了边界，最后做得了取舍。三层依次解锁，不需要在入口处做选择。
        </p>
      </header>
      <ol class="level-list" data-level-list>
        {
          LEARNING_TIERS.map((tier, tierIndex) => {
            const tierQuestions = getQuestionsForTier(tier.id);
            const tierIds = tierQuestions.map((question) => question.id);
            return (
              <li
                data-reveal
                data-level={tier.id}
                data-level-ids={JSON.stringify(tierIds)}
                style={`--reveal-delay: ${tierIndex * 80}ms`}
              >
                <span class="level-tag">{tier.code}</span>
                <div>
                  <h3>{tier.title}</h3>
                  <p>{tier.summary}</p>
                  <p class="level-state" data-level-state>
                    {tierIndex === 0 ? `起点 · ${tierIds.length} 道题` : `完成上一层后开启`}
                  </p>
                  <a href="/learn/">
                    {tierIndex === 0 ? `进入 ${tierIds.length} 题 →` : `进入 ${tier.title} →`}
                  </a>
                </div>
              </li>
            );
          })
        }
      </ol>
      <p class="level-foot" data-reveal>
        判断题之后还有案例库与完整项目：
        <a href="/learn/cases/">连续案例</a> ·
        <a href="/learn/cases/user-feedback-analysis/">黄金项目</a>
      </p>
    </div>
  </section>

  <section class="outcomes" aria-labelledby="outcomes-heading">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow">02/ Six stages</p>
        <h2 id="outcomes-heading">六个阶段，练成一套判断方法</h2>
      </header>
      <ol class="outcome-list">
        {
          LEARNING_MODULES.map((module, position) => (
            <li data-reveal style={`--reveal-delay: ${position * 60}ms`}>
              <span class="outcome-index">{module.index}</span>
              <div>
                <h3>{module.title}</h3>
                <p class="outcome-decision">{module.decision}</p>
                <p class="outcome-result">{module.outcome}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="support" aria-labelledby="support-heading">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow">03/ Knowledge base</p>
        <h2 id="support-heading">学习中的知识支持</h2>
        <p>这些是「查」而不是「学」——按需查阅，不必按顺序读。</p>
      </header>
      <p class="structure-support" data-reveal>
        <span class="prompt">$</span> 支撑层：<a href="/atlas/">知识库</a>
        {metrics.termCount} 词条 ·
        <a href="/routes/">阅读路线</a>
        {metrics.publishedRouteCount} 条 ·
        <a href="/graph/">概念图谱</a>
        {metrics.relationCount} 关系 ·
        <a href="/search/">搜索</a>
      </p>
    </div>
  </section>
</main>

<style>
  .home-landing {
    min-width: 0;
    padding-bottom: var(--space-7);
  }

  .shell {
    width: min(1180px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .hero {
    position: relative;
    border-bottom: 1px solid var(--color-line);
    overflow: clip;
  }

  .hero-grid {
    width: min(1180px, calc(100% - 3rem));
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    margin-inline: auto;
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2.5rem, 4vw, 3.5rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }

  .eyebrow::before {
    content: '> ';
    color: var(--color-accent);
  }

  .hero h1 {
    margin: 1.1rem 0 0;
    font-size: clamp(2.2rem, 3.6vw, 3rem);
    font-weight: var(--weight-display);
    line-height: 1.16;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero h1 .hl {
    color: var(--color-accent);
    text-shadow: 0 0 26px color-mix(in oklch, var(--color-accent) 50%, transparent);
  }

  .hero-sub {
    max-width: 34rem;
    margin: 1.3rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-lead);
    line-height: 1.75;
  }

  .hero-sub b {
    color: var(--color-accent-strong);
    font-weight: var(--weight-display);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: 2.2rem;
  }

  .cta-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    background: var(--color-accent);
    color: oklch(0.2 0.05 120);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: var(--weight-display);
    padding: 0 1.7rem;
    text-decoration: none;
    white-space: nowrap;
    clip-path: polygon(
      0 0,
      calc(100% - 12px) 0,
      100% 12px,
      100% 100%,
      12px 100%,
      0 calc(100% - 12px)
    );
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .cta-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 color-mix(in oklch, var(--color-accent-strong) 55%, transparent);
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 0 1.5rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .cta-ghost:hover {
    border-color: var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  /* 判断三问：用上下细线做「排版框」，不重绘窗口边框。
     hero 讲方法（每一题都在回答什么），不讲某一道题的答案。 */
  .specimen {
    margin: 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-4) 0;
  }

  .specimen-label {
    margin: 0 0 var(--space-3);
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }

  .specimen-questions {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .specimen-questions li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: baseline;
  }

  .specimen-questions span {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }

  .specimen-questions p {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-lead);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .structure-support .prompt {
    color: var(--color-accent);
  }

  /* 数据条 */
  .hero-stats {
    width: min(1180px, calc(100% - 3rem));
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0 auto;
    border-top: 1px solid var(--color-line);
  }

  .hero-stats div {
    padding: 1.1rem 1.2rem;
    border-right: 1px solid var(--color-line);
  }

  .hero-stats div:last-child {
    border-right: 0;
  }

  .hero-stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.55rem;
    font-weight: var(--weight-display);
    color: var(--color-accent);
  }

  .hero-stats dt {
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: var(--color-quiet);
  }

  /* 跑马灯（全页仅此一条） */
  .marquee {
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-panel);
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .marquee span {
    padding: 0.55rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent-strong);
    white-space: nowrap;
  }

  .marquee span::after {
    content: '';
    margin-inline: 1.2rem;
    color: var(--color-accent);
  }

  .marquee b {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee-scroll 40s linear infinite;
    }
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* 通用区块 */
  .structure,
  .outcomes,
  .support {
    padding-block: 4.2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 2.4rem;
  }

  .sec-head .eyebrow {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .sec-head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: var(--weight-display);
    letter-spacing: -0.01em;
  }

  .sec-head p {
    max-width: 30rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .level-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .level-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    padding: 1.7rem 1.6rem;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .level-list li:hover {
    transform: translate(-3px, -3px);
    border-color: var(--color-accent);
    box-shadow: 8px 8px 0 color-mix(in oklch, var(--color-accent) 14%, transparent);
  }

  .level-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line);
    background: var(--color-accent-wash);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: var(--weight-display);
  }

  .level-list h3 {
    margin: 0;
    font-size: 1.18rem;
    font-weight: var(--weight-display);
  }

  .level-list p {
    margin: 0.5rem 0 1rem;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .level-list .level-state {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  /* 未解锁的层用虚线边框弱化；答完上一层后由脚本切到 data-unlocked='true' */
  .level-list li[data-unlocked='false'] {
    border-style: dashed;
  }

  .level-list li[data-unlocked='false'] h3,
  .level-list li[data-unlocked='false'] p {
    color: color-mix(in oklch, var(--color-muted) 82%, transparent);
  }

  .level-list li[data-unlocked='true'] {
    border-style: solid;
    border-color: color-mix(in oklch, var(--color-accent) 45%, var(--color-line));
  }

  .level-list li[data-unlocked='true'] .level-state {
    color: var(--color-accent);
  }

  .level-foot {
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.86rem;
  }

  .level-foot a {
    color: var(--color-accent-strong);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklch, var(--color-accent) 35%, transparent);
  }

  .level-foot a:hover {
    color: var(--color-accent);
  }

  .level-list a,
  .structure-support a {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: var(--weight-display);
    text-decoration: none;
  }

  .level-list a:hover,
  .structure-support a:hover {
    color: var(--color-accent);
  }

  .structure-support {
    margin: 1.6rem 0 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .outcome-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outcome-list li {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 1rem;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    padding: 1.3rem 1.2rem;
    transition: border-color var(--transition-fast);
  }

  .outcome-list li:hover {
    border-color: var(--color-accent-strong);
  }

  .outcome-index {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: var(--weight-display);
    color: var(--color-accent);
  }

  .outcome-list h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: var(--weight-display);
  }

  .outcome-decision {
    margin: 0.3rem 0 0;
    font-size: 0.88rem;
    font-weight: var(--weight-display);
  }

  .outcome-result {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.84rem;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .level-list {
      grid-template-columns: 1fr;
    }

    .sec-head {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (max-width: 640px) {
    .shell,
    .hero-grid,
    .hero-stats {
      width: calc(100% - 2rem);
    }

    .cta-row {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-primary,
    .cta-ghost {
      justify-content: center;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-stats div {
      border-bottom: 1px solid var(--color-line);
    }

    .outcome-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const PROGRESS_KEY = 'ai-native.progress';
  const landing = document.querySelector<HTMLElement>('[data-question-order]');
  // data-hero-start 现在是「直接做第 01 题」那条次入口——有进度时它就地变成续做入口。
  // 主 CTA（从链路第 1 站开始）指向链路，不受进度影响，标签始终稳定。
  const startLink = document.querySelector<HTMLAnchorElement>('[data-hero-start]');
  const levelList = document.querySelector<HTMLElement>('[data-level-list]');

  let answered: string[] = [];
  try {
    const stored = JSON.parse(localStorage.getItem(PROGRESS_KEY) ?? '{"answered":[]}');
    if (Array.isArray(stored.answered)) answered = stored.answered;
  } catch {
    /* localStorage unavailable; progress is optional */
  }

  if (landing && startLink && answered.length > 0) {
    const order: string[] = JSON.parse(landing.dataset.questionOrder ?? '[]');
    const nextId = order.find((id) => !answered.includes(id));
    startLink.href = nextId ? `/learn/questions/${nextId}/` : '/learn/complete/';
    startLink.textContent = nextId
      ? `继续学习 · 已答 ${answered.length} / ${order.length} 题`
      : `三层训练已完成 · 查看结业`;
  }

  if (levelList) {
    const answeredSet = new Set(answered);
    const levels = [...levelList.querySelectorAll<HTMLElement>('[data-level-ids]')];
    // 递进解锁：第一层始终可进入，之后每一层要求上一层全部答完。
    let previousComplete = true;
    let allComplete = levels.length > 0;

    levels.forEach((level, index) => {
      const ids: string[] = JSON.parse(level.dataset.levelIds ?? '[]');
      const done = ids.filter((id) => answeredSet.has(id)).length;
      const complete = ids.length > 0 && done === ids.length;
      const unlocked = index === 0 || previousComplete;
      const state = level.querySelector<HTMLElement>('[data-level-state]');

      level.dataset.unlocked = String(unlocked);
      if (state) {
        if (complete) state.textContent = `已完成 · ${done} / ${ids.length}`;
        else if (!unlocked) state.textContent = '完成上一层后开启';
        else if (done > 0) state.textContent = `进行中 · 已答 ${done} / ${ids.length}`;
        else state.textContent = `起点 · ${ids.length} 道题`;
      }

      previousComplete = complete;
      if (!complete) allComplete = false;
    });

    if (allComplete) levelList.dataset.unlocked = 'true';
  }
</script>
