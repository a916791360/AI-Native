---
import { LEARNING_MODULES, LEARNING_QUESTIONS } from '@/data/learning';
import { loadCaseStudies } from '@/lib/cases/io';
import { loadProjectContent } from '@/lib/content/io';
import { deriveSiteMetrics } from '@/lib/site/metrics';

const [project, cases] = await Promise.all([loadProjectContent(), loadCaseStudies()]);
const metrics = deriveSiteMetrics(project);
const orderedQuestionIds = LEARNING_QUESTIONS.map((question) => question.id);
---

<main
  id="main-content"
  class="home-landing"
  data-question-order={JSON.stringify(orderedQuestionIds)}
>
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>落地型 AI 产品经理学习系统</p>
        <h1 id="hero-heading" data-reveal style="--reveal-delay: 60ms">
          从看懂 AI，到做出<span class="hl">可上线</span>的 AI 产品
        </h1>
        <p class="hero-sub" data-reveal style="--reveal-delay: 120ms">
          不是背名词，而是学会判断<b>「该不该用 AI、选什么方案、如何落地、何时上线」</b
          >，并把它做成可评审的产品方案。
        </p>
        <div class="cta-row" data-reveal style="--reveal-delay: 180ms">
          <a class="cta-primary" href="/learn/questions/q01-rules-or-ai/" data-hero-start>
            从第 01 题开始 →
          </a>
          <a class="cta-ghost" href="#learning-structure">先看学习结构</a>
        </div>
      </div>
      <div class="term" aria-hidden="true" data-reveal style="--reveal-delay: 140ms">
        <div class="term-bar">
          <span class="dots"><i></i><i></i><i></i></span>
          <span>ai-native --status</span>
        </div>
        <div class="term-body">
          <p><span class="prompt">$</span> ai-native <b>judge</b> --scenario 发票金额校验</p>
          <p class="ok">✓ 推荐路径：确定性规则计算并校验</p>
          <p><span class="prompt">$</span> ai-native <b>route</b> --career</p>
          <p class="ok">✓ L1 判断 → L2 案例 → L3 项目</p>
          <p><span class="prompt">$</span> ai-native <b>atlas</b> --count</p>
          <p class="ok">
            ✓ {metrics.termCount} terms · {metrics.relationCount} relations · {metrics.domainCount} domains
          </p>
          <p class="cursor-line"><span class="prompt">$</span> <i aria-hidden="true"></i></p>
        </div>
      </div>
    </div>
    <dl class="hero-stats" data-reveal style="--reveal-delay: 220ms">
      <div><dd>{LEARNING_QUESTIONS.length}</dd><dt>QUESTIONS</dt></div>
      <div><dd>{LEARNING_MODULES.length}</dd><dt>STAGES</dt></div>
      <div><dd>{cases.length}</dd><dt>CASES</dt></div>
    </dl>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [...LEARNING_QUESTIONS, ...LEARNING_QUESTIONS].map((question) => (
          <span>
            {question.shortTitle} <b>/</b>
          </span>
        ))
      }
    </div>
  </div>

  <section id="learning-structure" class="structure" aria-labelledby="structure-heading">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow">01/ Learning path</p>
        <h2 id="structure-heading">一条从「会判断」到「能落地」的路径</h2>
        <p>
          先建立判断，再用连续案例练习，最后在完整项目里交付；知识图鉴、阅读路线、概念图谱和搜索，是你随时可查的支撑层。
        </p>
      </header>
      <ol class="level-list">
        <li data-reveal>
          <span class="level-tag">L1</span>
          <div>
            <h3>基础判断</h3>
            <p>六阶段、24 道判断题，建立「是否需要 AI、选什么方案、如何保证质量」的判断方法。</p>
            <a href="/learn/">进入 24 题 →</a>
          </div>
        </li>
        <li data-reveal style="--reveal-delay: 80ms">
          <span class="level-tag">L2</span>
          <div>
            <h3>连续案例</h3>
            <p>同一个业务对象，连续做六次评审，把判断放进真实情境里反复练习。</p>
            <a href="/learn/cases/">进入案例库 →</a>
          </div>
        </li>
        <li data-reveal style="--reveal-delay: 160ms">
          <span class="level-tag">L3</span>
          <div>
            <h3>完整项目</h3>
            <p>把机会、方案、体验、质量与运营串成一份可评审的 AI 产品档案。</p>
            <a href="/learn/cases/user-feedback-analysis/">看黄金项目 →</a>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="outcomes" aria-labelledby="outcomes-heading">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow">02/ Six stages</p>
        <h2 id="outcomes-heading">六个阶段，练成一套判断方法</h2>
      </header>
      <ol class="outcome-list">
        {
          LEARNING_MODULES.map((module, position) => (
            <li data-reveal style={`--reveal-delay: ${position * 60}ms`}>
              <span class="outcome-index">{module.index}</span>
              <div>
                <h3>{module.title}</h3>
                <p class="outcome-decision">{module.decision}</p>
                <p class="outcome-result">{module.outcome}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="support" aria-labelledby="support-heading">
    <div class="shell">
      <header class="sec-head" data-reveal>
        <p class="eyebrow">03/ Knowledge base</p>
        <h2 id="support-heading">学习中的知识支持</h2>
        <p>这些是「查」而不是「学」——按需查阅，不必按顺序读。</p>
      </header>
      <p class="structure-support" data-reveal>
        <span class="prompt">$</span> 支撑层：<a href="/atlas/">知识图鉴</a>
        {metrics.termCount} 词条 ·
        <a href="/routes/">阅读路线</a>
        {metrics.publishedRouteCount} 条 ·
        <a href="/graph/">概念图谱</a>
        {metrics.relationCount} 关系 ·
        <a href="/search/">搜索</a>
      </p>
    </div>
  </section>
</main>

<style>
  .home-landing {
    min-width: 0;
    padding-bottom: var(--space-7);
  }

  .shell {
    width: min(1180px, calc(100% - 3rem));
    margin-inline: auto;
  }

  .hero {
    position: relative;
    border-bottom: 1px solid var(--color-line);
    overflow: hidden;
  }

  .hero-grid {
    width: min(1180px, calc(100% - 3rem));
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    margin-inline: auto;
    padding-block: clamp(3rem, 6vw, 4.5rem) clamp(2.5rem, 4vw, 3.5rem);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
  }

  .eyebrow::before {
    content: '> ';
    color: var(--color-accent);
  }

  .hero h1 {
    margin: 1.1rem 0 0;
    font-size: clamp(2.2rem, 3.6vw, 3rem);
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .hero h1 .hl {
    color: var(--color-accent);
    text-shadow: 0 0 26px color-mix(in oklch, var(--color-accent) 50%, transparent);
  }

  .hero-sub {
    max-width: 34rem;
    margin: 1.3rem 0 0;
    color: var(--color-muted);
    font-size: var(--text-lead);
    line-height: 1.75;
  }

  .hero-sub b {
    color: var(--color-accent-strong);
    font-weight: 600;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: 2.2rem;
  }

  .cta-primary {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    background: var(--color-accent);
    color: oklch(0.2 0.05 120);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 800;
    padding: 0 1.7rem;
    text-decoration: none;
    white-space: nowrap;
    clip-path: polygon(
      0 0,
      calc(100% - 12px) 0,
      100% 12px,
      100% 100%,
      12px 100%,
      0 calc(100% - 12px)
    );
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .cta-primary:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 color-mix(in oklch, var(--color-accent-strong) 55%, transparent);
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    padding: 0 1.5rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .cta-ghost:hover {
    border-color: var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  /* 终端窗口 */
  .term {
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    box-shadow: var(--shadow-hover);
  }

  .term-bar {
    display: flex;
    gap: 0.8rem;
    align-items: center;
    border-bottom: 1px solid var(--color-line);
    padding: 0.6rem 0.9rem;
    color: var(--color-quiet);
    font-size: 0.72rem;
  }

  .term-bar .dots {
    display: flex;
    gap: 0.35rem;
  }

  .term-bar .dots i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-quiet);
  }

  .term-bar .dots i:nth-child(1) {
    background: var(--color-accent);
  }

  .term-bar .dots i:nth-child(2) {
    background: var(--color-accent-strong);
  }

  .term-body {
    padding: 1.1rem 1.2rem;
    line-height: 2.1;
  }

  .term-body p {
    margin: 0;
    color: var(--color-muted);
  }

  .term-body b {
    color: var(--color-accent-strong);
  }

  .term-body .ok {
    color: var(--color-accent);
  }

  .term-body .prompt,
  .structure-support .prompt {
    color: var(--color-accent);
  }

  .cursor-line i {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    vertical-align: -0.15em;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor-line i {
      animation: term-blink 1.1s steps(1) infinite;
    }
  }

  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }

  /* 数据条 */
  .hero-stats {
    width: min(1180px, calc(100% - 3rem));
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0 auto;
    border-top: 1px solid var(--color-line);
  }

  .hero-stats div {
    padding: 1.1rem 1.2rem;
    border-right: 1px solid var(--color-line);
  }

  .hero-stats div:last-child {
    border-right: 0;
  }

  .hero-stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .hero-stats dt {
    margin-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: var(--color-quiet);
  }

  /* 跑马灯（全页仅此一条） */
  .marquee {
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-panel);
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .marquee span {
    padding: 0.55rem 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent-strong);
    white-space: nowrap;
  }

  .marquee span::after {
    content: '';
    margin-inline: 1.2rem;
    color: var(--color-accent);
  }

  .marquee b {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee-scroll 40s linear infinite;
    }
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* 通用区块 */
  .structure,
  .outcomes,
  .support {
    padding-block: 4.2rem;
    border-bottom: 1px solid var(--color-line);
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: 2.4rem;
  }

  .sec-head .eyebrow {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .sec-head h2 {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .sec-head p {
    max-width: 30rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  .level-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .level-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    padding: 1.7rem 1.6rem;
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .level-list li:hover {
    transform: translate(-3px, -3px);
    border-color: var(--color-accent);
    box-shadow: 8px 8px 0 color-mix(in oklch, var(--color-accent) 14%, transparent);
  }

  .level-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line);
    background: var(--color-accent-wash);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .level-list h3 {
    margin: 0;
    font-size: 1.18rem;
    font-weight: 800;
  }

  .level-list p {
    margin: 0.5rem 0 1rem;
    color: var(--color-muted);
    font-size: 0.88rem;
  }

  .level-list a,
  .structure-support a {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
  }

  .level-list a:hover,
  .structure-support a:hover {
    color: var(--color-accent);
  }

  .structure-support {
    margin: 1.6rem 0 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .outcome-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outcome-list li {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 1rem;
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    padding: 1.3rem 1.2rem;
    transition: border-color var(--transition-fast);
  }

  .outcome-list li:hover {
    border-color: var(--color-accent-strong);
  }

  .outcome-index {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .outcome-list h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 800;
  }

  .outcome-decision {
    margin: 0.3rem 0 0;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .outcome-result {
    margin: 0.15rem 0 0;
    color: var(--color-muted);
    font-size: 0.84rem;
  }

  @media (max-width: 960px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .level-list {
      grid-template-columns: 1fr;
    }

    .sec-head {
      flex-direction: column;
      gap: 0.5rem;
    }
  }

  @media (max-width: 640px) {
    .shell,
    .hero-grid,
    .hero-stats {
      width: calc(100% - 2rem);
    }

    .cta-row {
      flex-direction: column;
      align-items: stretch;
    }

    .cta-primary,
    .cta-ghost {
      justify-content: center;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-stats div {
      border-bottom: 1px solid var(--color-line);
    }

    .outcome-list {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const PROGRESS_KEY = 'ai-native.progress';
  const landing = document.querySelector<HTMLElement>('[data-question-order]');
  const startLink = document.querySelector<HTMLAnchorElement>('[data-hero-start]');
  if (landing && startLink) {
    let answered: string[] = [];
    try {
      const stored = JSON.parse(localStorage.getItem(PROGRESS_KEY) ?? '{"answered":[]}');
      if (Array.isArray(stored.answered)) answered = stored.answered;
    } catch {
      /* localStorage unavailable */
    }
    if (answered.length > 0) {
      const order: string[] = JSON.parse(landing.dataset.questionOrder ?? '[]');
      const answeredSet = new Set(answered);
      const nextId = order.find((id) => !answeredSet.has(id));
      if (nextId) {
        startLink.href = `/learn/questions/${nextId}/`;
        startLink.textContent = `继续学习 · 已答 ${answered.length} 题`;
      }
    }
  }
</script>
