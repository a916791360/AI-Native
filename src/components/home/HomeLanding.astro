---
import { SECTIONS } from '@/config/sections';
import {
  LEARNING_MODULES,
  LEARNING_QUESTIONS,
  LEARNING_TIERS,
  getQuestionsForTier,
} from '@/data/learning';
import { loadProjectContent } from '@/lib/content/io';
import { deriveSiteMetrics } from '@/lib/site/metrics';

const project = await loadProjectContent();
const metrics = deriveSiteMetrics(project);
const orderedQuestionIds = LEARNING_QUESTIONS.map((question) => question.id);
const entrySections = SECTIONS.filter(({ surface }) => surface === 'primary');
---

<main
  id="main-content"
  class="home-landing"
  data-question-order={JSON.stringify(orderedQuestionIds)}
>
  <!-- Hero Section (Better-Interface & Hallmark Compliant Daylight Layout) -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="hero-badge">
          <span>AI-Native 实战判断系统 · 面向产品人</span>
        </div>

        <h1 id="hero-heading">
          从看懂 AI，到做出<span class="hl">可上线</span>的 AI 产品
        </h1>

        <p class="hero-sub">
          不是背名词，而是学会判断<b>「该不该用 AI、选什么方案、如何落地、何时上线」</b>，并通过 90
          道场景决策关卡与 6 大端到端案例，将其转化为可评审的产品方案。
        </p>

        <div class="cta-row">
          <a class="cta-primary" href="/map/#station-1">从链路第 1 站开始 →</a>
          <a class="cta-ghost" href="/learn/questions/q01-rules-or-ai/" data-hero-start>
            直接做第 01 题
          </a>
          <a class="cta-ghost" href="/search/">我只想搜一个名词</a>
        </div>

        <div class="hero-metrics">
          <div class="metric-pill">
            <span class="m-val">{metrics.termCount}</span>
            <span class="m-txt">深度核验词条</span>
          </div>
          <span class="metric-sep">/</span>
          <div class="metric-pill">
            <span class="m-val">90</span>
            <span class="m-txt">场景决策关卡</span>
          </div>
          <span class="metric-sep">/</span>
          <div class="metric-pill">
            <span class="m-val">6</span>
            <span class="m-txt">端到端案例</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Decision Sandbox Widget (Authentic Clean Surface, No Fake Chrome) -->
      <div class="hero-sandbox">
        <div class="sandbox-card">
          <div class="sandbox-header">
            <span class="sandbox-title">决策沙盘 · 场景实战模拟</span>
            <span class="live-tag">可交互试做</span>
          </div>

          <div class="sandbox-body">
            <div class="scenario-badge">场景聚焦</div>
            <p class="scenario-text">
              <strong>每天面临 5,000 条客服反馈</strong
              >，需实时进行情绪标签分类与紧急度打标，如何架构？
            </p>

            <form class="sandbox-form" onsubmit="return false;">
              <label class="opt-label" for="home-opt-1">
                <input type="radio" id="home-opt-1" name="home-q1" value="1" />
                <span class="radio-circle"></span>
                <span class="opt-text">方案 A：全部直接调用大模型，每条实时零样本推理</span>
              </label>

              <label class="opt-label is-recommended" for="home-opt-2">
                <input type="radio" id="home-opt-2" name="home-q1" value="2" checked />
                <span class="radio-circle"></span>
                <div class="opt-content">
                  <span class="opt-text">方案 B：高频规则词优先过滤 + 模糊边界模型精判</span>
                  <span class="rec-tag">推荐最佳实践</span>
                </div>
              </label>

              <label class="opt-label" for="home-opt-3">
                <input type="radio" id="home-opt-3" name="home-q1" value="3" />
                <span class="radio-circle"></span>
                <span class="opt-text">方案 C：完全由人工客服手工逐条标记，不用任何算法</span>
              </label>
            </form>

            <div class="sandbox-insight">
              <div class="insight-head">
                <span class="insight-badge">决策逻辑</span>
                <strong>PM 决策逻辑解析</strong>
              </div>
              <p>
                <strong>混合架构性价比最高：</strong>5,000 条/日的全量调用存在严重的延迟波动与 Token
                成本累积。用规则前置过滤 60% 高确定性意图，仅将 40% 复杂长尾交由模型处理，能在降低
                60%+ 成本的同时将平均响应缩短至 50ms。
              </p>
            </div>
          </div>

          <div class="sandbox-footer">
            <span>选自 Level 1 概念识别关卡</span>
            <a href="/learn/questions/q01-rules-or-ai/" class="enter-full">进入完整答题面板 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 01: Three-Tier Progression Ladder -->
  <section id="learning-structure" class="structure" aria-labelledby="structure-heading">
    <div class="shell">
      <header class="sec-head">
        <span class="sec-kicker">01 · 进阶路径</span>
        <h2 id="structure-heading">三层能力进阶梯级</h2>
        <p>
          每层把六个阶段完整走一遍：先认得出概念，再判断得了边界，最后做得了取舍。三层依次解锁，循序渐进构建确定性的产品思考框架。
        </p>
      </header>

      <ol class="level-list" data-level-list>
        {
          LEARNING_TIERS.map((tier, tierIndex) => {
            const tierQuestions = getQuestionsForTier(tier.id);
            const tierIds = tierQuestions.map((question) => question.id);
            return (
              <li
                data-level={tier.id}
                data-level-ids={JSON.stringify(tierIds)}
                data-unlocked={tierIndex === 0 ? 'true' : 'false'}
              >
                <div class="tier-card-top">
                  <span class="level-tag">{tier.code}</span>
                  <span class="level-state" data-level-state>
                    {tierIndex === 0 ? `起点 · ${tierIds.length} 道题` : `完成上一层后开启`}
                  </span>
                </div>
                <div class="tier-card-body">
                  <h3>{tier.title}</h3>
                  <p class="tier-summary">{tier.summary}</p>
                  <div class="tier-prompt">
                    <strong>核心考查：</strong>
                    {tier.prompt}
                  </div>
                </div>
                <div class="tier-card-foot">
                  <span class="tier-count">{tierIds.length} 道决策题</span>
                  <a href="/learn/" class="tier-link">
                    {tierIndex === 0 ? `进入 ${tierIds.length} 题 →` : `进入 ${tier.title} →`}
                  </a>
                </div>
              </li>
            );
          })
        }
      </ol>

      <p class="level-foot">
        判断题之后还有案例库与完整项目：
        <a href="/learn/cases/">连续案例</a> ·
        <a href="/learn/cases/user-feedback-analysis/">黄金项目</a>
      </p>
    </div>
  </section>

  <!-- Section 02: Six Practical Stages -->
  <section class="outcomes" aria-labelledby="outcomes-heading">
    <div class="shell">
      <header class="sec-head">
        <span class="sec-kicker">02 · 方法体系</span>
        <h2 id="outcomes-heading">六个阶段，练成一套判断方法</h2>
        <p>涵盖从场景识别、方案取舍到上线监控的端到端决策链条：</p>
      </header>

      <ol class="outcome-list">
        {
          LEARNING_MODULES.map((module) => (
            <li class="outcome-card">
              <div class="outcome-top">
                <span class="outcome-index">阶段 0{module.index}</span>
                <h3>{module.title}</h3>
              </div>
              <div class="outcome-row">
                <span class="outcome-label">核心判断</span>
                <p class="outcome-decision">{module.decision}</p>
              </div>
              <div class="outcome-row outcome-result-row">
                <span class="outcome-label">交付标准</span>
                <p class="outcome-result">{module.outcome}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Section 03: Knowledge Base Support -->
  <section class="support" aria-labelledby="support-heading">
    <div class="shell">
      <header class="sec-head">
        <span class="sec-kicker">03 · 知识支撑</span>
        <h2 id="support-heading">学习中的知识支持</h2>
        <p>这些是「查」而不是「学」——按需查阅，不必按顺序读。</p>
      </header>

      <div class="support-card">
        <p class="structure-support">
          <span class="support-tag">支撑层工具</span>
          <a href="/atlas/">知识库</a>
          <span class="count-pill">{metrics.termCount} 词条</span> ·
          <a href="/routes/">阅读路线</a>
          <span class="count-pill">{metrics.publishedRouteCount} 条</span> ·
          <a href="/graph/">概念图谱</a>
          <span class="count-pill">{metrics.relationCount} 关系</span> ·
          <a href="/search/">搜索</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Section 04: Four Gateways -->
  <section class="entries" aria-labelledby="entries-heading">
    <div class="shell">
      <header class="sec-head">
        <span class="sec-kicker">04 · 入口导览</span>
        <h2 id="entries-heading">四个入口，各自回答一个问题</h2>
        <p>不知道从哪进的时候，挑那个正好是你在问的入口。</p>
      </header>

      <ol class="entry-list" data-entry-list>
        {
          entrySections.map((section, idx) => (
            <li class="entry-card">
              <div class="entry-card-top">
                <span class="entry-num">0{idx + 1}</span>
                <p class="entry-question">「{section.question}」</p>
              </div>
              <h3>
                <a href={section.href}>{section.navLabel}</a>
                <span class="entry-arrow" aria-hidden="true">
                  →
                </span>
              </h3>
              <p class="entry-purpose">{section.purpose}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Bottom Daylight CTA Banner (Solid Surface, High Contrast) -->
  <section class="home-bottom-cta">
    <div class="shell">
      <div class="bottom-cta-card">
        <h2>从今天开始，构建可被评审的 AI 产品方案</h2>
        <p>
          无需一次学完所有内容，从第 1 站认知链路或第 1 道实战题起步，建立确定性的产品工程直觉。
        </p>
        <div class="bottom-cta-btns">
          <a href="/map/#station-1" class="cta-primary">从链路第 1 站开始 →</a>
          <a href="/learn/cases/" class="cta-secondary">查看 6 大企业级实战案例</a>
        </div>
      </div>
    </div>
  </section>
</main>

<style>
  .home-landing {
    min-width: 0;
    padding-bottom: var(--space-7);
    background-color: var(--color-canvas);
    color: var(--color-ink);
  }

  .shell {
    width: min(1200px, calc(100% - 3rem));
    margin-inline: auto;
  }

  /* ==========================================================================
     Hero Section: Daylight Two-Column Clean Grid (Anti-AI-Slop Solid Surface)
     ========================================================================== */
  .hero {
    position: relative;
    border-bottom: 1px solid var(--color-line);
    padding-block: clamp(3rem, 5.5vw, 4.5rem) clamp(2.5rem, 4.5vw, 3.8rem);
    background-color: var(--color-canvas);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-start;
    padding: 5px 12px;
    background: var(--color-panel);
    border: 1px solid color-mix(in oklch, var(--color-accent) 25%, var(--color-line));
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--weight-display);
    color: var(--color-accent);
    letter-spacing: var(--tracking-label);
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
  }

  .hero h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    font-weight: var(--weight-display);
    line-height: 1.18;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }

  .hero h1 .hl {
    color: var(--color-accent);
    font-weight: var(--weight-display);
  }

  .hero-sub {
    max-width: 36rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lead);
    line-height: 1.68;
  }

  .hero-sub b {
    color: var(--color-ink);
    font-weight: var(--weight-display);
  }

  .cta-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
    flex-wrap: wrap;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    min-height: 2.85rem;
    background: var(--color-accent);
    color: #ffffff;
    font-size: var(--text-sm);
    font-weight: var(--weight-display);
    padding: 0 1.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: 0 4px 14px color-mix(in oklch, var(--color-accent) 28%, transparent);
    transition:
      transform var(--duration-quick) var(--ease-smooth-out),
      box-shadow var(--duration-quick) var(--ease-smooth-out),
      background-color var(--duration-quick) var(--ease-smooth-out);
  }

  .cta-primary:hover {
    transform: translateY(-1px);
    background: var(--color-accent-strong);
    box-shadow: 0 6px 18px color-mix(in oklch, var(--color-accent) 36%, transparent);
  }

  .cta-primary:active {
    transform: scale(var(--scale-large));
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    min-height: 2.85rem;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-display);
    padding: 0 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      transform var(--duration-quick) var(--ease-smooth-out),
      border-color var(--duration-quick) var(--ease-smooth-out),
      background-color var(--duration-quick) var(--ease-smooth-out);
  }

  .cta-ghost:hover {
    background: var(--color-panel-raised);
    border-color: var(--color-control-border);
    color: var(--color-accent-strong);
  }

  .cta-ghost:active {
    transform: scale(var(--scale-large));
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    min-height: 2.85rem;
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-display);
    padding: 0 1.5rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    transition:
      transform var(--duration-quick) var(--ease-smooth-out),
      border-color var(--duration-quick) var(--ease-smooth-out),
      background-color var(--duration-quick) var(--ease-smooth-out);
  }

  .cta-secondary:hover {
    background: var(--color-panel-raised);
    border-color: var(--color-control-border);
  }

  .cta-secondary:active {
    transform: scale(var(--scale-large));
  }

  .hero-metrics {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-line);
  }

  .metric-pill {
    display: flex;
    align-items: baseline;
    gap: var(--space-1);
  }

  .m-val {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .m-txt {
    font-size: var(--text-xs);
    color: var(--color-quiet);
  }

  .metric-sep {
    color: var(--color-line);
    font-size: var(--text-xs);
  }

  /* ==========================================================================
     Daylight Decision Sandbox Card (Right Column - Authentic Surface)
     ========================================================================== */
  .hero-sandbox {
    min-width: 0;
  }

  .sandbox-card {
    background: var(--color-panel);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition:
      box-shadow var(--duration-fast) var(--ease-smooth-out),
      border-color var(--duration-fast) var(--ease-smooth-out);
  }

  .sandbox-card:hover {
    border-color: var(--color-control-border);
    box-shadow: var(--shadow-hover);
  }

  .sandbox-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    background: var(--color-panel-raised);
    border-bottom: 1px solid var(--color-line);
  }

  .sandbox-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-display);
    color: var(--color-ink);
    letter-spacing: var(--tracking-label);
  }

  .live-tag {
    font-size: 11px;
    font-weight: var(--weight-display);
    background: color-mix(in oklch, var(--color-application) 10%, white);
    color: var(--color-application);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in oklch, var(--color-application) 25%, var(--color-line));
  }

  .sandbox-body {
    padding: var(--space-4);
  }

  .scenario-badge {
    display: inline-block;
    font-size: 11px;
    font-weight: var(--weight-display);
    background: var(--color-panel-raised);
    color: var(--color-quiet);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }

  .scenario-text {
    font-size: var(--text-sm);
    color: var(--color-ink);
    line-height: 1.55;
    margin-bottom: var(--space-3);
  }

  .sandbox-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .opt-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background-color var(--duration-quick) var(--ease-smooth-out),
      border-color var(--duration-quick) var(--ease-smooth-out),
      transform var(--duration-quick) var(--ease-smooth-out);
  }

  .opt-label:hover {
    background: var(--color-panel);
    border-color: var(--color-control-border);
  }

  .opt-label:active {
    transform: scale(0.99);
  }

  .opt-label:has(input[type='radio']:focus-visible) {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .opt-label input[type='radio'] {
    position: absolute;
    opacity: 0;
  }

  .radio-circle {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--color-control-border);
    display: inline-block;
    flex-shrink: 0;
    transition:
      border-color var(--duration-quick) var(--ease-smooth-out),
      background-color var(--duration-quick) var(--ease-smooth-out);
  }

  .opt-label input[type='radio']:checked + .radio-circle {
    border-color: var(--color-accent);
    background: var(--color-accent);
    box-shadow: inset 0 0 0 3px #ffffff;
  }

  .opt-label.is-recommended {
    background: color-mix(in oklch, var(--color-accent) 6%, white);
    border-color: color-mix(in oklch, var(--color-accent) 30%, var(--color-line));
  }

  .opt-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .opt-text {
    font-size: var(--text-sm);
    color: var(--color-ink);
  }

  .rec-tag {
    font-size: 11px;
    font-weight: var(--weight-display);
    color: var(--color-accent);
  }

  .sandbox-insight {
    margin-top: var(--space-3);
    background: var(--color-panel-raised);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
  }

  .insight-head {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }

  .insight-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: var(--weight-display);
    background: color-mix(in oklch, var(--color-accent) 12%, white);
    color: var(--color-accent-strong);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in oklch, var(--color-accent) 25%, var(--color-line));
  }

  .insight-head strong {
    font-size: var(--text-xs);
    color: var(--color-ink);
  }

  .sandbox-insight p {
    font-size: var(--text-xs);
    color: var(--color-muted);
    line-height: 1.55;
    margin: 0;
  }

  .sandbox-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-panel-raised);
    border-top: 1px solid var(--color-line);
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-quiet);
