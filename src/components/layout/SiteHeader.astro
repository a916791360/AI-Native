---
import { NAVIGATION } from '@/config/navigation';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
  <a class="site-wordmark" href="/" aria-label="AI-Native 首页">AI-Native</a>
  <p class="site-context">Progressive AI knowledge atlas / zh-CN</p>
  <nav class="desktop-nav" aria-label="主导航">
    {
      NAVIGATION.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <details class="mobile-nav">
    <summary>菜单</summary>
    <nav aria-label="移动端主导航">
      {
        NAVIGATION.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </details>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    min-height: var(--header-height);
    display: grid;
    grid-template-columns: minmax(12rem, 0.75fr) minmax(18rem, 1.5fr) auto;
    align-items: center;
    border-bottom: 1px solid var(--color-line);
    padding: 0 var(--page-gutter);
    background: color-mix(in oklch, var(--color-black) 94%, transparent);
  }

  .site-wordmark {
    width: max-content;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    text-decoration: none;
  }

  .site-context {
    margin: 0;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    gap: var(--space-4);
  }

  .desktop-nav a,
  .mobile-nav a {
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'],
  .mobile-nav a:hover,
  .mobile-nav a[aria-current='page'] {
    color: var(--color-ink);
  }

  .desktop-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--color-prerequisite);
    text-underline-offset: 0.45rem;
  }

  .mobile-nav {
    display: none;
    justify-self: end;
  }

  .mobile-nav summary {
    min-width: 3.5rem;
    min-height: 2.75rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: var(--color-muted);
    font-size: var(--text-sm);
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav nav {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: grid;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-panel);
    padding: var(--space-2) var(--page-gutter) var(--space-3);
  }

  .mobile-nav nav a {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-line-soft);
  }

  @media (max-width: 820px) {
    .site-header {
      grid-template-columns: 1fr auto;
      padding-block: 0.6rem;
    }

    .site-context,
    .desktop-nav {
      display: none;
    }

    .mobile-nav {
      display: block;
    }
  }
</style>
