---
import '@/styles/content-catalog.css';

interface Props {
  active?: 'course' | 'cases' | 'knowledge' | 'routes' | 'graph';
  caseCount: number;
  relationCount: number;
  routeCount: number;
  termCount: number;
}

const { active, caseCount, relationCount, routeCount, termCount } = Astro.props;
const scopes = [
  { id: 'course', href: '/learn/', label: '系统课程', count: 24 },
  { id: 'cases', href: '/learn/cases/', label: '案例实战', count: caseCount },
  { id: 'knowledge', href: '/atlas/', label: '知识词条', count: termCount },
  { id: 'routes', href: '/routes/', label: '阅读路线', count: routeCount },
  { id: 'graph', href: '/graph/', label: '概念关系', count: relationCount },
] as const;
---

<section class="scope-strip" aria-label="内容分类栏">
  <span>内容</span>
  <nav aria-label="内容类型">
    {
      scopes.map((scope) => (
        <a href={scope.href} aria-current={scope.id === active ? 'page' : undefined}>
          {scope.label} <small>{scope.count}</small>
        </a>
      ))
    }
  </nav>
</section>
