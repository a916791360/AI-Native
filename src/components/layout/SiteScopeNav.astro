---
import ContentScopeNav from '@/components/layout/ContentScopeNav.astro';
import caseRegistry from '@/generated/case-registry.json';
import graph from '@/generated/graph.json';
import termRegistry from '@/generated/term-registry.json';

interface Props {
  active?: 'course' | 'cases' | 'knowledge' | 'routes' | 'graph';
}

const { active } = Astro.props;
const routeFiles = import.meta.glob('/src/content/routes/*.mdx');
---

<ContentScopeNav
  active={active}
  caseCount={caseRegistry.cases.length}
  relationCount={graph.edges.length}
  routeCount={Object.keys(routeFiles).length}
  termCount={termRegistry.terms.length}
/>
