---
import { NAVIGATION } from '@/config/navigation';
import { SITE } from '@/config/site';
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="footer-wordmark" href="/">{SITE.name}</a>
      <p>{SITE.description}</p>
    </div>
    <nav aria-label="页脚导航">
      {NAVIGATION.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/methodology/">内容方法</a>
      <a href={SITE.repositoryUrl}>GitHub</a>
    </nav>
    <p class="footer-state">学习首版 · 内容持续校订</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding: var(--space-4) 0;
    color: var(--color-muted);
  }

  .footer-inner {
    width: min(calc(100% - 2.5rem), var(--content-max));
    display: grid;
    grid-template-columns: minmax(18rem, 1fr) minmax(24rem, auto);
    gap: var(--space-3) var(--space-5);
    align-items: start;
    margin-inline: auto;
  }

  .footer-brand p {
    max-width: 30rem;
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  .footer-wordmark {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.4rem;
    text-decoration: none;
  }

  .site-footer nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
  }

  .site-footer nav a {
    min-height: var(--control-height);
    display: inline-flex;
    align-items: center;
    font-size: var(--text-sm);
  }

  .footer-state {
    grid-column: 1 / -1;
    margin: 0;
    border-top: 1px solid var(--color-line-soft);
    padding-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs) !important;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .footer-inner {
      width: min(calc(100% - 2rem), var(--content-max));
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .site-footer nav {
      justify-content: flex-start;
    }

    .site-footer nav a {
      min-height: var(--control-height-mobile);
    }

    .footer-state {
      grid-column: auto;
    }
  }
</style>
