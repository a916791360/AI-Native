---
import type { Domain } from '@/lib/content/schema';
import type { GraphData, GraphRelationType } from '@/lib/graph/model';

interface Props {
  graph: GraphData;
  mode?: 'full' | 'local';
  focusId?: string;
  domains?: Domain[];
  hiddenNodeCount?: number;
}

const {
  graph,
  mode = 'full',
  focusId = graph.nodes[0]?.id,
  domains = [],
  hiddenNodeCount = 0,
} = Astro.props;
const relationOptions: { type: GraphRelationType; label: string }[] = [
  { type: 'prerequisite', label: '前置' },
  { type: 'component', label: '组成' },
  { type: 'comparison', label: '比较' },
  { type: 'application', label: '应用' },
];
const initialNode = graph.nodes.find((node) => node.id === focusId) ?? graph.nodes[0];
const serializedGraph = JSON.stringify(graph).replaceAll('<', '\\u003c');
---

<section
  class:list={['graph-explorer', `mode-${mode}`]}
  data-graph-explorer
  data-graph-mode={mode}
  data-graph-focus={focusId}
  data-graph-state="idle"
  aria-labelledby={`graph-explorer-${mode}-${focusId}`}
>
  <header class="graph-explorer-header">
    <div>
      <p class="meta-label">
        {mode === 'full' ? 'Interactive relation field' : 'Local relation field'}
      </p>
      <h2 id={`graph-explorer-${mode}-${focusId}`}>
        {mode === 'full' ? '关系场' : `${initialNode?.label ?? '当前词条'}的一层关系`}
      </h2>
    </div>
    <p>
      {
        mode === 'full'
          ? `${graph.nodes.length} 个节点 · ${graph.edges.length} 条真实关系`
          : `${graph.nodes.length} 个节点 · ${graph.edges.length} 条直接关系`
      }
      {hiddenNodeCount > 0 && ` · 另有 ${hiddenNodeCount} 个节点已折叠`}
    </p>
  </header>

  <div class="graph-controls" aria-label="图谱控制">
    {
      mode === 'full' && (
        <label class="graph-select-control">
          <span>领域</span>
          <select data-graph-domain>
            <option value="">全部领域</option>
            {domains.map((domain) => (
              <option value={domain.id}>{domain.shortNameZh}</option>
            ))}
          </select>
        </label>
      )
    }
    <label class="graph-select-control graph-focus-control">
      <span>焦点词条</span>
      <select data-graph-focus-select>
        {
          graph.nodes.map((node) => (
            <option value={node.id} selected={node.id === initialNode?.id}>
              {node.label}
            </option>
          ))
        }
      </select>
    </label>
    <fieldset class="graph-relation-filters">
      <legend>关系类型</legend>
      {
        relationOptions.map((option) => (
          <label class={`relation-${option.type}`}>
            <input type="checkbox" value={option.type} data-graph-relation checked />
            <span>{option.label}</span>
          </label>
        ))
      }
    </fieldset>
    <div class="graph-view-controls">
      <button type="button" data-graph-action="zoom-out" title="缩小图谱" disabled>缩小</button>
      <button type="button" data-graph-action="zoom-in" title="放大图谱" disabled>放大</button>
      <button type="button" data-graph-action="reset" title="重置图谱视口" disabled>重置</button>
    </div>
  </div>

  <button type="button" class="graph-mobile-launch" data-graph-load> 打开交互图谱 </button>

  <div class="graph-workspace" data-graph-workspace>
    <div class="graph-stage">
      <div
        class="graph-canvas"
        data-graph-canvas
        role="img"
        tabindex="0"
        aria-label="可平移和缩放的概念关系图"
        aria-busy="false"
      >
      </div>
      <div class="graph-state" data-graph-status aria-live="polite">
        <span>图谱进入视口后加载</span>
      </div>
    </div>

    <aside class="graph-detail" data-graph-detail aria-live="polite">
      <p class="meta-label">当前焦点</p>
      <h3 data-graph-detail-title>{initialNode?.label ?? '选择一个词条'}</h3>
      <p class="graph-detail-en" data-graph-detail-en>{initialNode?.labelEn}</p>
      <p data-graph-detail-summary>{initialNode?.summary ?? '从图中选择节点查看概念边界。'}</p>
      <ul data-graph-detail-relations></ul>
      <a href={initialNode?.url ?? '/atlas/'} data-graph-detail-link>阅读词条</a>
    </aside>
  </div>

  <p class="graph-equivalent">交互图谱之外，本页下方保留完整文字关系与词条链接。</p>
  <noscript><p class="graph-noscript">JavaScript 未启用，继续阅读下方关系表。</p></noscript>
  <script is:inline type="application/json" data-graph-data set:html={serializedGraph} />
</section>

<script>
  import '@/scripts/graph-explorer';
</script>

<style is:global>
  .graph-explorer {
    border-bottom: 1px solid var(--color-line);
    background: var(--color-black);
  }
  .graph-explorer-header {
    min-height: 10rem;
    display: grid;
    grid-template-columns: minmax(18rem, 0.55fr) minmax(20rem, 1fr);
    align-items: end;
    gap: var(--space-5);
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-5) var(--page-gutter);
  }
  .graph-explorer-header h2 {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: var(--weight-body);
    line-height: 1;
  }
  .graph-explorer-header > p {
    justify-self: end;
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .graph-controls {
    display: grid;
    grid-template-columns: minmax(12rem, 0.7fr) minmax(13rem, 0.8fr) minmax(22rem, 1.4fr) auto;
    border-bottom: 1px solid var(--color-line);
    padding-inline: var(--page-gutter);
  }
  .mode-local .graph-controls {
    grid-template-columns: minmax(13rem, 0.7fr) minmax(22rem, 1.4fr) auto;
  }
  .graph-select-control {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    border-right: 1px solid var(--color-line-soft);
    padding: var(--space-2) var(--space-3);
  }
  .graph-select-control:first-child {
    padding-left: 0;
  }
  .graph-select-control > span,
  .graph-relation-filters legend {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .graph-select-control select {
    min-width: 0;
    min-height: 2.75rem;
    border: 0;
    background: var(--color-black);
    color: var(--color-ink);
  }
  .graph-relation-filters {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    border: 0;
    border-right: 1px solid var(--color-line-soft);
    padding: var(--space-2) var(--space-3);
  }
  .graph-relation-filters legend {
    float: left;
    margin-right: var(--space-2);
  }
  .graph-relation-filters label {
    min-height: var(--control-height);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  .graph-relation-filters input {
    width: 0.95rem;
    height: 0.95rem;
    accent-color: currentColor;
  }
  .relation-prerequisite {
    color: var(--color-prerequisite) !important;
  }
  .relation-component {
    color: var(--color-component) !important;
  }
  .relation-comparison {
    color: var(--color-comparison) !important;
  }
  .relation-application {
    color: var(--color-application) !important;
  }
  .graph-view-controls {
    display: flex;
  }
  .graph-view-controls button {
    min-width: 4.6rem;
    border: 0;
    border-right: 1px solid var(--color-line-soft);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }
  .graph-view-controls button:hover:not(:disabled) {
    color: var(--color-prerequisite);
  }
  .graph-view-controls button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .graph-explorer[data-graph-state='loading'] .graph-view-controls button:disabled {
    cursor: wait;
  }
  .graph-mobile-launch {
    display: none;
  }
  .graph-workspace {
    min-height: 42rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.28fr);
  }
  .graph-stage {
    position: relative;
    min-width: 0;
    min-height: 42rem;
    overflow: hidden;
    border-right: 1px solid var(--color-line);
    background-image:
      linear-gradient(var(--color-line-soft) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line-soft) 1px, transparent 1px);
    background-size: 4rem 4rem;
  }
  .graph-canvas {
    position: absolute;
    inset: 0;
  }
  .graph-canvas:focus-visible {
    outline: 2px solid var(--color-prerequisite);
    outline-offset: -3px;
  }
  .graph-state {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .graph-explorer[data-graph-state='ready'] .graph-state {
    display: none;
  }
  .graph-explorer[data-graph-state='error'] .graph-state {
    color: var(--color-comparison);
  }
  .graph-explorer[data-graph-state='empty'] .graph-state {
    color: var(--color-prerequisite);
  }
  .graph-detail {
    min-width: 0;
    padding: var(--space-5) var(--page-gutter);
  }
  .graph-detail h3 {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: var(--weight-body);
    line-height: 1.1;
  }
  .graph-detail-en {
    margin: var(--space-1) 0 var(--space-4) !important;
    color: var(--color-quiet) !important;
    font-family: var(--font-mono);
    font-size: var(--text-xs) !important;
  }
  .graph-detail > p:not(.meta-label) {
    color: var(--color-muted);
  }
  .graph-detail ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0;
    padding: 0;
    list-style: none;
  }
  .graph-detail li {
    border-top: 1px solid var(--color-line-soft);
    padding-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .graph-detail li span {
    display: block;
    margin-bottom: 0.2rem;
    color: var(--color-component);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .graph-detail a {
    color: var(--color-prerequisite);
  }
  .graph-equivalent,
  .graph-noscript {
    margin: 0;
    border-top: 1px solid var(--color-line);
    padding: var(--space-3) var(--page-gutter);
    color: var(--color-quiet);
    font-size: var(--text-sm);
  }

  @media (max-width: 1100px) {
    .graph-controls,
    .mode-local .graph-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: 0;
    }
    .graph-select-control,
    .graph-relation-filters {
      border-bottom: 1px solid var(--color-line-soft);
      padding-inline: var(--space-3);
    }
    .graph-relation-filters {
      flex-wrap: wrap;
    }
    .graph-view-controls {
      min-height: 3.5rem;
    }
    .graph-view-controls button {
      flex: 1;
    }
  }

  @media (max-width: 760px) {
    .graph-explorer-header {
      min-height: 9rem;
      grid-template-columns: 1fr;
      align-items: start;
      gap: var(--space-3);
    }
    .graph-explorer-header h2 {
      font-size: 2.35rem;
    }
    .graph-explorer-header > p {
      justify-self: start;
    }
    .graph-controls,
    .mode-local .graph-controls {
      grid-template-columns: 1fr;
    }
    .graph-relation-filters {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .graph-relation-filters label {
      min-height: var(--control-height-mobile);
    }
    .graph-relation-filters legend {
      grid-column: 1 / -1;
    }
    .graph-mobile-launch {
      width: 100%;
      min-height: 3.5rem;
      display: block;
      border: 0;
      border-bottom: 1px solid var(--color-line);
      background: transparent;
      color: var(--color-prerequisite);
      cursor: pointer;
    }
    .graph-workspace {
      min-height: 0;
      display: none;
      grid-template-columns: 1fr;
    }
    .graph-explorer.is-active .graph-workspace {
      display: grid;
    }
    .graph-explorer.is-active .graph-mobile-launch {
      display: none;
    }
    .graph-stage {
      min-height: 31rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .graph-detail {
      min-height: 22rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .graph-explorer * {
      scroll-behavior: auto !important;
    }
  }
</style>
