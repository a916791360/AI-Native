---
import {
  LEARNING_MODULES,
  LEARNING_QUESTIONS,
  LEARNING_TIERS,
  getQuestionsForModule,
  getQuestionsForTier,
} from '@/data/learning';
import CompetencyRadar from './CompetencyRadar.astro';
// 目录骨架（.catalog-*）的事实源。这层样式原先由已删除的 ContentScopeNav 顺带引入，
// 去掉内容分类条后必须由使用方自己声明。
import '@/styles/content-catalog.css';
---

<main id="main-content" class="content-catalog">
  <div class="catalog-layout">
    <aside class="catalog-sidebar">
      <nav aria-label="三层课程目录">
        {
          LEARNING_TIERS.map((tier) => (
            <div class="tier-nav" data-tier-nav={tier.id}>
              <a class="tier-nav-head" href={`#tier-${tier.code}`} data-tier-jump={tier.id}>
                <span>{tier.code}</span>
                {` · ${tier.title}`}
              </a>
              <ul>
                {LEARNING_MODULES.map((module) => (
                  <li>
                    <a href={`#module-${tier.code}-${module.index}`}>{module.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </aside>

    <div class="catalog-main">
      <label class="catalog-stage-picker">
        <span>跳到某一层</span>
        <select data-course-stage>
          {
            LEARNING_TIERS.map((tier) => (
              <optgroup label={`${tier.code} ${tier.title}`}>
                <option value={`tier-${tier.code}`}>整层 · {tier.title}</option>
                {LEARNING_MODULES.map((module) => (
                  <option value={`module-${tier.code}-${module.index}`}>{module.title}</option>
                ))}
              </optgroup>
            ))
          }
        </select>
      </label>
      <header class="catalog-title">
        <h1>AI 产品判断学习库</h1>
        <p>
          三层递进，每层把六个阶段完整走一遍：先认得出概念，再判断得了边界，最后做得了取舍。共
          {LEARNING_QUESTIONS.length} 道判断题，按层折叠，一次只看一层。
        </p>
        <p class="catalog-progress" data-catalog-progress hidden>
          <span data-progress-label>本机进度：已答</span>
          <strong data-progress-count>0</strong> / {LEARNING_QUESTIONS.length}
          <a data-progress-next href={`/learn/questions/${LEARNING_QUESTIONS[0]!.id}/`}
            >继续下一题 →</a
          >
        </p>
      </header>

      <CompetencyRadar />

      {
        LEARNING_TIERS.map((tier, tierIndex) => {
          const tierQuestions = getQuestionsForTier(tier.id);
          const tierIds = tierQuestions.map((question) => question.id);
          return (
            <details
              id={`tier-${tier.code}`}
              class="tier-block"
              open={tierIndex === 0}
              data-tier-disclosure
              data-tier-id={tier.id}
              data-tier-ids={JSON.stringify(tierIds)}
            >
              <summary class="tier-head">
                <span class="tier-code">{tier.code}</span>
                <h2 id={`tier-${tier.code}-heading`}>{tier.title}</h2>
                <span class="tier-meta">
                  <span class="tier-count">
                    <strong>{tierQuestions.length}</strong> 道题
                  </span>
                  <span class="tier-state" data-tier-state-label>
                    {tierIndex === 0 ? '未开始' : '展开查看'}
                  </span>
                </span>
                <i class="tier-chevron" aria-hidden="true" />
              </summary>

              <div class="tier-body">
                <p class="tier-summary">{tier.summary}</p>
                <p class="tier-goal">练成：{tier.goal}</p>

                {LEARNING_MODULES.map((module) => {
                  const questions = getQuestionsForModule(module.id, tier.id);
                  return (
                    <div id={`module-${tier.code}-${module.index}`} class="module-block">
                      <header>
                        <h3>
                          阶段 {module.index} · {module.title}
                        </h3>
                        <span>{questions.length} 题</span>
                      </header>
                      <div class="learning-card-grid">
                        {questions.map((question) => (
                          <article class="learning-card" data-question-id={question.id}>
                            <a href={`/learn/questions/${question.id}/`}>
                              <div class="learning-card-heading">
                                <h4>{question.shortTitle}</h4>
                                <span>Q{question.index}</span>
                              </div>
                              <p class="learning-card-question">“{question.question}”</p>
                              <div class="learning-card-preview">
                                <p>
                                  <span>场景</span>
                                  {question.scenario}
                                </p>
                                <ul>
                                  {question.facts.slice(0, 3).map((fact) => (
                                    <li>{fact}</li>
                                  ))}
                                </ul>
                                <strong>打开题目，先做判断 →</strong>
                              </div>
                            </a>
                          </article>
                        ))}
                      </div>
                    </div>
                  );
                })}
              </div>
            </details>
          );
        })
      }
    </div>
  </div>
</main>

<script>
  const PROGRESS_KEY = 'ai-native.progress';

  const disclosures = [...document.querySelectorAll<HTMLDetailsElement>('[data-tier-disclosure]')];
  const progressEl = document.querySelector<HTMLElement>('[data-catalog-progress]');
  const countEl = document.querySelector<HTMLElement>('[data-progress-count]');
  const nextLink = document.querySelector<HTMLAnchorElement>('[data-progress-next]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-question-id]')];
  const tierNavs = [...document.querySelectorAll<HTMLElement>('[data-tier-nav]')];

  let answered: string[] = [];
  try {
    const stored = JSON.parse(localStorage.getItem(PROGRESS_KEY) ?? '{"answered":[]}');
    if (Array.isArray(stored.answered)) answered = stored.answered;
  } catch {
    /* localStorage unavailable */
  }
  const answeredSet = new Set(answered);

  const readTierIds = (el: HTMLElement): string[] => {
    try {
      const parsed = JSON.parse(el.dataset.tierIds ?? '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  };

  // 收起的层也显示「已完成 / 进行中」，不展开也能判断哪一层值得进。
  let currentTierId: string | null = null;
  disclosures.forEach((details) => {
    const ids = readTierIds(details);
    const done = ids.filter((id) => answeredSet.has(id)).length;
    const state = details.querySelector<HTMLElement>('[data-tier-state-label]');
    const complete = ids.length > 0 && done === ids.length;

    if (state) {
      // 题量已经由 .tier-count 显示，这里只报「进度状态」，不要重复数字。
      if (complete) state.textContent = `已完成 ${done} / ${ids.length}`;
      else if (done > 0) state.textContent = `进行中 ${done} / ${ids.length}`;
      else state.textContent = '未开始';
    }
    details.dataset.tierState = complete ? 'complete' : done > 0 ? 'active' : 'idle';

    // 第一个未答完的层就是学习者当前所在的位置。
    if (!currentTierId && !complete) currentTierId = details.dataset.tierId ?? null;
  });

  // 侧栏只跟随「当前层」——最后被打开的那一层。
  // 主区允许多层同时展开（那是用户自己的选择，不该被抢走），但侧栏必须始终只列一层：
  // 三层的六个阶段同名，一旦同时出现，就退化成 18 行里 6 个名字各三遍的菜单。
  let sidebarTierId: string | null = null;

  const syncSidebar = () => {
    tierNavs.forEach((nav) => {
      nav.dataset.open = nav.dataset.tierNav === sidebarTierId ? 'true' : 'false';
    });
  };

  // 只展开目标层（进站定位用）。
  const openOnly = (target: HTMLDetailsElement) => {
    disclosures.forEach((details) => {
      details.open = details === target;
    });
    sidebarTierId = target.dataset.tierId ?? null;
    syncSidebar();
  };

  // 跳到某层/某阶段时只展开、不收起别的层——用户手动展开的状态不该被抢走；
  // 但侧栏的「当前层」跟着移到目标层。
  const openFor = (targetId: string) => {
    if (!targetId) return;
    const details = disclosures.find(
      (item) => item.id === targetId || item.querySelector(`#${CSS.escape(targetId)}`) !== null,
    );
    if (!details) return;
    details.open = true;
    sidebarTierId = details.dataset.tierId ?? null;
    syncSidebar();
  };

  disclosures.forEach((details) =>
    details.addEventListener('toggle', () => {
      const tierId = details.dataset.tierId ?? null;
      if (details.open) {
        sidebarTierId = tierId;
      } else if (sidebarTierId === tierId) {
        // 当前层被收起：顺位给仍在展开的层，一层都不剩就让侧栏收空。
        sidebarTierId = disclosures.find((item) => item.open)?.dataset.tierId ?? null;
      }
      syncSidebar();
    }),
  );

  // 只展开学习者当前所在的层——进来先看到「我现在在哪」。
  if (currentTierId) {
    const target = disclosures.find((details) => details.dataset.tierId === currentTierId);
    if (target) openOnly(target);
    else syncSidebar();
  } else {
    // 三层都答完时没有「当前层」，侧栏跟随第一个仍展开的层（默认是 T1），不留空目录。
    sidebarTierId = disclosures.find((item) => item.open)?.dataset.tierId ?? null;
    syncSidebar();
  }

  if (answered.length > 0) {
    cards.forEach((card) => {
      if (answeredSet.has(card.dataset.questionId ?? '')) {
        card.dataset.answered = 'true';
        const badge = card.querySelector<HTMLElement>('.learning-card-heading span');
        if (badge) badge.textContent = `✓ ${badge.textContent}`;
      }
    });
    if (progressEl && countEl && nextLink) {
      countEl.textContent = String(answered.length);
      const nextCard = cards.find((card) => !answeredSet.has(card.dataset.questionId ?? ''));
      if (nextCard) {
        nextLink.href = `/learn/questions/${nextCard.dataset.questionId}/`;
      } else {
        nextLink.href = '/learn/complete/';
        nextLink.textContent = '查看结业 →';
        const labelEl = document.querySelector<HTMLElement>('[data-progress-label]');
        if (labelEl) labelEl.textContent = '三层训练已完成：';
      }
      progressEl.hidden = false;
    }
  }

  // 侧栏与跳转选择器指向收起的层时，先把目标层展开。
  document.querySelectorAll<HTMLAnchorElement>('.catalog-sidebar a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => openFor(link.getAttribute('href')?.slice(1) ?? ''));
  });

  const stagePicker = document.querySelector<HTMLSelectElement>('[data-course-stage]');
  stagePicker?.addEventListener('change', () => {
    const targetId = stagePicker.value;
    openFor(targetId);
    document.getElementById(targetId)?.scrollIntoView({ block: 'start' });
    window.history.replaceState({}, '', `#${targetId}`);
  });
</script>
