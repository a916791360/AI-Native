---
interface Props {
  action?: string;
  id?: string;
  label?: string;
  placeholder?: string;
  value?: string;
  compact?: boolean;
}

const {
  action = '/search/',
  id = 'global-search',
  label = '搜索词条',
  placeholder = 'RAG、向量数据库、AI 幻觉',
  value = '',
  compact = false,
} = Astro.props;
---

<form class:list={['search-form', { compact }]} action={action} method="get" role="search">
  <label class="screen-reader-only" for={id}>{label}</label>
  <input id={id} name="q" type="search" placeholder={placeholder} value={value} />
  <button type="submit">搜索</button>
</form>

<style>
  .search-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-md);
    background: var(--color-panel);
    overflow: hidden;
  }

  input {
    min-width: 0;
    min-height: var(--control-height);
    border: 0;
    padding-inline: var(--space-2);
    background: transparent;
    color: var(--color-ink);
    font-size: 0.9375rem;
    outline: 0;
  }

  input::placeholder {
    color: var(--color-quiet);
  }

  button {
    min-width: 3.75rem;
    min-height: var(--control-height);
    border: 0;
    border-left: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    touch-action: manipulation;
    font-size: 0.8125rem;
    font-weight: var(--weight-display);
  }

  button:hover {
    background: var(--color-panel-raised);
    color: var(--color-prerequisite);
  }

  button:active:not(:disabled) {
    background: color-mix(in oklch, var(--color-prerequisite) 9%, var(--color-panel));
  }

  .compact {
    border-radius: var(--radius-md);
  }

  .compact input {
    min-height: var(--control-height);
    padding-inline: var(--space-2);
  }

  .compact button {
    min-height: var(--control-height);
  }

  .search-form:focus-within {
    border-color: var(--color-focus);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--color-focus) 24%, transparent);
  }

  @media (max-width: 900px) {
    input,
    .compact input {
      font-size: 1rem;
    }

    input,
    button,
    .compact input,
    .compact button {
      min-height: var(--control-height-mobile);
    }
  }
</style>
