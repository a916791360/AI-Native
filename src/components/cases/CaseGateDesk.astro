---
import type { CaseGate, CaseStudy } from '@/lib/cases/schema';
import type { GateResources } from '@/lib/cases/presentation';
import {
  ASSESSMENT_LABELS,
  CLAIM_KIND_LABELS,
  EVIDENCE_LABELS,
  REFERENCE_KIND_LABELS,
  referenceHref,
} from '@/lib/cases/presentation';
import { getOptionImpact } from '@/lib/cases/impact';

interface Props {
  caseStudy: CaseStudy;
  gate: CaseGate;
  resources: GateResources;
}

const { caseStudy, gate, resources } = Astro.props;
---

<section class="evidence-desk" aria-labelledby="decision-heading" data-evidence-desk>
  <header class="desk-brief">
    <div class="brief-kicker-row">
      <span class="eyebrow">Decision Brief</span>
      <span class="brief-gate-tag">Gate 0{gate.order} 决策工作台</span>
    </div>
    <h2 id="decision-heading">{gate.question}</h2>
    <div class="business-context-card">
      <span class="context-label">业务场景背景与约束：</span>
      <p>{caseStudy.businessContext}</p>
    </div>
    <div class="recommended-decision">
      <span class="rec-label">团队推荐基准</span>
      <strong class="rec-value">{gate.decision}</strong>
      <small class="rec-note">默认基线路径，可根据实际约束探索并采纳其他方案</small>
    </div>
  </header>

  <div class="desk-evidence">
    <section class="evidence-col facts-section" aria-labelledby="facts-heading">
      <div class="evidence-header">
        <span class="evidence-icon">📋</span>
        <p class="meta-label" id="facts-heading">当前已知事实与数据</p>
      </div>
      <ul class="evidence-list">
        {
          gate.facts.map((claim) => (
            <li class="evidence-card fact-card">
              <div class="claim-tag-row">
                <span class="claim-kind-pill">{CLAIM_KIND_LABELS[claim.kind]}</span>
                <span class="claim-evidence-tag">{claim.evidence}</span>
              </div>
              <p class="claim-statement">{claim.statement}</p>
              <small class="evidence-proof-label">{EVIDENCE_LABELS[claim.evidence]}</small>
            </li>
          ))
        }
      </ul>
    </section>
    <section class="evidence-col unknowns unknowns-section" aria-labelledby="unknowns-heading">
      <div class="evidence-header">
        <span class="evidence-icon">⚠️</span>
        <p class="meta-label" id="unknowns-heading">不能假装已知 (盲区与待核验假设)</p>
      </div>
      <ul class="evidence-list">
        {
          gate.unknowns.map((claim) => (
            <li class="evidence-card unknown-card">
              <div class="claim-tag-row">
                <span class="claim-kind-pill unknown-kind">{CLAIM_KIND_LABELS[claim.kind]}</span>
                <span class="claim-evidence-tag unknown-evidence">{claim.evidence}</span>
              </div>
              <p class="claim-statement">{claim.statement}</p>
              <small class="evidence-proof-label">{EVIDENCE_LABELS[claim.evidence]}</small>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <section
    class="decision-options"
    aria-labelledby="options-heading"
    data-case-options
    data-case-id={caseStudy.id}
    data-gate-id={gate.id}
    data-stage-id={gate.stageId}
    data-recommended-decision={gate.decision}
  >
    <header class="options-meta-header">
      <div>
        <p class="eyebrow">Compare Paths</p>
        <h3 id="options-heading">比较三条决策路径</h3>
        <p class="options-subtitle">
          展开任一路径查看立项依据、成立条件、主要风险与决策影响天平；可作为 PM 采纳方案并留存印记。
        </p>
      </div>
      <div class="options-legend">
        <span class="legend-chip chip-rec">推荐路径</span>
        <span class="legend-chip chip-cond">有条件成立</span>
        <span class="legend-chip chip-risk">高风险方案</span>
      </div>
    </header>
    <div class="option-grid">
      {
        gate.options.map((option, index) => {
          const impact = getOptionImpact(option, gate);
          return (
            <details
              data-assessment={option.assessment}
              data-option-id={option.id}
              data-option-label={option.label}
              open={option.assessment === 'recommended'}
            >
              <summary>
                <div class="summary-left">
                  <span class="option-letter">{String.fromCharCode(65 + index)}</span>
                  <strong class="option-label-text">{option.label}</strong>
                </div>
                <div class="summary-right">
                  <span class="summary-assessment-pill" data-assessment={option.assessment}>
                    {ASSESSMENT_LABELS[option.assessment]}
                  </span>
                  <span class="decision-user-tag" data-user-tag hidden>
                    你的选择
                  </span>
                  <i class="toggle-icon">
                    <span class="when-closed">展开取舍 ↓</span>
                    <span class="when-open">收起取舍 ↑</span>
                  </i>
                </div>
              </summary>
              <div class="option-feedback">
                <div class="option-meta-bar">
                  <span class="assessment-label">{ASSESSMENT_LABELS[option.assessment]}</span>
                  <span class="decision-selected-badge" data-decision-badge hidden>
                    ✓ 已采纳为当前决策
                  </span>
                </div>
                <div class="rationale-card">
                  <span class="rationale-kicker">PM 方案立项理由</span>
                  <p class="rationale">{option.rationale}</p>
                </div>
                <div class="tradeoff-grid">
                  <section class="tradeoff-column conditions-column">
                    <div class="tradeoff-head">
                      <span class="tradeoff-icon">⚖️</span>
                      <h4>成立条件</h4>
                    </div>
                    <ul class="conditions-checklist">
                      {option.conditions.map((condition, condIdx) => (
                        <li>
                          <label class="condition-check-item">
                            <input
                              type="checkbox"
                              data-cond-check={`${caseStudy.id}:${gate.id}:${option.id}:${condIdx}`}
                            />
                            <span>{condition}</span>
                          </label>
                        </li>
                      ))}
                    </ul>
                  </section>
                  <section class="tradeoff-column risks-column">
                    <div class="tradeoff-head">
                      <span class="tradeoff-icon">⚠️</span>
                      <h4>主要风险</h4>
                    </div>
                    <ul class="tradeoff-bullets">
                      {option.risks.map((risk) => (
                        <li>{risk}</li>
                      ))}
                    </ul>
                  </section>
                  <section class="tradeoff-column consequences-column">
                    <div class="tradeoff-head">
                      <span class="tradeoff-icon">🔄</span>
                      <h4>后续影响</h4>
                    </div>
                    <ul class="tradeoff-bullets">
                      {option.consequences.map((consequence) => (
                        <li>{consequence}</li>
                      ))}
                    </ul>
                  </section>
                </div>
                <div class="impact-meter-panel" data-impact-meter>
                  <div class="impact-meter-header">
                    <span class="meter-title">⚡ 决策影响天平 (Impact Meter)</span>
                    <span class="meter-subtitle">工程复杂度与业务代价联动预估</span>
                  </div>
                  <div class="impact-gauges">
                    <div class="gauge-item">
                      <div class="gauge-label-row">
                        <span>开发周期</span>
                        <strong>{impact.cycleLabel}</strong>
                      </div>
                      <div class="gauge-track">
                        <div class="gauge-fill gauge-cycle" style={`width: ${impact.cycle}%;`} />
                      </div>
                    </div>
                    <div class="gauge-item">
                      <div class="gauge-label-row">
                        <span>推理成本</span>
                        <strong>{impact.costLabel}</strong>
                      </div>
                      <div class="gauge-track">
                        <div class="gauge-fill gauge-cost" style={`width: ${impact.cost}%;`} />
                      </div>
                    </div>
                    <div class="gauge-item">
                      <div class="gauge-label-row">
                        <span>确定准确度</span>
                        <strong>{impact.accuracyLabel}</strong>
                      </div>
                      <div class="gauge-track">
                        <div
                          class="gauge-fill gauge-accuracy"
                          style={`width: ${impact.accuracy}%;`}
                        />
                      </div>
                    </div>
                    <div class="gauge-item">
                      <div class="gauge-label-row">
                        <span>人工兜底率</span>
                        <strong>{impact.humanBurdenLabel}</strong>
                      </div>
                      <div class="gauge-track">
                        <div
                          class="gauge-fill gauge-burden"
                          style={`width: ${impact.humanBurden}%;`}
                        />
                      </div>
                    </div>
                  </div>
                  <div class="impact-warning-card">
                    <span class="warning-badge">代价警示</span>
                    <p>{impact.warning}</p>
                  </div>
                </div>
                <div class="option-artifact-delta">
                  <span class="delta-badge">本关材料变化</span>
                  <p>{option.artifactDelta}</p>
                </div>
                <div class="option-decision-action">
                  <button
                    type="button"
                    class="adopt-decision-btn"
                    data-adopt-decision
                    data-option-id={option.id}
                    data-option-label={option.label}
                    data-option-assessment={option.assessment}
                  >
                    <span class="btn-icon">✓</span>
                    <span>作为 PM 采纳此决策路径</span>
                  </button>
                </div>
              </div>
            </details>
          );
        })
      }
    </div>
    <div class="case-decision-debrief" data-decision-debrief hidden>
      <div class="debrief-head">
        <span class="debrief-kicker">PM 决策复盘</span>
        <h4>你的方案与团队基准对比</h4>
      </div>
      <div class="debrief-content">
        <div class="debrief-item">
          <span class="debrief-label">你的选择</span>
          <strong data-debrief-user-choice>-</strong>
          <span class="debrief-tag" data-debrief-user-tag>-</span>
        </div>
        <div class="debrief-vs">VS</div>
        <div class="debrief-item">
          <span class="debrief-label">团队基准推荐</span>
          <strong>{gate.decision}</strong>
          <span class="debrief-tag tag-recommended">推荐基准</span>
        </div>
      </div>
      <p class="debrief-analysis" data-debrief-analysis></p>
      <div class="debrief-actions">
        <button type="button" class="debrief-reset-btn" data-reset-decision> 重选决策路径 </button>
      </div>
    </div>
    <p class="screen-reader-only" aria-live="polite" data-option-announcement>默认展开推荐路径</p>
  </section>

  <section class="artifact-change" aria-labelledby="artifact-change-heading">
    <header>
      <p class="eyebrow">Artifact delta</p>
      <h3 id="artifact-change-heading">本关如何改变项目材料</h3>
    </header>
    {
      resources.artifacts.map((artifact) => (
        <div>
          <span>新增材料</span>
          <h4>{artifact.title}</h4>
          <p>{artifact.summary}</p>
        </div>
      ))
    }
  </section>

  <div class="case-evidence-register">
    <section aria-labelledby="failure-heading">
      <header><p class="meta-label" id="failure-heading">失败与恢复</p></header>
      <ul>
        {
          resources.failureModes.map((failure) => (
            <li>
              <strong>{failure.title}</strong>
              <dl>
                <div>
                  <>
                    <dt>信号</dt>
                    <dd>{failure.signal}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>影响</dt>
                    <dd>{failure.impact}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>恢复</dt>
                    <dd>{failure.recovery}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>责任</dt>
                    <dd>{failure.owner}</dd>
                  </>
                </div>
              </dl>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="metrics-heading">
      <header><p class="meta-label" id="metrics-heading">指标与真实基线</p></header>
      <ul>
        {
          resources.metrics.map((metric) => (
            <li>
              <span>
                {metric.category} · {metric.desiredDirection}
              </span>
              <strong>{metric.label}</strong>
              <p>{metric.definition}</p>
              <small>
                {metric.thresholdStatus === 'baseline-needed'
                  ? '阈值：待真实基线'
                  : metric.threshold}
              </small>
            </li>
          ))
        }
      </ul>
    </section>
    <section aria-labelledby="support-heading">
      <header><p class="meta-label" id="support-heading">按需知识支持</p></header>
      <ul>
        {
          resources.references.map((reference) => (
            <li>
              <a
                href={referenceHref(reference)}
                target={reference.kind === 'source' ? '_blank' : undefined}
                rel={reference.kind === 'source' ? 'noreferrer' : undefined}
              >
                <span>{REFERENCE_KIND_LABELS[reference.kind]}</span>
                <strong>{reference.label}</strong>
                <p>{reference.supports}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</section>

<script>
  const DECISIONS_KEY = 'ai-native.case-decisions';
  const CHECKS_KEY = 'ai-native.condition-checks';

  const optionGroups = document.querySelectorAll<HTMLElement>('[data-case-options]');
  for (const group of optionGroups) {
    const caseId = group.dataset.caseId ?? '';
    const gateId = group.dataset.gateId ?? '';
    const stageId = group.dataset.stageId ?? '';
    const gateKey = `${caseId}:${gateId}`;

    const options = [...group.querySelectorAll<HTMLDetailsElement>('details')];
    const announcement = group.querySelector<HTMLElement>('[data-option-announcement]');
    const debriefEl = group.querySelector<HTMLElement>('[data-decision-debrief]');
    const debriefUserChoiceEl = group.querySelector<HTMLElement>('[data-debrief-user-choice]');
    const debriefUserTagEl = group.querySelector<HTMLElement>('[data-debrief-user-tag]');
    const debriefAnalysisEl = group.querySelector<HTMLElement>('[data-debrief-analysis]');
    const resetBtn = group.querySelector<HTMLButtonElement>('[data-reset-decision]');

    // 1. 保留原本的 details 互斥展开逻辑
    for (const option of options) {
      option.addEventListener('toggle', () => {
        if (!option.open) return;
        for (const item of options) {
          if (item !== option) item.open = false;
        }
        if (announcement) announcement.textContent = `已展开：${option.dataset.optionLabel ?? ''}`;
      });
    }

    // 2. 本地决策存储读取与渲染
    interface GateDecisionRecord {
      caseId: string;
      gateId: string;
      stageId: string;
      optionId: string;
      optionLabel: string;
      assessment: string;
      timestamp: number;
    }

    const readDecisions = (): Record<string, GateDecisionRecord> => {
      try {
        return JSON.parse(localStorage.getItem(DECISIONS_KEY) ?? '{}');
      } catch {
        return {};
      }
    };

    const saveDecision = (optionId: string, optionLabel: string, assessment: string) => {
      const all = readDecisions();
      all[gateKey] = {
        caseId,
        gateId,
        stageId,
        optionId,
        optionLabel,
        assessment,
        timestamp: Date.now(),
      };
      try {
        localStorage.setItem(DECISIONS_KEY, JSON.stringify(all));
        window.dispatchEvent(new Event('storage'));
      } catch {
        /* storage full/unavailable */
      }
      renderDecisionState(all[gateKey]);
    };

    const clearDecision = () => {
      const all = readDecisions();
      delete all[gateKey];
      try {
        localStorage.setItem(DECISIONS_KEY, JSON.stringify(all));
        window.dispatchEvent(new Event('storage'));
      } catch {
        /* ignore */
      }
      renderDecisionState(undefined);
    };

    const renderDecisionState = (currentDecision?: {
      optionId: string;
      optionLabel: string;
      assessment: string;
    }) => {
      options.forEach((opt) => {
        const isSelected = currentDecision && opt.dataset.optionId === currentDecision.optionId;
        const userTag = opt.querySelector<HTMLElement>('[data-user-tag]');
        const badge = opt.querySelector<HTMLElement>('[data-decision-badge]');
        const btn = opt.querySelector<HTMLButtonElement>('[data-adopt-decision]');

        if (userTag) userTag.hidden = !isSelected;
        if (badge) badge.hidden = !isSelected;
        if (btn) {
          btn.dataset.selected = String(isSelected);
          btn.textContent = isSelected ? '✓ 当前已采纳此方案' : '作为 PM 采纳此决策路径';
        }
        if (isSelected) {
          opt.dataset.userChosen = 'true';
        } else {
          delete opt.dataset.userChosen;
        }
      });

      if (
        currentDecision &&
        debriefEl &&
        debriefUserChoiceEl &&
        debriefUserTagEl &&
        debriefAnalysisEl
      ) {
        debriefEl.hidden = false;
        debriefUserChoiceEl.textContent = currentDecision.optionLabel;

        let tagText = '推荐基准';
        let analysisText =
          '你的选择与团队推荐基准完全一致。方案稳健、风险受控且具备明确的验收材料。';
        if (currentDecision.assessment === 'conditional') {
          tagText = '有条件成立';
          analysisText =
            '你选择了折中/特化路径。请务必确认上方「成立条件」已全部满足，并密切监控质量指标。';
        } else if (currentDecision.assessment === 'risky') {
          tagText = '高风险方案';
          analysisText =
            '注意：该路径存在较高隐性技术债或人工不可承受成本。请严格对照下方「失败与恢复」责任清单。';
        }

        debriefUserTagEl.textContent = tagText;
        debriefUserTagEl.className = `debrief-tag tag-${currentDecision.assessment}`;
        debriefAnalysisEl.textContent = analysisText;
      } else if (debriefEl) {
        debriefEl.hidden = true;
      }
    };

    // 绑定采纳按钮
    group.querySelectorAll<HTMLButtonElement>('[data-adopt-decision]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const optionId = btn.dataset.optionId ?? '';
        const optionLabel = btn.dataset.optionLabel ?? '';
        const assessment = btn.dataset.optionAssessment ?? '';
        saveDecision(optionId, optionLabel, assessment);
      });
    });

    // 绑定重置按钮
    resetBtn?.addEventListener('click', () => {
      clearDecision();
    });

    // 3. 成立条件勾选持久化
    const readChecks = (): Record<string, boolean> => {
      try {
        return JSON.parse(localStorage.getItem(CHECKS_KEY) ?? '{}');
      } catch {
        return {};
      }
    };

    const checks = readChecks();
    group.querySelectorAll<HTMLInputElement>('[data-cond-check]').forEach((input) => {
      const checkKey = input.dataset.condCheck;
      if (checkKey && checks[checkKey]) {
        input.checked = true;
      }
      input.addEventListener('change', () => {
        if (!checkKey) return;
        const currentChecks = readChecks();
        if (input.checked) currentChecks[checkKey] = true;
        else delete currentChecks[checkKey];
        try {
          localStorage.setItem(CHECKS_KEY, JSON.stringify(currentChecks));
        } catch {
          /* ignore */
        }
      });
    });

    // 初始化渲染当前关卡决策
    const initialDecisions = readDecisions();
    renderDecisionState(initialDecisions[gateKey]);
  }
</script>

<style>
  .decision-user-tag {
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    background: var(--color-accent-wash);
    padding: 0.1rem 0.5rem;
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-style: normal;
    margin-left: var(--space-2);
  }

  .option-meta-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-2);
  }

  .decision-selected-badge {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-display);
  }

  .conditions-checklist {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-2);
  }

  .condition-check-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2);
    align-items: start;
    cursor: pointer;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .condition-check-item input[type='checkbox'] {
    margin-top: 0.2rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }

  .option-decision-action {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-line);
    display: flex;
    justify-content: flex-end;
  }

  .adopt-decision-btn {
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-sm);
    background: var(--color-panel-raised);
    color: var(--color-ink);
    padding: 0.4rem 0.9rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-display);
    cursor: pointer;
    transition:
      color var(--duration-quick) var(--ease-smooth-out),
      background-color var(--duration-quick) var(--ease-smooth-out),
      border-color var(--duration-quick) var(--ease-smooth-out);
  }

  .adopt-decision-btn:active {
    transform: scale(var(--scale-large));
  }

  .adopt-decision-btn:hover {
    border-color: var(--color-accent);
    background: var(--color-panel);
  }

  .adopt-decision-btn[data-selected='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-black);
  }

  .case-decision-debrief {
    margin: var(--space-5) var(--page-gutter) 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel-raised);
    padding: var(--space-4);
  }

  .debrief-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .debrief-kicker {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .debrief-head h4 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--weight-display);
    color: var(--color-ink);
  }

  .debrief-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: center;
    border-top: 1px solid var(--color-line-soft);
    border-bottom: 1px solid var(--color-line-soft);
    padding-block: var(--space-3);
  }

  .debrief-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .debrief-label {
