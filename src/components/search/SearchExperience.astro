---
import SearchForm from '@/components/ui/SearchForm.astro';
import { loadProjectContent } from '@/lib/content/io';
import { buildContentIssueUrl } from '@/lib/site/github';

interface Props {
  compact?: boolean;
  emptyBehavior?: 'browse' | 'index';
  indexTarget?: string;
}

const { compact = false, emptyBehavior = 'browse', indexTarget } = Astro.props;
const { domains } = await loadProjectContent();
const feedbackUrl = buildContentIssueUrl({
  title: '搜索词条建议',
  pagePath: Astro.url.pathname,
  issueType: '其他',
  context: '没有找到的关键词：',
});
---

<section
  class:list={['search-experience', { compact }]}
  data-search-experience
  data-empty-behavior={emptyBehavior}
  data-index-target={indexTarget}
  aria-label="词条搜索"
>
  <div class="search-query">
    <SearchForm action={Astro.url.pathname} compact={compact} />
    <p class="search-index-state" data-search-index-state>词条索引已就绪</p>
  </div>

  <details class="search-filter-panel" data-search-filter-panel open>
    <summary>
      <span>筛选条件</span>
      <small data-search-filter-summary>全部</small>
    </summary>
    <div class="search-filters" aria-label="筛选搜索结果">
      <label>
        <span>领域</span>
        <select data-search-filter="domain">
          <option value="">全部领域</option>
          {domains.map((domain) => <option value={domain.id}>{domain.shortNameZh}</option>)}
        </select>
      </label>
      <label>
        <span>难度</span>
        <select data-search-filter="difficulty">
          <option value="">全部难度</option>
          <option value="beginner">入门</option>
          <option value="intermediate">进阶</option>
          <option value="advanced">深入</option>
        </select>
      </label>
      <label>
        <span>状态</span>
        <select data-search-filter="status">
          <option value="">全部状态</option>
          <option value="verified">已核验</option>
          <option value="catalogued">已收录</option>
          <option value="needs-review">需要复核</option>
          <option value="deprecated">已弃用</option>
        </select>
      </label>
      <button type="button" class="search-clear" data-search-clear>清除</button>
    </div>
  </details>

  <div class="search-output" data-search-output aria-busy="false">
    <header class="search-output-header">
      <p data-search-status aria-live="polite">正在准备词条索引</p>
    </header>
    <ol class="search-results" data-search-results></ol>
    <button type="button" class="search-more" data-search-more hidden>显示更多</button>
    <div class="search-empty" data-search-empty hidden>
      <strong>没有匹配词条</strong>
      <p>可以缩短关键词、清除筛选，或按领域继续浏览。</p>
      <div class="search-empty-actions">
        <a href="/atlas/">浏览全部领域</a>
        <a href={feedbackUrl}>建议收录词条</a>
      </div>
    </div>
  </div>

  <noscript>
    <p class="search-noscript">
      搜索需要 JavaScript；仍可前往<a href="/atlas/">知识图鉴</a>按领域浏览。
    </p>
  </noscript>
</section>

<script>
  import '@/scripts/search-experience';
</script>

<style is:global>
  .search-experience {
    border-bottom: 1px solid var(--color-line);
  }
  .search-query {
    display: grid;
    grid-template-columns: minmax(16rem, 30rem) minmax(12rem, 1fr);
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--page-gutter);
  }
  .search-index-state {
    margin: 0;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: right;
  }
  .search-filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(10rem, 1fr)) auto;
    border-top: 1px solid var(--color-line-soft);
    border-bottom: 1px solid var(--color-line);
    padding-inline: var(--page-gutter);
  }
  .search-filter-panel {
    border: 0;
  }
  .search-filter-panel > summary {
    display: none;
  }
  .search-filters label {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    border-right: 1px solid var(--color-line-soft);
    padding: var(--space-1) var(--space-2);
  }
  .search-filters label:first-child {
    padding-left: 0;
  }
  .search-filters label > span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .search-filters select {
    min-width: 0;
    min-height: var(--control-height);
    border: 0;
    background: var(--color-black);
    color: var(--color-ink);
    cursor: pointer;
  }
  .search-clear {
    min-width: 5rem;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }
  .search-clear:disabled {
    color: var(--color-quiet);
  }
  .search-clear:hover {
    color: var(--color-prerequisite);
  }
  .search-output[hidden] {
    display: none;
  }
  .search-output-header {
    min-height: 3rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 var(--page-gutter);
  }
  .search-output-header p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .search-results {
    margin: 0;
    border-top: 1px solid var(--color-line);
    padding: 0;
    list-style: none;
  }
  .search-more {
    width: 100%;
    min-height: var(--control-height);
    border: 0;
    border-top: 1px solid var(--color-line);
    background: var(--color-panel);
    color: var(--color-accent);
    font-weight: 600;
  }
  .search-more:hover {
    background: var(--color-panel-raised);
  }
  .search-result {
    display: grid;
    grid-template-columns: 4rem minmax(13rem, 0.42fr) minmax(18rem, 1fr) minmax(9rem, auto);
    gap: var(--space-3);
    align-items: center;
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-3) var(--page-gutter);
  }
  .search-result:hover {
    background: var(--color-panel);
  }
  .search-result-number {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .search-result-title {
    min-width: 0;
    display: grid;
    text-decoration: none;
  }
  .search-result-title strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
  }
  .search-result-title small {
    overflow: hidden;
    color: var(--color-quiet);
    font-size: var(--text-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-result-copy {
    min-width: 0;
  }
  .search-result-copy p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .search-result-copy mark {
    background: transparent;
    color: var(--color-prerequisite);
    font-weight: 600;
  }
  .search-result-meta {
    display: grid;
    justify-items: end;
    gap: var(--space-1);
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-align: right;
  }
  .search-result-source {
    color: var(--color-component);
  }
  .search-empty {
    min-height: 12rem;
    border-top: 1px solid var(--color-line);
    padding: var(--space-5) var(--page-gutter);
  }
  .search-empty strong {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
  }
  .search-empty p,
  .search-noscript {
    color: var(--color-muted);
  }
  .search-empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
  .search-empty-actions a {
    color: var(--color-prerequisite);
  }
  .search-noscript {
    padding: var(--space-4) var(--page-gutter);
  }
  .search-experience.compact .search-query {
    padding-block: var(--space-3);
  }

  @media (max-width: 820px) {
    .search-query {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .search-index-state {
      text-align: left;
    }
    .search-filters {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding: 0;
    }
    .search-filter-panel > summary {
      min-height: var(--control-height-mobile);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-inline: var(--space-3);
      color: var(--color-ink);
      font-size: var(--text-sm);
      font-weight: 600;
      list-style: none;
    }
    .search-filter-panel > summary::-webkit-details-marker {
      display: none;
    }
    .search-filter-panel > summary::after {
      color: var(--color-quiet);
      content: '+';
    }
    .search-filter-panel[open] > summary::after {
      content: '−';
    }
    .search-filter-panel > summary small {
      margin-left: auto;
      padding-right: var(--space-2);
      color: var(--color-quiet);
      font-size: var(--text-xs);
      font-weight: 400;
    }
    .search-filters label {
      grid-template-columns: 1fr;
      gap: 0;
      border-bottom: 1px solid var(--color-line-soft);
      padding: var(--space-2);
    }
    .search-filters label:first-child {
      padding-left: var(--space-2);
    }
    .search-clear {
      grid-column: 1 / -1;
      min-height: 2.75rem;
    }
    .search-filters select,
    .search-clear,
    .search-more {
      min-height: var(--control-height-mobile);
    }
    .search-result {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: var(--space-2) var(--space-3);
    }
    .search-result-copy,
    .search-result-meta {
      grid-column: 2;
    }
    .search-result-copy p {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
    .search-result-meta {
      justify-items: start;
      text-align: left;
    }
  }

  @media (max-width: 480px) {
    .search-filters {
      grid-template-columns: 1fr;
    }
    .search-filters label {
      border-right: 0;
    }
    .search-result {
      grid-template-columns: 2rem minmax(0, 1fr);
      padding-block: var(--space-3);
    }
  }
</style>
