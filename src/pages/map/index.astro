---
import { getCollection } from 'astro:content';

import PageIntro from '@/components/layout/PageIntro.astro';
import { sectionById } from '@/config/sections';
import { buildConceptGuide } from '@/data/concept-guide';
import { LEARNING_QUESTIONS } from '@/data/learning';
import {
  CHAIN_ROLE_LABELS,
  buildStationViews,
  groupTermsByStation,
  type ChainRole,
} from '@/lib/content/chain';
import { loadProjectContent } from '@/lib/content/io';
import { isSelectableTerm } from '@/lib/content/visibility';
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * 认知链路主入口。
 *
 * 这个页面回答的是全站唯一一个「我不知道该先学什么」的问题。
 * 其余板块都预设读者已经知道自己要做什么：学习库＝我来练判断，
 * 案例库＝我要看一个完整场景，知识库＝我知道要找什么。
 *
 * 遵循 UI/UX Pro Max 工业级标准与 Daylight Clean 设计系统改造：
 * - 顶部 Hero 采用一体化全景卡片架构，彻底解决宽度与下方错位问题；
 * - 嵌入 8 阶演化管线（Spine Roadmap），消除密集纯文本压迫；
 * - 废除 Emoji 图标，全面升级为符合设计系统规范的 Phosphor/Lucide 矢量 SVG；
 * - 站点横条升级为高质感吸顶 Stepper，触控靶心与微交互符合 Fitts 定律；
 * - 高频日常词索引卡片化并支持分类过滤与一键折叠；
 * - 概念列表采用响应式 Card Grid，字重严格遵循 400 / 800 双档立场。
 */
const section = sectionById('map');
const [{ chain, routes, domains }, entries] = await Promise.all([
  loadProjectContent(),
  getCollection('terms'),
]);

const stations = buildStationViews(chain);
const allTerms = entries.map(({ data }) => data);
// 站点内列出的词条只取「可独立选择的入口」：已废弃词条即便带 chain 也不再上链路图
const terms = allTerms.filter(isSelectableTerm);
const termsById = new Map(allTerms.map((term) => [term.id, term]));
const domainNameById = new Map(domains.map((domain) => [domain.id, domain.shortNameZh]));
const termsByStation = groupTermsByStation(terms);
const conceptGuide = buildConceptGuide(terms);
const conceptGuideByLayer = [...new Set(conceptGuide.map((concept) => concept.layer))].map(
  (layer) => ({
    layer,
    entries: conceptGuide.filter((concept) => concept.layer === layer),
  }),
);

/** 每条阅读路线能提供哪些词条，以及这些词条落在哪几站。 */
const routesWithTerms = routes
  .map(({ data }) => data)
  .sort((left, right) => left.order - right.order)
  .map((route) => {
    const routeTermIds = new Set(
      route.chapters.flatMap((chapter) => chapter.terms.map((step) => step.id)),
    );
    const stationTally = new Map<number, number>();
    for (const termId of routeTermIds) {
      const order = termsById.get(termId)?.chain;
      if (typeof order !== 'number') continue;
      stationTally.set(order, (stationTally.get(order) ?? 0) + 1);
    }
    return { route, routeTermIds, stationTally };
  });

/** 题目的 references 命中本站任一概念，就算这一站的练习。 */
const questionsByStation = new Map<number, typeof LEARNING_QUESTIONS>();
for (const station of stations) {
  const stationTermIds = new Set((termsByStation.get(station.order) ?? []).map((term) => term.id));
  questionsByStation.set(
    station.order,
    LEARNING_QUESTIONS.filter((question) =>
      question.references.some((reference) => stationTermIds.has(reference.id)),
    ),
  );
}

const stationTermCount = (order: number) => (termsByStation.get(order) ?? []).length;
const coveredTerms = terms.filter((term) => typeof term.chain === 'number').length;
---

<BaseLayout
  title={section.pageTitle}
  description="语言模型缺什么、每一层补什么：从「模型是什么」到「什么时候必须有人管」的 8 站递进路径。不知道自己该先学什么时，从第 1 站开始。"
  structuredDataType="CollectionPage"
>
  <main id="main-content" class="map-page">
    <!-- 一体化 Hero 核心卡片：保证 100% 齐平对齐 -->
    <header class="map-hero">
      <div class="map-hero-intro">
        <PageIntro
          eyebrow={`Cognitive chain · ${stations.length} stations · ${coveredTerms}/${terms.length} terms placed`}
          title={section.pageTitle}
          description="这 8 站回答同一个问题：语言模型缺什么，每一层补什么。它们是严格的工程递进关系，按顺序阅读建立系统认知。"
        />
      </div>

      <!-- 8 站递进全景导览：一目了然看清架构脉络 -->
      <div class="spine-roadmap" aria-label="8 站认知递进全景">
        <div class="spine-roadmap-head">
          <span class="spine-roadmap-tag">SPINE</span>
          <span class="spine-roadmap-title">8 阶认知演化管线</span>
        </div>
        <div class="spine-steps-container">
          {
            stations.map((station, idx) => (
              <div class="spine-step-wrapper">
                <a href={`#station-${station.order}`} class="spine-step-chip">
                  <span class="spine-step-num">{String(station.order).padStart(2, '0')}</span>
                  <span class="spine-step-name">{station.nameZh.split(' · ')[0]}</span>
                </a>
                {idx < stations.length - 1 && (
                  <svg
                    class="spine-step-arrow"
                    aria-hidden="true"
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </header>

    <!-- 吸顶 Stepper 导航轨 -->
    <nav class="chain-rail" aria-label="链路站点导航">
      <ol>
        {
          stations.map((station) => (
            <li>
              <a href={`#station-${station.order}`} data-chain-rail={station.order}>
                <div class="rail-top-row">
                  <span class="rail-index">{String(station.order).padStart(2, '0')}</span>
                  <span class="rail-count">{stationTermCount(station.order)} 个概念</span>
                </div>
                <span class="rail-name">{station.nameZh}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <!-- 高频日常概念速查索引（可折叠、卡片化、带分层过滤） -->
    <section class="layer-guide" id="layers" aria-labelledby="layer-guide-title">
      <header class="layer-guide-head">
        <div class="layer-guide-head-left">
          <p class="meta-label">Everyday AI concepts · {conceptGuide.length} entries</p>
          <h2 id="layer-guide-title">高频词快速定位：日常反复出现的 AI 词，分别在解决什么问题？</h2>
          <p class="layer-guide-note">
            将日常新闻、产品宣传和工作交流中最常见的 22
            个核心词放回系统层次。先看这里建立全局定位，再顺着下方 8 站深入认知。
          </p>
        </div>
        <button
          type="button"
          class="layer-toggle-btn"
          id="layer-toggle-btn"
          aria-expanded="true"
          aria-controls="layer-content-body"
        >
          <span class="toggle-text">收起速查表</span>
          <svg
            class="toggle-arrow"
            aria-hidden="true"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>
      </header>

      <div id="layer-content-body" class="layer-content-body">
        <div class="layer-toolbar">
          <div class="guide-legend" aria-label="概念出现语境">
            <span><i class="exposure-news" aria-hidden="true"></i>新闻常见</span>
            <span><i class="exposure-product" aria-hidden="true"></i>产品常见</span>
            <span><i class="exposure-use" aria-hidden="true"></i>使用必遇</span>
            <span><i class="exposure-work" aria-hidden="true"></i>工作常见</span>
          </div>

          <div class="layer-filter-bar" role="tablist" aria-label="分层快速过滤">
            <button
              type="button"
              class="layer-filter-pill active"
              role="tab"
              aria-selected="true"
              data-layer-filter="all"
            >
              全部 ({conceptGuide.length})
            </button>
            {
              conceptGuideByLayer.map(({ layer, entries }) => (
                <button
                  type="button"
                  class="layer-filter-pill"
                  role="tab"
                  aria-selected="false"
                  data-layer-filter={layer}
                >
                  {layer} ({entries.length})
                </button>
              ))
            }
          </div>
        </div>

        <div class="layer-groups">
          {
            conceptGuideByLayer.map(({ layer, entries }) => (
              <section
                class="layer-group"
                data-group-layer={layer}
                aria-labelledby={`layer-${layer}`}
              >
                <header class="layer-group-head">
                  <h3 id={`layer-${layer}`}>{layer}</h3>
                  <span class="layer-group-count">{entries.length} 个入口</span>
                </header>
                <ul class="layer-list">
                  {entries.map((concept) => (
                    <li class="layer-row" data-exposure={concept.exposure}>
                      <div class="layer-card-top">
                        <div class="layer-name">
                          <a href={`/terms/${concept.term.id}/`}>{concept.term.nameZh}</a>
                          <span class="layer-tag">{concept.term.nameEn}</span>
                        </div>
                        <div class="layer-meta">
                          <span class={`exposure exposure-${concept.exposure}`}>
                            {concept.exposure}
                          </span>
                          {concept.station ? (
                            <a
                              class="layer-station"
                              href={`#station-${concept.station}`}
                              title={`跳转到第 ${concept.station} 站`}
                            >
                              第 {concept.station} 站 →
                            </a>
                          ) : (
                            <span class="layer-station layer-station-muted">待放入主链路</span>
                          )}
                        </div>
                      </div>
                      <p class="layer-role">{concept.role}</p>
                      <div class="layer-confusion">
                        <div class="layer-confusion-header">
                          <svg
                            class="confusion-icon-svg"
                            aria-hidden="true"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          >
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="16" x2="12" y2="12" />
                            <line x1="12" y1="8" x2="12.01" y2="8" />
                          </svg>
                          <span class="layer-confusion-label">常见困惑</span>
                        </div>
                        <p class="layer-confusion-text">{concept.confusion}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 8 站认知主结构 -->
    <div class="chain-stations">
      {
        stations.map((station) => {
          const stationTerms = termsByStation.get(station.order) ?? [];
          const questions = questionsByStation.get(station.order) ?? [];
          const stationRoutes = routesWithTerms.filter(({ stationTally }) =>
            stationTally.has(station.order),
          );

          return (
            <section
              id={`station-${station.order}`}
              class="chain-station"
              data-station={station.order}
            >
              <header class="station-head">
                <div class="station-head-badge">
                  <span class="station-badge-num">{String(station.order).padStart(2, '0')}</span>
                  <span class="station-badge-total">/ 08</span>
                </div>
                <div class="station-head-content">
                  <div class="station-head-top">
                    <span class="station-step-label">
                      STATION {String(station.order).padStart(2, '0')}
                    </span>
                    <span class="station-meta-pill">{stationTerms.length} 核心概念</span>
                    <span class="station-meta-pill">{questions.length} 道判断练习</span>
                    <span class="station-meta-pill">{stationRoutes.length} 条展开路线</span>
                  </div>
                  <h2>{station.nameZh}</h2>
                  <div class="station-question-box">
                    <span class="question-prefix">核心拷问</span>
                    <p class="station-question" data-pagefind-meta={`station-${station.order}`}>
                      {station.question}
                    </p>
                  </div>
                  <p class="station-goal">{station.goal}</p>
                </div>
              </header>

              <div class="station-grid">
                <section class="station-block station-terms" aria-label="本站概念">
                  <div class="block-header">
                    <div class="block-title-group">
                      <h3>本站概念</h3>
                      <span class="block-counter">{stationTerms.length} 个概念</span>
                    </div>
                    <div class="role-filter-hint" aria-hidden="true">
                      <span class="hint-dot core-dot" />
                      核心概念
                      <span class="hint-dot intro-dot" />
                      前置概念
                    </div>
                  </div>
                  {stationTerms.length > 0 ? (
                    <ul class="terms-card-grid">
                      {stationTerms.map((term) => (
                        <li data-role={term.chainRole ?? 'unplaced'}>
                          <div class="term-card-header">
                            <a class="term-link" href={`/terms/${term.id}/`}>
                              {term.nameZh}
                            </a>
                            <div class="term-badges">
                              {term.chainRole && (
                                <span class="role-tag">
                                  {CHAIN_ROLE_LABELS[term.chainRole as ChainRole]}
                                </span>
                              )}
                              <span class="term-domain">
                                {domainNameById.get(term.domain) ?? term.domain}
                              </span>
                            </div>
                          </div>
                          <p>{term.summary}</p>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="empty-note">这一站的核心概念尚未挂上词条。</p>
                  )}
                </section>

                <div class="station-side">
                  <section class="station-block station-action" aria-label="上手动作">
                    <div class="block-header">
                      <h3>上手动作</h3>
                      <svg
                        class="block-icon-svg"
                        aria-hidden="true"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                      </svg>
                    </div>
                    <div class="action-card-content">
                      <p>{station.action}</p>
                    </div>
                  </section>

                  <section class="station-block station-questions" aria-label="对应判断题">
                    <div class="block-header">
                      <h3>对应判断题</h3>
                      <span class="block-counter">{questions.length} 题</span>
                    </div>
                    {questions.length > 0 ? (
                      <ul>
                        {questions.map((question) => (
                          <li>
                            <a href={`/learn/questions/${question.id}/`}>
                              <span class="question-index-tag">{question.index}</span>
                              <span class="question-title-text">{question.shortTitle}</span>
                              <svg
                                class="ui-arrow-svg"
                                aria-hidden="true"
                                width="13"
                                height="13"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <path d="M5 12h14M12 5l7 7-7 7" />
                              </svg>
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="empty-note">这一站暂无对应题目。</p>
                    )}
                  </section>

                  <section class="station-block station-routes" aria-label="展开阅读清单">
                    <div class="block-header">
                      <h3>展开阅读清单</h3>
                      <span class="block-counter">{stationRoutes.length} 条</span>
                    </div>
                    {stationRoutes.length > 0 ? (
                      <ul>
                        {stationRoutes.map(({ route, stationTally }) => (
                          <li>
                            <a href={`/routes/${route.id}/`}>
                              <svg
                                class="route-icon-svg"
                                aria-hidden="true"
                                width="15"
                                height="15"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              >
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                              </svg>
                              <span class="route-title-text">{route.nameZh}</span>
                              <small>{stationTally.get(station.order)} 词条</small>
                            </a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="empty-note">暂无对应的展开阅读路线。</p>
                    )}
                  </section>
                </div>
              </div>

              <nav class="station-nav" aria-label={`第 ${station.order} 站前后站`}>
                {station.previous ? (
                  <a class="station-prev" href={`#station-${station.previous.order}`}>
                    ← 上一站 {station.previous.nameZh}
                  </a>
                ) : (
                  <span class="station-edge">这是起点</span>
                )}
                {station.next ? (
                  <a class="station-next" href={`#station-${station.next.order}`}>
                    下一站 {station.next.nameZh} →
                  </a>
                ) : (
                  <span class="station-edge">这是终点</span>
                )}
              </nav>
            </section>
          );
        })
      }
    </div>

    <!-- 链路终点出口：统一 100% 齐平卡片 -->
    <section class="chain-exit" aria-labelledby="chain-exit-title">
      <div class="chain-exit-inner">
        <div class="chain-exit-content">
          <span class="chain-exit-eyebrow">MILESTONE · 8 站认知链路完成</span>
          <h2 id="chain-exit-title">概念认全了，接下来练的是判断</h2>
          <p class="chain-exit-lede">
            8
            站补齐了系统认知：知道语言模型每一层在补什么。但在工程与业务中，真正的难点在于「取舍与决策」。带着这
            {coveredTerms} 个概念，前往判断题库和案例库进行实战演练，链路才算真正闭环。
          </p>
          <div class="chain-exit-links">
            <a class="chain-exit-primary" href="/learn/">
              开始做 {LEARNING_QUESTIONS.length} 道判断题 →
            </a>
            <a class="chain-exit-secondary" href="/learn/cases/">看一个完整案例</a>
            <a class="chain-exit-secondary" href="/routes/">按顺序读完一组词条</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 返回顶部浮钮 -->
    <button type="button" class="back-to-top" data-back-to-top aria-label="返回顶部" hidden>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
      <span>顶部</span>
    </button>
  </main>
</BaseLayout>

<script>
  // 1. 站点横条高亮当前站。用 IntersectionObserver
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-chain-rail]')];
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);

  if (links.length > 0 && sections.length === links.length) {
    const setActive = (order: string) => {
      for (const link of links) {
        if (link.dataset.chainRail === order) {
          link.setAttribute('aria-current', 'true');
          link.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          link.removeAttribute('aria-current');
        }
      }
    };

    const visible = new Set<string>();
    let isClickScrolling = false;
    let clickTimer: ReturnType<typeof setTimeout> | undefined;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const order = (entry.target as HTMLElement).dataset.station;
          if (!order) continue;
          if (entry.isIntersecting) visible.add(order);
          else visible.delete(order);
        }
        if (isClickScrolling) return;
        const topmost = [...visible].sort((left, right) => Number(left) - Number(right))[0];
        if (topmost) setActive(topmost);
      },
      { rootMargin: '-165px 0px -40% 0px', threshold: 0 },
    );

    for (const section of sections) observer.observe(section);

    for (const link of links) {
      link.addEventListener('click', () => {
        const order = link.dataset.chainRail;
        if (order) {
          isClickScrolling = true;
          clearTimeout(clickTimer);
          setActive(order);
          clickTimer = setTimeout(() => {
            isClickScrolling = false;
          }, 800);
        }
      });
    }
  }

  // 2. 高频词速查表折叠/展开交互
  const toggleBtn = document.getElementById('layer-toggle-btn');
  const layerContent = document.getElementById('layer-content-body');
  if (toggleBtn && layerContent) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
      layerContent.hidden = isExpanded;
      const text = toggleBtn.querySelector('.toggle-text');
      const arrow = toggleBtn.querySelector<SVGElement>('.toggle-arrow');
      if (text) text.textContent = isExpanded ? '展开速查表' : '收起速查表';
      if (arrow) arrow.style.transform = isExpanded ? 'rotate(180deg)' : 'rotate(0deg)';
    });
  }

  // 3. 高频词分层快速过滤
  const filterPills = document.querySelectorAll<HTMLButtonElement>('[data-layer-filter]');
  const layerGroups = document.querySelectorAll<HTMLElement>('.layer-group');
  if (filterPills.length > 0 && layerGroups.length > 0) {
    for (const pill of filterPills) {
      pill.addEventListener('click', () => {
        const filter = pill.dataset.layerFilter;
        for (const p of filterPills) {
          const isSelected = p === pill;
          p.classList.toggle('active', isSelected);
          p.setAttribute('aria-selected', String(isSelected));
        }
        for (const group of layerGroups) {
          const groupLayer = group.dataset.groupLayer;
          if (filter === 'all' || groupLayer === filter) {
            group.removeAttribute('hidden');
          } else {
            group.setAttribute('hidden', '');
          }
        }
      });
    }
  }

  // 4. 返回顶部快捷交互
  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (backToTop) {
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 450) {
          backToTop.removeAttribute('hidden');
        } else {
          backToTop.setAttribute('hidden', '');
        }
      },
      { passive: true },
    );

    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

