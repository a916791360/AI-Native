---
import { getCollection } from 'astro:content';

import PageIntro from '@/components/layout/PageIntro.astro';
import { sectionById } from '@/config/sections';
import { buildConceptGuide } from '@/data/concept-guide';
import { LEARNING_QUESTIONS } from '@/data/learning';
import {
  CHAIN_ROLE_LABELS,
  buildStationViews,
  groupTermsByStation,
  type ChainRole,
} from '@/lib/content/chain';
import { loadProjectContent } from '@/lib/content/io';
import { isSelectableTerm } from '@/lib/content/visibility';
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * 认知链路主入口。
 *
 * 这个页面回答的是全站唯一一个「我不知道该先学什么」的问题。
 * 其余板块都预设读者已经知道自己要做什么：学习库＝我来练判断，
 * 案例库＝我要看一个完整场景，知识库＝我知道要找什么。
 *
 * 8 站不是 8 个并列的主题，而是一条递进关系：语言模型缺什么，每一层补什么。
 * 所以页面刻意不做成大图 hero + 卡片网格——那会把递进读成并列，
 * 正是这个站原本 325 个平级入口的老毛病。这里用的是「索引优先」结构：
 * 一条站点横条（兼导航）+ 8 个编号区块，每块给出目标、概念、判断、动作、展开清单。
 */
const section = sectionById('map');
const [{ chain, routes, domains }, entries] = await Promise.all([
  loadProjectContent(),
  getCollection('terms'),
]);

const stations = buildStationViews(chain);
const allTerms = entries.map(({ data }) => data);
// 站点内列出的词条只取「可独立选择的入口」：已废弃词条即便带 chain 也不再上链路图，
// 否则 /map/ 会给出一个点进去就提示「已并入别处」的入口。
const terms = allTerms.filter(isSelectableTerm);
const termsById = new Map(allTerms.map((term) => [term.id, term]));
const domainNameById = new Map(domains.map((domain) => [domain.id, domain.shortNameZh]));
const termsByStation = groupTermsByStation(terms);
const conceptGuide = buildConceptGuide(terms);
const conceptGuideByLayer = [...new Set(conceptGuide.map((concept) => concept.layer))].map(
  (layer) => ({
    layer,
    entries: conceptGuide.filter((concept) => concept.layer === layer),
  }),
);

/** 每条阅读路线能提供哪些词条，以及这些词条落在哪几站。 */
const routesWithTerms = routes
  .map(({ data }) => data)
  .sort((left, right) => left.order - right.order)
  .map((route) => {
    const routeTermIds = new Set(
      route.chapters.flatMap((chapter) => chapter.terms.map((step) => step.id)),
    );
    const stationTally = new Map<number, number>();
    for (const termId of routeTermIds) {
      const order = termsById.get(termId)?.chain;
      if (typeof order !== 'number') continue;
      stationTally.set(order, (stationTally.get(order) ?? 0) + 1);
    }
    return { route, routeTermIds, stationTally };
  });

/** 题目的 references 命中本站任一概念，就算这一站的练习。 */
const questionsByStation = new Map<number, typeof LEARNING_QUESTIONS>();
for (const station of stations) {
  const stationTermIds = new Set((termsByStation.get(station.order) ?? []).map((term) => term.id));
  questionsByStation.set(
    station.order,
    LEARNING_QUESTIONS.filter((question) =>
      question.references.some((reference) => stationTermIds.has(reference.id)),
    ),
  );
}

const stationTermCount = (order: number) => (termsByStation.get(order) ?? []).length;
const coveredTerms = terms.filter((term) => typeof term.chain === 'number').length;

/**
 * 高频概念导航由 src/data/concept-guide.ts 维护。
 *
 * 这里刻意不再写死「五个概念」：截图中的 MCP / Skill / Agent / LangChain / RAG
 * 只是帮助读者理解架构的代表。真正的入口还应覆盖普通人在新闻、产品介绍、实际使用
 * 与安全讨论中反复遇到的词。词条是否存在由 buildConceptGuide 过滤，避免页面出现死链。
 */
---

<BaseLayout
  title={section.pageTitle}
  description="语言模型缺什么、每一层补什么：从「模型是什么」到「什么时候必须有人管」的 8 站递进路径。不知道自己该先学什么时，从第 1 站开始。"
  structuredDataType="CollectionPage"
>
  <main id="main-content" class="map-page">
    <PageIntro
      eyebrow={`Cognitive chain · ${stations.length} stations · ${coveredTerms}/${terms.length} terms placed`}
      title={section.pageTitle}
      description="这 8 站回答同一个问题：语言模型缺什么，每一层补什么。它们是递进关系，不是并列清单——所以按顺序读，跳读会失去意义。"
    />

    <nav class="chain-rail" aria-label="链路站点导航">
      <ol>
        {
          stations.map((station) => (
            <li>
              <a href={`#station-${station.order}`} data-chain-rail={station.order}>
                <span class="rail-index">{String(station.order).padStart(2, '0')}</span>
                <span class="rail-name">{station.nameZh}</span>
                <span class="rail-count">{stationTermCount(station.order)} 个概念</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <section class="layer-guide" id="layers" aria-labelledby="layer-guide-title">
      <header class="layer-guide-head">
        <p class="meta-label">Everyday AI concepts · {conceptGuide.length} entries</p>
        <h2 id="layer-guide-title">新闻里反复出现的 AI 词，分别在解决什么问题？</h2>
        <p class="layer-guide-note">
          截图里的五个词只是架构示例，不是概念边界。这里扩展成一张面向普通人的高频入口： 从「AI
          到底是什么」到「它能不能替我做事」，把新闻、产品宣传和日常使用里最常见的词放回
          它们各自的层次。先看这一栏建立地图，再按下面 8 站继续深入。
        </p>
      </header>
      <div class="guide-legend" aria-label="概念出现语境">
        <span><i class="exposure-news" aria-hidden="true"></i>新闻常见</span>
        <span><i class="exposure-product" aria-hidden="true"></i>产品常见</span>
        <span><i class="exposure-use" aria-hidden="true"></i>使用必遇</span>
        <span><i class="exposure-work" aria-hidden="true"></i>工作常见</span>
      </div>
      <div class="layer-groups">
        {
          conceptGuideByLayer.map(({ layer, entries }) => (
            <section class="layer-group" aria-labelledby={`layer-${layer}`}>
              <header class="layer-group-head">
                <h3 id={`layer-${layer}`}>{layer}</h3>
                <span>{entries.length} 个入口</span>
              </header>
              <ul class="layer-list">
                {entries.map((concept) => (
                  <li class="layer-row" data-exposure={concept.exposure}>
                    <div class="layer-name">
                      <a href={`/terms/${concept.term.id}/`}>{concept.term.nameZh}</a>
                      <span class="layer-tag">{concept.term.nameEn}</span>
                    </div>
                    <p class="layer-role">{concept.role}</p>
                    <p class="layer-confusion">
                      <span class="layer-confusion-label">常见困惑</span>
                      {concept.confusion}
                    </p>
                    <div class="layer-meta">
                      <span class={`exposure exposure-${concept.exposure}`}>
                        {concept.exposure}
                      </span>
                      {concept.station ? (
                        <a class="layer-station" href={`#station-${concept.station}`}>
                          第 {concept.station} 站
                        </a>
                      ) : (
                        <span class="layer-station layer-station-muted">待放入主链路</span>
                      )}
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </section>

    <div class="chain-stations">
      {
        stations.map((station) => {
          const stationTerms = termsByStation.get(station.order) ?? [];
          const questions = questionsByStation.get(station.order) ?? [];
          const stationRoutes = routesWithTerms.filter(({ stationTally }) =>
            stationTally.has(station.order),
          );

          return (
            <section
              id={`station-${station.order}`}
              class="chain-station"
              data-station={station.order}
            >
              <header class="station-head">
                <p class="meta-label">
                  Station {String(station.order).padStart(2, '0')} / {stations.length}
                </p>
                <h2>{station.nameZh}</h2>
                <p class="station-question" data-pagefind-meta={`station-${station.order}`}>
                  {station.question}
                </p>
                <p class="station-goal">{station.goal}</p>
              </header>

              <div class="station-grid">
                <section class="station-block station-terms" aria-label="本站概念">
                  <h3>本站概念</h3>
                  {stationTerms.length > 0 ? (
                    <ul>
                      {stationTerms.map((term) => (
                        <li data-role={term.chainRole ?? 'unplaced'}>
                          <a class="term-link" href={`/terms/${term.id}/`}>
                            {term.nameZh}
                          </a>
                          {term.chainRole && (
                            <span class="role-tag">
                              {CHAIN_ROLE_LABELS[term.chainRole as ChainRole]}
                            </span>
                          )}
                          <span class="term-domain">
                            {domainNameById.get(term.domain) ?? term.domain}
                          </span>
                          <p>{term.summary}</p>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="empty-note">这一站的核心概念尚未挂上词条。</p>
                  )}
                </section>

                <div class="station-side">
                  <section class="station-block station-action" aria-label="上手动作">
                    <h3>上手动作</h3>
                    <p>{station.action}</p>
                  </section>

                  <section class="station-block station-questions" aria-label="对应判断题">
                    <h3>对应判断题</h3>
                    {questions.length > 0 ? (
                      <ul>
                        {questions.map((question) => (
                          <li>
                            <a href={`/learn/questions/${question.id}/`}>{question.shortTitle}</a>
                            <small>{question.index}</small>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="empty-note">这一站暂无对应题目。</p>
                    )}
                  </section>

                  <section class="station-block station-routes" aria-label="展开阅读清单">
                    <h3>展开阅读清单</h3>
                    {stationRoutes.length > 0 ? (
                      <ul>
                        {stationRoutes.map(({ route, stationTally }) => (
                          <li>
                            <a href={`/routes/${route.id}/`}>{route.nameZh}</a>
                            <small>{stationTally.get(station.order)} 个词条在本站</small>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="empty-note">暂无对应的展开阅读路线。</p>
                    )}
                  </section>
                </div>
              </div>

              <nav class="station-nav" aria-label={`第 ${station.order} 站前后站`}>
                {station.previous ? (
                  <a class="station-prev" href={`#station-${station.previous.order}`}>
                    ← 上一站 {station.previous.nameZh}
                  </a>
                ) : (
                  <span class="station-edge">这是起点</span>
                )}
                {station.next ? (
                  <a class="station-next" href={`#station-${station.next.order}`}>
                    下一站 {station.next.nameZh} →
                  </a>
                ) : (
                  <span class="station-edge">这是终点</span>
                )}
              </nav>
            </section>
          );
        })
      }
    </div>

    {
      /*
       * 链路页此前是死胡同：8 站读完，页面里没有任何通往判断题与案例的出口
       * （全页 /learn 链接为 0）。读者刚补完词汇量就被放下——而这条链路的用途
       * 正是「有了词汇量之后去做判断」，所以出口该由链路的终点自己给。
       * 不复用顶栏导航：顶栏表达的是「随时可以去」，这里表达的是「读完 8 站该去哪」，
       * 两句话的作用不同，混用会让出口变成又一次导航罗列。
       */
    }
    <section class="chain-exit" aria-labelledby="chain-exit-title">
      <div class="chain-exit-inner">
        <p class="chain-exit-eyebrow">读完这条链路之后</p>
        <h2 id="chain-exit-title">概念认全了，接下来练的是判断</h2>
        <p class="chain-exit-lede">
          8 站补的是词汇量——知道每一层在补什么。但取舍不会出现在词条里，
          它出现在一道题、一个完整场景里。带着这些词把判断做一遍，链路才算走完。
        </p>
        <div class="chain-exit-links">
          <a class="chain-exit-primary" href="/learn/">
            开始做 {LEARNING_QUESTIONS.length} 道判断题 →
          </a>
          <a href="/learn/cases/">看一个完整案例</a>
          <a href="/routes/">按顺序读完一组词条</a>
        </div>
      </div>
    </section>

    <button type="button" class="back-to-top" data-back-to-top aria-label="返回顶部" hidden>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
      <span>顶部</span>
    </button>
  </main>
</BaseLayout>

<script>
  // 站点横条高亮当前站。用 IntersectionObserver 而不是 scroll 事件：
  // 后者要每帧读 getBoundingClientRect，而这个页面有 8 个高区块。
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-chain-rail]')];
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);

  if (links.length > 0 && sections.length === links.length) {
    const setActive = (order: string) => {
      for (const link of links) {
        if (link.dataset.chainRail === order) {
          link.setAttribute('aria-current', 'true');
          link.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          link.removeAttribute('aria-current');
        }
      }
    };

    // 维护「当前可见的站」集合，每次从全集里挑最靠前的一个。
    const visible = new Set<string>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const order = (entry.target as HTMLElement).dataset.station;
          if (!order) continue;
          if (entry.isIntersecting) visible.add(order);
          else visible.delete(order);
        }
        const topmost = [...visible].sort((left, right) => Number(left) - Number(right))[0];
        if (topmost) setActive(topmost);
      },
      // 上边距留出 sticky 顶栏 + 吸顶站点条总高度（约 150px），下边距吃掉大半个视口
      { rootMargin: '-150px 0px -50% 0px', threshold: 0 },
    );

    for (const section of sections) observer.observe(section);

    // 点击指示条立即高亮并平滑定位
    for (const link of links) {
      link.addEventListener('click', () => {
        const order = link.dataset.chainRail;
        if (order) setActive(order);
      });
    }
  }

  // 返回顶部快捷交互
  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (backToTop) {
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 450) {
          backToTop.removeAttribute('hidden');
        } else {
          backToTop.setAttribute('hidden', '');
        }
      },
      { passive: true },
    );

    backToTop.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>

<style>
  .map-page {
    padding-bottom: var(--space-7);
  }

  /* ---- 站点横条：索引，同时也是导航（吸顶交互） ------------------------ */

  .chain-rail {
    position: sticky;
    top: var(--header-height, 4rem);
    z-index: 15;
    width: min(calc(100% - 2.5rem), var(--content-max));
    margin: 0 auto var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: color-mix(in oklch, var(--color-panel) 94%, transparent);
    backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.06);
    overflow: hidden;
  }

  .chain-rail ol {
    display: grid;
    /* 8 列 → 4 列 → 2 列。宽屏下整条并排吸顶；移动端支持单行横向平滑滑动 */
    grid-template-columns: repeat(8, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chain-rail li + li {
    border-left: 1px solid var(--color-line-soft);
  }

  .chain-rail a {
    min-height: 5.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-0);
    padding: var(--space-2);
    text-decoration: none;
    touch-action: manipulation;
    border-bottom: 2px solid transparent;
    transition:
      background-color var(--duration-quick) var(--ease-smooth-out),
      border-color var(--duration-quick) var(--ease-smooth-out),
      transform var(--duration-quick) var(--ease-smooth-out);
  }

  .chain-rail a:hover {
    background: var(--color-panel-raised);
  }

  .chain-rail a:active {
    transform: scale(0.98);
  }

  .chain-rail a[aria-current='true'] {
    background: var(--color-panel-raised);
    border-bottom-color: var(--color-accent);
  }

  .chain-rail a[aria-current='true'] .rail-index {
    color: var(--color-accent);
  }

  .chain-rail a[aria-current='true'] .rail-name {
    color: var(--color-ink);
  }

  .rail-index {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
  }

  .rail-name {
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: var(--weight-display);
    line-height: 1.35;
  }

  .rail-count {
    color: var(--color-quiet);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    line-height: 1.4;
  }

  /* ---- 五层总图：第 3–6 站的引导区 ------------------------------------ */

  .layer-guide {
    scroll-margin-top: calc(var(--header-height, 4rem) + 5.75rem);
    width: min(calc(100% - 2.5rem), var(--content-max));
    margin: 0 auto var(--space-5);
  }

  .layer-guide-head {
    margin-bottom: var(--space-3);
  }

  .layer-guide-head h2 {
    max-width: 50rem;
    margin: var(--space-0) 0 var(--space-1);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    line-height: 1.3;
  }

  .layer-guide-note {
    max-width: var(--reading-max);
    margin: 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .guide-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .guide-legend span,
  .exposure {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .guide-legend i {
    width: 0.45rem;
    height: 0.45rem;
    display: inline-block;
    border-radius: 50%;
    background: var(--color-quiet);
  }

  .exposure-news {
    background: var(--color-accent) !important;
  }
  .exposure-product {
    background: var(--color-prerequisite) !important;
  }
  .exposure-use {
    background: var(--color-comparison) !important;
  }
  .exposure-work {
    background: var(--color-component) !important;
  }

  .layer-groups {
    display: grid;
    gap: var(--space-3);
  }

  .layer-group {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-panel);
    overflow: hidden;
  }

  .layer-group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-2) var(--space-3);
  }

  .layer-group-head h3 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-display);
  }

  .layer-group-head span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .layer-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .layer-row {
    display: grid;
    /* 概念 + 一句话定位 + 常见困惑 + 出现语境/站号。窄屏折叠成单列。 */
    grid-template-columns: minmax(9rem, 0.8fr) minmax(0, 1.35fr) minmax(0, 1.45fr) minmax(
        8rem,
        auto
      );
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-2) var(--space-3);
  }

  .layer-row + .layer-row {
    border-top: 1px solid var(--color-line-soft);
  }

  .layer-name {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1);
  }

  .layer-name a {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-display);
    text-decoration: none;
  }

