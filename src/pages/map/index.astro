---
import { getCollection } from 'astro:content';

import PageIntro from '@/components/layout/PageIntro.astro';
import { sectionById } from '@/config/sections';
import { LEARNING_QUESTIONS } from '@/data/learning';
import {
  CHAIN_ROLE_LABELS,
  buildStationViews,
  groupTermsByStation,
  type ChainRole,
} from '@/lib/content/chain';
import { loadProjectContent } from '@/lib/content/io';
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * 认知链路主入口。
 *
 * 这个页面回答的是全站唯一一个「我不知道该先学什么」的问题。
 * 其余板块都预设读者已经知道自己要做什么：学习库＝我来练判断，
 * 案例库＝我要看一个完整场景，知识库＝我知道要找什么。
 *
 * 8 站不是 8 个并列的主题，而是一条递进关系：语言模型缺什么，每一层补什么。
 * 所以页面刻意不做成大图 hero + 卡片网格——那会把递进读成并列，
 * 正是这个站原本 325 个平级入口的老毛病。这里用的是「索引优先」结构：
 * 一条站点横条（兼导航）+ 8 个编号区块，每块给出目标、概念、判断、动作、展开清单。
 */
const section = sectionById('map');
const [{ chain, routes, domains }, entries] = await Promise.all([
  loadProjectContent(),
  getCollection('terms'),
]);

const stations = buildStationViews(chain);
const terms = entries.map(({ data }) => data);
const termsById = new Map(terms.map((term) => [term.id, term]));
const domainNameById = new Map(domains.map((domain) => [domain.id, domain.shortNameZh]));
const termsByStation = groupTermsByStation(terms);

/** 每条阅读路线能提供哪些词条，以及这些词条落在哪几站。 */
const routesWithTerms = routes
  .map(({ data }) => data)
  .sort((left, right) => left.order - right.order)
  .map((route) => {
    const routeTermIds = new Set(
      route.chapters.flatMap((chapter) => chapter.terms.map((step) => step.id)),
    );
    const stationTally = new Map<number, number>();
    for (const termId of routeTermIds) {
      const order = termsById.get(termId)?.chain;
      if (typeof order !== 'number') continue;
      stationTally.set(order, (stationTally.get(order) ?? 0) + 1);
    }
    return { route, routeTermIds, stationTally };
  });

/** 题目的 references 命中本站任一概念，就算这一站的练习。 */
const questionsByStation = new Map<number, typeof LEARNING_QUESTIONS>();
for (const station of stations) {
  const stationTermIds = new Set((termsByStation.get(station.order) ?? []).map((term) => term.id));
  questionsByStation.set(
    station.order,
    LEARNING_QUESTIONS.filter((question) =>
      question.references.some((reference) => stationTermIds.has(reference.id)),
    ),
  );
}

const stationTermCount = (order: number) => (termsByStation.get(order) ?? []).length;
const coveredTerms = terms.filter((term) => typeof term.chain === 'number').length;

/**
 * 「五个概念各在哪一层」总图（《迭代开发说明书》I3-07）。
 *
 * 为什么要有它：MCP / Skill / Agent / LangChain / RAG 分散在 13 个领域里的两个，
 * 彼此之间没有链接，站点上没有任何一处回答「这五个词是什么关系」。
 * 而对读者来说，这张表的价值大于其中任意五篇词条——它要传达的是一个信息架构事实：
 * 它们不是五个并列名词，而是同一条链上五个不同的层次。
 *
 * 维护约束（I3-07 验收）：`confusion` 一列必须与对应词条页「必须澄清的误会」一节一一对应，
 * 表述不能冲突——改一处必须改两处。`station` 必须是这条概念所在的链路站点号，
 * 用来把这张静态表接回下面那条递进链路。
 */
const LAYER_CONCEPTS = [
  {
    termId: 'model-context-protocol',
    name: 'MCP',
    layer: '接口层',
    role: '怎么标准化地把模型接到外部工具和数据',
    confusion: '它和 Function Calling 是什么关系？',
    station: 5,
  },
  {
    termId: 'agent-skills',
    name: 'Skill',
    layer: '流程层',
    role: '怎么把「这件事该怎么做」沉淀成可复用的 SOP',
    confusion: '它和 Prompt、和 MCP 又是什么关系？',
    station: 6,
  },
  {
    termId: 'ai-agent',
    name: 'Agent',
    layer: '控制层',
    role: '模型自己规划、行动、观察、再规划的循环',
    confusion: '它和 Workflow 到底差在哪？',
    station: 4,
  },
  {
    termId: 'langchain',
    name: 'LangChain',
    layer: '实现层',
    role: '用代码把上面这些编排起来的框架',
    confusion: '它和 MCP 是不是竞品？',
    station: 6,
  },
  {
    termId: 'retrieval-augmented-generation',
    name: 'RAG',
    layer: '知识层',
    role: '回答之前先查你自己的资料',
    confusion: '它和微调该选哪个？',
    station: 3,
  },
] as const;
---

<BaseLayout
  title={section.pageTitle}
  description="语言模型缺什么、每一层补什么：从「模型是什么」到「什么时候必须有人管」的 8 站递进路径。不知道自己该先学什么时，从第 1 站开始。"
  structuredDataType="CollectionPage"
>
  <main id="main-content" class="map-page">
    <PageIntro
      eyebrow={`Cognitive chain · ${stations.length} stations · ${coveredTerms}/${terms.length} terms placed`}
      title={section.pageTitle}
      description="这 8 站回答同一个问题：语言模型缺什么，每一层补什么。它们是递进关系，不是并列清单——所以按顺序读，跳读会失去意义。"
    />

    <nav class="chain-rail" aria-label="链路站点导航">
      <ol>
        {
          stations.map((station) => (
            <li>
              <a href={`#station-${station.order}`} data-chain-rail={station.order}>
                <span class="rail-index">{String(station.order).padStart(2, '0')}</span>
                <span class="rail-name">{station.nameZh}</span>
                <span class="rail-count">{stationTermCount(station.order)} 个概念</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <section class="layer-guide" id="layers" aria-labelledby="layer-guide-title">
      <header class="layer-guide-head">
        <p class="meta-label">Five concepts · five layers</p>
        <h2 id="layer-guide-title">五个概念各在哪一层</h2>
        <p class="layer-guide-note">
          它们不是五个并列的名词，而是同一条链上五个不同的层次：谁管「接上」、谁管「怎么做」、
          谁管「谁决定下一步」、谁管「用代码实现」、谁管「知识从哪来」。把这五格放齐，
          再看下面的每一站，就不会把它们混成一类东西。
        </p>
      </header>
      <ul class="layer-list">
        {
          LAYER_CONCEPTS.map((concept) => (
            <li class="layer-row">
              <div class="layer-name">
                <a href={`/terms/${concept.termId}/`}>{concept.name}</a>
                <span class="layer-tag">{concept.layer}</span>
              </div>
              <p class="layer-role">{concept.role}</p>
              <p class="layer-confusion">
                <span class="layer-confusion-label">常见困惑</span>
                {concept.confusion}
              </p>
              <a class="layer-station" href={`#station-${concept.station}`}>
                第 {concept.station} 站
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="chain-stations">
      {
        stations.map((station) => {
          const stationTerms = termsByStation.get(station.order) ?? [];
          const questions = questionsByStation.get(station.order) ?? [];
          const stationRoutes = routesWithTerms.filter(({ stationTally }) =>
            stationTally.has(station.order),
          );

          return (
            <section
              id={`station-${station.order}`}
              class="chain-station"
              data-station={station.order}
            >
              <header class="station-head">
                <p class="meta-label">
                  Station {String(station.order).padStart(2, '0')} / {stations.length}
                </p>
                <h2>{station.nameZh}</h2>
                <p class="station-question" data-pagefind-meta={`station-${station.order}`}>
                  {station.question}
                </p>
                <p class="station-goal">{station.goal}</p>
              </header>

              <div class="station-grid">
                <section class="station-block station-terms" aria-label="本站概念">
                  <h3>本站概念</h3>
                  {stationTerms.length > 0 ? (
                    <ul>
                      {stationTerms.map((term) => (
                        <li data-role={term.chainRole ?? 'unplaced'}>
                          <a class="term-link" href={`/terms/${term.id}/`}>
                            {term.nameZh}
                          </a>
                          {term.chainRole && (
                            <span class="role-tag">
                              {CHAIN_ROLE_LABELS[term.chainRole as ChainRole]}
                            </span>
                          )}
                          <span class="term-domain">
                            {domainNameById.get(term.domain) ?? term.domain}
                          </span>
                          <p>{term.summary}</p>
                        </li>
                      ))}
                    </ul>
                  ) : (
                    <p class="empty-note">这一站的核心概念尚未挂上词条。</p>
                  )}
                </section>

                <div class="station-side">
                  <section class="station-block station-action" aria-label="上手动作">
                    <h3>上手动作</h3>
                    <p>{station.action}</p>
                  </section>

                  <section class="station-block station-questions" aria-label="对应判断题">
                    <h3>对应判断题</h3>
                    {questions.length > 0 ? (
                      <ul>
                        {questions.map((question) => (
                          <li>
                            <a href={`/learn/questions/${question.id}/`}>{question.shortTitle}</a>
                            <small>{question.index}</small>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="empty-note">这一站暂无对应题目。</p>
                    )}
                  </section>

                  <section class="station-block station-routes" aria-label="展开阅读清单">
                    <h3>展开阅读清单</h3>
                    {stationRoutes.length > 0 ? (
                      <ul>
                        {stationRoutes.map(({ route, stationTally }) => (
                          <li>
                            <a href={`/routes/${route.id}/`}>{route.nameZh}</a>
                            <small>{stationTally.get(station.order)} 个词条在本站</small>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="empty-note">暂无对应的展开阅读路线。</p>
                    )}
                  </section>
                </div>
              </div>

              <nav class="station-nav" aria-label={`第 ${station.order} 站前后站`}>
                {station.previous ? (
                  <a class="station-prev" href={`#station-${station.previous.order}`}>
                    ← 上一站 {station.previous.nameZh}
                  </a>
                ) : (
                  <span class="station-edge">这是起点</span>
                )}
                {station.next ? (
                  <a class="station-next" href={`#station-${station.next.order}`}>
                    下一站 {station.next.nameZh} →
                  </a>
                ) : (
                  <span class="station-edge">这是终点</span>
                )}
              </nav>
            </section>
          );
        })
      }
    </div>
  </main>
</BaseLayout>

<script>
  // 站点横条高亮当前站。用 IntersectionObserver 而不是 scroll 事件：
  // 后者要每帧读 getBoundingClientRect，而这个页面有 8 个高区块。
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-chain-rail]')];
  const sections = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((section): section is HTMLElement => section !== null);

  if (links.length > 0 && sections.length === links.length) {
    const setActive = (order: string) => {
      for (const link of links) {
        if (link.dataset.chainRail === order) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    // 维护「当前可见的站」集合，每次从全集里挑最靠前的一个。
    // 只看本次回调里变化的那些 entry 是错的：快速滚动时最后一个回调可能只包含
    // 新进入视口的一站，而它并不是视口里最靠上的那一个（实测点击第 5 站会亮第 4 站）。
    const visible = new Set<string>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const order = (entry.target as HTMLElement).dataset.station;
          if (!order) continue;
          if (entry.isIntersecting) visible.add(order);
          else visible.delete(order);
        }
        const topmost = [...visible].sort((left, right) => Number(left) - Number(right))[0];
        if (topmost) setActive(topmost);
      },
      // 上边距留出 sticky 顶栏高度，下边距吃掉大半个视口，
      // 这样「当前站」是视口顶部那一块，而不是屏幕中央那一块。
      { rootMargin: '-96px 0px -60% 0px', threshold: 0 },
    );

    for (const section of sections) observer.observe(section);

    // 点击指示条立即高亮：平滑滚动期间观察器可能还没跟上，
    // 那段时间里高亮停在上一站，读起来像是「点了没反应」。
    for (const link of links) {
      link.addEventListener('click', () => {
        const order = link.dataset.chainRail;
        if (order) setActive(order);
      });
    }
  }
</script>

<style>
  .map-page {
    padding-bottom: var(--space-7);
  }

  /* ---- 站点横条：索引，同时也是导航 ---------------------------------- */

  .chain-rail {
    width: min(calc(100% - 2.5rem), var(--content-max));
    margin: 0 auto var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-panel);
    overflow: hidden;
  }

  .chain-rail ol {
    display: grid;
    /* 8 列 → 4 列 → 2 列。刻意不用横向滚动容器：
       320px 下横向滚动条会让「有没有下一站」变得不可见。 */
    grid-template-columns: repeat(8, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chain-rail li + li {
    border-left: 1px solid var(--color-line-soft);
  }

  .chain-rail a {
    min-height: 5.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-0);
    padding: var(--space-2);
    text-decoration: none;
  }

  .chain-rail a:hover,
  .chain-rail a[aria-current='true'] {
    background: var(--color-panel-raised);
  }

  .chain-rail a[aria-current='true'] .rail-index {
    color: var(--color-accent);
  }

  .chain-rail a[aria-current='true'] .rail-name {
    color: var(--color-ink);
  }

  .rail-index {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1;
  }

  .rail-name {
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: var(--weight-display);
    line-height: 1.35;
  }

  .rail-count {
    color: var(--color-quiet);
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  /* ---- 五层总图：第 3–6 站的引导区 ------------------------------------ */

  .layer-guide {
    width: min(calc(100% - 2.5rem), var(--content-max));
    margin: 0 auto var(--space-5);
  }

  .layer-guide-head {
    margin-bottom: var(--space-3);
  }

  .layer-guide-head h2 {
    margin: var(--space-0) 0 var(--space-1);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    line-height: 1.3;
  }

  .layer-guide-note {
    max-width: var(--reading-max);
    margin: 0;
    color: var(--color-muted);
    line-height: 1.75;
  }

  .layer-list {
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-panel);
    list-style: none;
    overflow: hidden;
  }

  .layer-row {
    display: grid;
    /* 概念 + 层 / 一句话定位 / 常见困惑 / 站号。窄屏折叠成单列。 */
    grid-template-columns: minmax(8.5rem, 0.8fr) minmax(0, 1.5fr) minmax(0, 1.5fr) auto;
    gap: var(--space-2);
    align-items: baseline;
    padding: var(--space-2) var(--space-3);
  }

  .layer-row + .layer-row {
    border-top: 1px solid var(--color-line-soft);
  }

  .layer-name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1);
  }

  .layer-name a {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-display);
    text-decoration: none;
  }

  .layer-name a:hover {
    color: var(--color-accent);
  }

  .layer-tag {
    padding: 0.1rem 0.4rem;
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-sm);
    color: var(--color-muted);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .layer-role {
    margin: 0;
    color: var(--color-ink);
    line-height: 1.6;
  }

  .layer-confusion {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.6;
  }

  .layer-confusion-label {
    display: block;
    color: var(--color-quiet);
    font-size: var(--text-xs);
  }

  .layer-station {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 60rem) {
    .layer-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
  }

  /* ---- 站区块 -------------------------------------------------------- */

  .chain-stations {
    width: min(calc(100% - 2.5rem), var(--content-max));
    display: grid;
    gap: var(--space-4);
    margin: 0 auto;
  }

  .chain-station {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-panel);
    overflow: hidden;
    scroll-margin-top: 5.5rem;
  }

  .station-head {
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-3) var(--space-3) var(--space-3);
  }

  .station-head h2 {
    margin: var(--space-1) 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--weight-display);
    line-height: 1.3;
  }

  .station-question {
    max-width: 44rem;
    margin: 0;
    color: var(--color-accent-strong);
    font-family: var(--font-display);
    font-size: var(--text-lead);
    font-weight: var(--weight-body);
    line-height: 1.55;
  }

  .station-goal {
    max-width: 48rem;
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  .station-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
  }

  .station-side {
    border-left: 1px solid var(--color-line);
  }

  .station-block {
    padding: var(--space-3);
  }

  .station-block + .station-block {
    border-top: 1px solid var(--color-line-soft);
  }

  .station-block h3 {
    margin: 0 0 var(--space-2);
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: var(--weight-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .station-terms ul,
  .station-questions ul,
  .station-routes ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .station-terms li {
    position: relative;
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-2) 0;
  }

  .station-terms li:first-child {
    padding-top: 0;
  }

  .station-terms li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .term-link {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: var(--weight-display);
    text-decoration: none;
  }

  .term-link:hover {
    color: var(--color-accent);
  }

  .role-tag {
    display: inline-block;
    margin-left: var(--space-1);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 0.05rem 0.5rem;
    color: var(--color-quiet);
    font-size: var(--text-xs);
    line-height: 1.5;
    vertical-align: 0.1em;
  }

  .station-terms li[data-role='core'] .role-tag {
    border-color: color-mix(in oklch, var(--color-prerequisite) 45%, var(--color-line));
    color: var(--color-prerequisite);
  }

  .station-terms li[data-role='intro'] .role-tag {
    border-color: color-mix(in oklch, var(--color-accent) 45%, var(--color-line));
    color: var(--color-accent);
  }

  .term-domain {
    margin-left: var(--space-1);
    color: var(--color-quiet);
