---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

import GraphExplorer from '@/components/knowledge/GraphExplorer.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import StatusTag from '@/components/ui/StatusTag.astro';
import generatedGraph from '@/generated/graph.json';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CASE_STAGE_LABELS, caseHref, gateHref } from '@/lib/cases/presentation';
import { loadCaseStudies } from '@/lib/cases/io';
import { CHAIN_ROLE_LABELS, resolveTermChainPosition, type ChainRole } from '@/lib/content/chain';
import { loadProjectContent } from '@/lib/content/io';
import { getLearningRecommendations } from '@/lib/content/recommendations';
import { TERM_SECTIONS, extractSectionIds } from '@/lib/content/term-sections';
import { isDeprecatedTerm, isSelectableTerm } from '@/lib/content/visibility';
import { LEARNING_QUESTIONS, getLearningQuestionContext } from '@/data/learning';
import { selectLocalGraph, type GraphData } from '@/lib/graph/model';
import { buildContentIssueUrl } from '@/lib/site/github';

export const getStaticPaths = (async () => {
  const [entries, { relations, semanticRelations, domains, routes, chain }, cases] =
    await Promise.all([getCollection('terms'), loadProjectContent(), loadCaseStudies()]);
  const termMap = Object.fromEntries(entries.map(({ data }) => [data.id, data]));
  const domainMap = Object.fromEntries(domains.map((domain) => [domain.id, domain]));

  return entries.map((entry) => {
    const route = routes
      .filter(({ data }) =>
        data.chapters.some((chapter) => chapter.terms.some((step) => step.id === entry.data.id)),
      )
      .sort((left, right) => right.data.estimatedTerms - left.data.estimatedTerms)[0];
    const routeTerms = route?.data.chapters.flatMap((chapter) => chapter.terms) ?? [];
    const routeIndex = routeTerms.findIndex((step) => step.id === entry.data.id);
    const chainPosition = resolveTermChainPosition(entry.data, chain);
    // 已废弃词条搬到本页的「相关名词」——由 replacedBy 反查得来，不另立数据文件。
    // 用 frontmatter 反查而不是新加一份清单，是因为清单会漂移：改了一处忘了改另一处，
    // 宿主页就会出现一条指向不存在词条的名字（构建不报错，只有读者会撞上）。
    const absorbedTerms = entries
      .filter(
        ({ data }) =>
          isDeprecatedTerm(data) && data.replacedBy === entry.data.id && data.id !== entry.data.id,
      )
      .map(({ data }) => ({
        id: data.id,
        nameZh: data.nameZh,
        nameEn: data.nameEn,
        summary: data.summary,
        reason: data.deprecationReason ?? '已合并到本词条。',
      }))
      .sort((left, right) => left.nameZh.localeCompare(right.nameZh, 'zh-CN'));
    const replacement = entry.data.replacedBy
      ? entries.find(({ data }) => data.id === entry.data.replacedBy)?.data
      : undefined;
    const learningRecommendations = getLearningRecommendations(
      entry.data,
      entries.map(({ data }) => data),
      semanticRelations,
      chain,
    );
    const relatedQuestions = LEARNING_QUESTIONS.filter((question) =>
      question.references.some((reference) => reference.id === entry.data.id),
    ).map((question) => {
      const context = getLearningQuestionContext(question.id);
      return {
        id: question.id,
        index: question.index,
        shortTitle: question.shortTitle,
        question: question.question,
        tierCode: context?.tier.code ?? '',
        tierTitle: context?.tier.title ?? '',
        moduleTitle: context?.module.title ?? '',
      };
    });
    const relatedCases = cases.flatMap(({ data: caseStudy }) => {
      const termReferenceIds = new Set(
        caseStudy.references
          .filter((reference) => reference.kind === 'term' && reference.targetId === entry.data.id)
          .map((reference) => reference.id),
      );
      return caseStudy.gates.flatMap((gate) =>
        gate.referenceIds.flatMap((referenceId) => {
          if (!termReferenceIds.has(referenceId)) return [];
          return [
            {
              caseId: caseStudy.id,
              caseTitle: caseStudy.title,
              gateId: gate.id,
              gateOrder: gate.order,
              gateTitle: gate.title,
              stageLabel: CASE_STAGE_LABELS[gate.stageId],
            },
          ];
        }),
      );
    });

    return {
      params: { id: entry.data.id },
      props: {
        entry,
        domain: domainMap[entry.data.domain],
        relations: relations.filter(
          (relation) => relation.source === entry.data.id || relation.target === entry.data.id,
        ),
        relatedQuestions,
        relatedCases,
        learningRecommendations,
        absorbedTerms,
        replacement: replacement
          ? { id: replacement.id, nameZh: replacement.nameZh, summary: replacement.summary }
          : undefined,
        termMap,
        // 只透传渲染需要的字段：站点对象本身带 coreTerms 等与这一行无关的内容。
        chainPosition: chainPosition
          ? {
              order: chainPosition.order,
              role: chainPosition.role,
              stationName: chainPosition.station.nameZh,
              question: chainPosition.station.question,
              previous: chainPosition.previous
                ? { order: chainPosition.previous.order, nameZh: chainPosition.previous.nameZh }
                : undefined,
              next: chainPosition.next
                ? { order: chainPosition.next.order, nameZh: chainPosition.next.nameZh }
                : undefined,
            }
          : undefined,
        routeNav:
          route && routeIndex >= 0
            ? {
                id: route.data.id,
                name: route.data.nameZh,
                index: routeIndex + 1,
                total: routeTerms.length,
                previous: routeTerms[routeIndex - 1]?.id,
                next: routeTerms[routeIndex + 1]?.id,
              }
            : undefined,
      },
    };
  });
}) satisfies GetStaticPaths;

const {
  entry,
  domain,
  relations,
  relatedQuestions,
  relatedCases,
  learningRecommendations,
  absorbedTerms,
  replacement,
  termMap,
  routeNav,
  chainPosition,
} = Astro.props;
const term = entry.data;
const { Content } = await render(entry);
const relationLabels = {
  prerequisite: '前置概念',
  component: '组成部分',
  comparison: '易混概念',
  application: '实际应用',
} as const;
const difficultyLabels = { beginner: '入门', intermediate: '进阶', advanced: '深入' } as const;
// 段落锚点导航：从决策页模板 v2 的唯一事实源生成，不在这里手写。
// 手写的话，改了正文模板忘了改这里，锚点就会少一项或跳错位置，而构建不报错。
// 门禁 5 会逐条比对「正文实际的 h2 序列」与这份定义是否相等。
//
// 但「模板有 9 段」不等于「这一条已经写满 9 段」：存量词条里还有一批是 8 段。
// 对它们照模板渲染导航，读者点「必须澄清的误会」会落到页面底部——模板注释里
// 点名要防的正是这种静默死锚点。所以导航按正文实际段落过滤：段落补齐后自动出现，
// 不需要谁记得回来加一行。
const actualSectionIds = entry.body ? new Set(extractSectionIds(entry.body)) : null;
const sectionLinks = TERM_SECTIONS.filter(
  ({ id }) => !actualSectionIds || actualSectionIds.has(id),
).map(({ id, label }) => [id, label] as const);
const relationGroups = Object.entries(relationLabels).map(([type, label]) => ({
  type,
  label,
  items: relations.filter((relation) => relation.type === type),
}));
const correctionUrl = buildContentIssueUrl({
  title: `词条修订：${term.nameZh}`,
  pagePath: `/terms/${term.id}/`,
  context: `词条：${term.nameZh}\n具体问题：`,
});
const statusNotice = {
  catalogued: '这个词条已进入目录与关系系统，但深度正文尚未完成来源核验。',
  draft: '这个词条已有正文草稿，内容仍在编辑，暂不能视为已核验结论。',
  'needs-review': '这个词条因来源或时效变化需要重新复核，请谨慎引用。',
  deprecated: term.deprecationReason ?? '这个词条已停止单独维护，请优先阅读替代词条。',
  verified: '',
}[term.status];
const selectable = isSelectableTerm(term);
const hasDeepContent = term.status !== 'catalogued';
const localGraph = selectLocalGraph(generatedGraph as GraphData, term.id);
// 知识库 → 领域 → 词条名。领域用 shortNameZh：完整领域名（如「智能体与工具调用自动化」）
// 在 320px 下会把面包屑挤断，而中间层本来就只是「往上一级」的落点。
const breadcrumbTrail = [
  { label: '知识库', href: '/atlas/' },
  { label: domain?.shortNameZh ?? term.domain, href: `/atlas/#${term.domain}` },
  { label: term.nameZh },
];
---

<BaseLayout
  title={term.nameZh}
  description={term.summary}
  structuredDataType="TechArticle"
  indexable={selectable}
  searchMetadata={selectable
    ? {
        id: term.id,
        nameEn: term.nameEn,
        lookup: [
          term.nameZh,
          term.nameEn,
          ...term.abbreviations,
          ...term.aliases.map((alias) => alias.value),
        ].join(' '),
        domain: term.domain,
        domainNameZh: domain?.nameZh ?? term.domain,
        difficulty: term.difficulty,
        status: term.status,
      }
    : undefined}
>
  <main
    id="main-content"
    class="term-page"
    data-pagefind-body={selectable ? true : undefined}
    data-pagefind-ignore={selectable ? undefined : true}
  >
    <div class="term-breadcrumbs">
      <Breadcrumbs trail={breadcrumbTrail} />
    </div>

    <header class="term-hero">
      <div class="term-title">
        <p class="eyebrow">{domain?.nameZh ?? term.domain} · {difficultyLabels[term.difficulty]}</p>
        <h1 data-pagefind-meta="title" data-pagefind-weight="10">{term.nameZh}</h1>
        <p class="term-en">
          {term.nameEn}{term.abbreviations.length ? ` · ${term.abbreviations.join(' / ')}` : ''}
        </p>
      </div>
      <div class="term-summary">
        <StatusTag status={term.status} />
        <p>{term.summary}</p>
        <div class="term-actions">
          {selectable && <a href={`/graph/?focus=${term.id}`}>在概念图谱中查看</a>}
          <a href={correctionUrl}>提交修订建议</a>
        </div>
      </div>
    </header>

    <section class="term-meta" aria-label="词条元数据">
      <dl>
        <div><dt>领域</dt><dd>{domain?.shortNameZh ?? term.domain}</dd></div>
        <div><dt>难度</dt><dd>{difficultyLabels[term.difficulty]}</dd></div>
        <div>
          <dt>别名</dt><dd>{term.aliases.map((alias) => alias.value).join('、') || '无'}</dd>
        </div>
        <div><dt>最近核验</dt><dd>{term.verifiedAt ?? '待核验'}</dd></div>
      </dl>
    </section>

    {
      /*
       * 链路定位行。它不是第二套导航，而是一次定位：让读者在任何一条孤立词条上
       * 都看得到自己在整条理解路径里的位置，从而产生「上一站是什么 / 下一站是什么」
       * 的连续感。这正是 291 条无路线归属词条最缺的东西。
       * 与页脚的「阅读路线前后篇」刻意用不同措辞（站 vs 篇）：两者可能同时出现，
       * 读者需要一眼分清「沿链路走」和「沿某条路线走」是两条不同的路径。
       */
      chainPosition && (
        <p class="term-chain" data-chain-station={chainPosition.order}>
          <span class="chain-label">认知链路</span>
          <a class="chain-station-link" href={`/map/#station-${chainPosition.order}`}>
            第 {chainPosition.order} 站 · {chainPosition.stationName}
          </a>
          {chainPosition.role && (
            <span class="chain-role">{CHAIN_ROLE_LABELS[chainPosition.role as ChainRole]}</span>
          )}
          <span class="chain-neighbors">
            {chainPosition.previous ? (
              <a href={`/map/#station-${chainPosition.previous.order}`}>
                ← 上一站 {chainPosition.previous.nameZh}
              </a>
            ) : (
              <span class="chain-edge">这是链路起点</span>
            )}
            {chainPosition.next ? (
              <a href={`/map/#station-${chainPosition.next.order}`}>
                下一站 {chainPosition.next.nameZh} →
              </a>
            ) : (
              <span class="chain-edge">这是链路终点</span>
            )}
          </span>
        </p>
      )
    }

    {
      statusNotice && (
        <aside class={`status-notice notice-${term.status}`} aria-label="内容状态提示">
          <StatusTag status={term.status} />
          <p>
            {replacement && <strong>{`已并入《${replacement.nameZh}》。`}</strong>}
            {statusNotice}
          </p>
          {replacement && <a href={`/terms/${replacement.id}/`}>去读 {replacement.nameZh}</a>}
        </aside>
      )
    }

    <div class="term-layout">
      <details class="term-index" data-term-index open>
        <summary>本页目录</summary>
        <p class="meta-label">本页结构</p>
        <nav aria-label="词条页目录">
          {
            hasDeepContent ? (
              sectionLinks.map(([id, label]) => <a href={`#${id}`}>{label}</a>)
            ) : (
              <>
                <a href="#overview">内容概览</a>
                <a href="#relations">概念关系</a>
              </>
            )
          }
        </nav>
      </details>

      <article class="term-article" data-reveal>
        {
          hasDeepContent ? (
            <div class="term-content">
              <Content />
            </div>
          ) : (
            <section id="overview" class="catalogued-copy">
              <p class="section-number">Catalogue entry</p>
              <h2>内容概览</h2>
              <p class="lead">{term.summary}</p>
              <p>
                名称、摘要、领域和关系已经通过结构校验。完整解释、真实例子、适用边界和来源证据会在深度内容阶段补充。
              </p>
            </section>
          )
        }

        {
          relatedQuestions.length > 0 && (
            <section class="linked-resources" aria-labelledby="linked-questions-heading">
              <p class="section-number">Learning questions</p>
              <h2 id="linked-questions-heading">这个概念出现在哪些题里</h2>
              <p class="linked-resources-intro">
                下面的题目直接引用了本词条，适合先做判断，再回到正文核对边界。
              </p>
              <div class="linked-resource-list">
                {relatedQuestions.map((question) => (
                  <a class="linked-resource-row" href={`/learn/questions/${question.id}/`}>
                    <span class="linked-resource-kicker">
                      {question.tierCode} · {question.tierTitle} · 阶段：{question.moduleTitle}
                    </span>
                    <strong>
                      {question.index} · {question.shortTitle}
                    </strong>
                    <span>{question.question}</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {
          relatedCases.length > 0 && (
            <section class="linked-resources" aria-labelledby="linked-cases-heading">
              <p class="section-number">Case practice</p>
              <h2 id="linked-cases-heading">这个概念出现在哪些案例里</h2>
              <p class="linked-resources-intro">
                案例中的这些关卡会把概念放进业务约束、证据与取舍里练一遍。
              </p>
              <div class="linked-resource-list">
                {relatedCases.map((item) => (
                  <a class="linked-resource-row" href={gateHref(item.caseId, item.gateId)}>
                    <span class="linked-resource-kicker">
                      {item.caseTitle} · Gate {String(item.gateOrder).padStart(2, '0')} ·{' '}
                      {item.stageLabel}
                    </span>
                    <strong>{item.gateTitle}</strong>
                    <span>
                      进入关卡查看证据与取舍 ·{' '}
                      <span class="linked-resource-secondary">返回案例档案</span>
                    </span>
                  </a>
                ))}
              </div>
              <p class="linked-resource-footer">
                <a href={caseHref(relatedCases[0]!.caseId)}>查看第一个案例的完整档案</a>
              </p>
            </section>
          )
        }

        {
          learningRecommendations && (
            <section
              class="linked-resources learning-recommendations"
              aria-labelledby="learning-recommendations-heading"
            >
              <p class="section-number">Learning navigation</p>
              <h2 id="learning-recommendations-heading">学习导航</h2>
              <p class="linked-resources-intro">
                <strong>{learningRecommendations.sourceLabel}</strong>：
                {learningRecommendations.reason}
              </p>
              <div class="linked-resource-list">
                {learningRecommendations.items.map((item) => (
                  <a class="linked-resource-row" href={`/terms/${item.termId}/`}>
                    <span class="linked-resource-kicker">
                      {item.relationLabel ?? learningRecommendations.sourceLabel}
                    </span>
                    <strong>{item.nameZh}</strong>
                    <span>{item.explanation ?? item.summary}</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {
          /*
           * 概念关系只在可独立选择的词条上出现。已废弃词条的节点已经从图谱里隐去，
           * 照常渲染会得到一张空图 + 一段没有边的「关系」区——看起来像页面坏了。
           * 它的去向由上面的状态提示承担。
           */
          selectable && (
            <section id="relations" class="relations-section">
              <p class="section-number">Relations</p>
              <h2>概念关系</h2>
              <GraphExplorer
                graph={localGraph.graph}
                mode="local"
                focusId={term.id}
                hiddenNodeCount={localGraph.hiddenNodeCount}
              />
              {relationGroups.map(
                (group) =>
                  group.items.length > 0 && (
                    <div class="relation-group">
                      <h3>{group.label}</h3>
                      <div class="relation-list">
                        {group.items.map((relation) => {
                          const relatedId =
                            relation.source === term.id ? relation.target : relation.source;
                          const related = termMap[relatedId];
                          return (
                            <a
                              class={`relation-row type-${group.type}`}
                              href={`/terms/${relatedId}/`}
                            >
                              <strong>{related?.nameZh ?? relatedId}</strong>
                              <p>{relation.explanation}</p>
                            </a>
                          );
                        })}
                      </div>
                    </div>
                  ),
              )}
            </section>
          )
        }

        {
          /*
           * 「相关名词」——I6-03 的降级落点。
           *
           * 一批词条因为与同域词条重叠或本身是填充条目而不再单独成页，但它们的内容
           * 没有被丢掉：读者在宿主页这里能看到「这些名字属于这一块」，点进去还读得到
           * 原正文（旧 URL 不 404）。如果只是把它们从目录里删掉、不给这条通道，
           * 那些名字就真的消失了——降级和删除的区别全在这一个区块上。
           */
          absorbedTerms.length > 0 && (
            <section class="absorbed-terms" aria-labelledby="absorbed-heading">
              <p class="section-number">Related names</p>
              <h2 id="absorbed-heading">相关名词</h2>
              <p class="absorbed-intro">
                下面这些名字与「{term.nameZh}」讲的是同一块知识，内容已并入本页，
                不再单独作为入口出现。保留链接是为了让旧地址仍然能打开。
              </p>
              <ul class="absorbed-list">
                {absorbedTerms.map((item) => (
                  <li>
                    <a href={`/terms/${item.id}/`}>
                      <strong>{item.nameZh}</strong>
                      <span class="absorbed-en">{item.nameEn}</span>
                    </a>
                    <p>{item.reason}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          term.sources.length > 0 && (
            <section id="source-register" class="source-register">
              <p class="section-number">Source register</p>
              <h2>核验来源</h2>
              <ol>
                {term.sources.map((source) => (
                  <li id={`source-${source.id}`}>
                    <a href={source.url}>{source.title}</a>
                    <span>
                      {source.publisher} · 访问于 {source.accessedAt}
                    </span>
                  </li>
                ))}
              </ol>
              <p class="revision-line">
                发布 {term.publishedAt} · 更新 {term.updatedAt} · 核验 {term.verifiedAt}
              </p>
            </section>
          )
        }
      </article>
    </div>

    {
      routeNav && (
        <nav class="route-navigation" aria-label="阅读路线前后篇">
          <div class="route-position">
            <span>所属路线</span>
            <a href={`/routes/${routeNav.id}/`}>{routeNav.name}</a>
            <strong>
              {String(routeNav.index).padStart(2, '0')} / {routeNav.total}
            </strong>
          </div>
          <div class="route-links">
            {routeNav.previous ? (
              <a href={`/terms/${routeNav.previous}/`} rel="prev">
                <span>上一篇</span>
                {termMap[routeNav.previous]?.nameZh}
              </a>
            ) : (
              <span class="route-edge">这是路线起点</span>
            )}
            {routeNav.next ? (
              <a href={`/terms/${routeNav.next}/`} rel="next">
                <span>下一篇</span>
                {termMap[routeNav.next]?.nameZh}
              </a>
            ) : (
              <span class="route-edge">路线已完成</span>
            )}
          </div>
        </nav>
      )
    }
  </main>
</BaseLayout>

<script>
  const termIndex = document.querySelector<HTMLDetailsElement>('[data-term-index]');
  if (termIndex) {
    const compactIndex = window.matchMedia('(max-width: 760px)');
    const syncIndex = () => (termIndex.open = !compactIndex.matches);
    compactIndex.addEventListener('change', syncIndex);
    syncIndex();
  }
</script>

<style>
  .term-hero {
    min-height: 31rem;
    display: grid;
    grid-template-columns: minmax(24rem, 1fr) minmax(22rem, 0.46fr);
    border-bottom: 1px solid var(--color-line);
  }
  .term-hero > div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-7) var(--page-gutter);
  }
  .term-title {
    border-right: 1px solid var(--color-line);
  }
  .term-title h1 {
    max-width: 9em;
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: 6rem;
    font-weight: var(--weight-body);
    line-height: 0.98;
  }
  .term-en {
    margin: var(--space-3) 0 0;
    color: var(--color-muted);
