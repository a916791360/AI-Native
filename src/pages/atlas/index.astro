---
import PageIntro from '@/components/layout/PageIntro.astro';
import SearchExperience from '@/components/search/SearchExperience.astro';
import StatusTag from '@/components/ui/StatusTag.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadProjectContent } from '@/lib/content/io';
import { isSelectableTerm } from '@/lib/content/visibility';
import { deriveSiteMetrics } from '@/lib/site/metrics';

const project = await loadProjectContent();
const { domains, terms } = project;
const publicTerms = terms.filter(({ data }) => isSelectableTerm(data));
const metrics = deriveSiteMetrics(project);
const termsByDomain = new Map(
  domains.map((domain) => [
    domain.id,
    publicTerms
      .filter((term) => term.data.domain === domain.id)
      .sort(
        (a, b) => a.data.priority - b.data.priority || a.data.nameZh.localeCompare(b.data.nameZh),
      ),
  ]),
);
---

<BaseLayout
  title="知识库"
  description="按领域查找 AI-Native 已收录的中文 AI 词条。"
  structuredDataType="CollectionPage"
>
  <main id="main-content" class="atlas-page">
    <PageIntro
      eyebrow={`Knowledge base · ${metrics.domainCount} domains`}
      title="知识库"
      description={`先按领域定位问题，再沿前置、组成、比较与应用关系继续阅读。当前 ${metrics.verifiedTermCount} 个代表词条均已核验。`}
    />

    <section class="faceoff-portal-banner" aria-label="易混概念对决台入口">
      <div class="portal-badge">⚡ 认知实战专区</div>
      <div class="portal-content">
        <h2>易混概念同屏 PK 对决台</h2>
        <p>
          分不清 RAG 还是微调？分不清 Function Calling 还是 MCP？10
          组工业级高频混淆技术方案左右分屏对比、5 维量化权衡与场景选型自测。
        </p>
      </div>
      <a href="/atlas/faceoff/" class="portal-action"> 进入 10 组概念对决台 → </a>
    </section>

    <SearchExperience compact={true} emptyBehavior="index" indexTarget="#atlas-index" />

    <section class="atlas-controls" data-atlas-controls aria-label="图鉴目录控制">
      <label class="atlas-domain-mobile"
        ><span>当前领域</span><select data-atlas-domain-mobile>
          {domains.map((domain) => <option value={domain.id}>{domain.shortNameZh}</option>)}
        </select></label
      >
      <label class="atlas-ring-control"
        ><span>领域范围</span><select data-atlas-ring>
          <option value="all">全部领域</option>
          <option value="core">核心领域</option>
          <option value="extended">扩展领域</option>
        </select></label
      >
      <label
        ><span>排序方式</span><select data-atlas-sort>
          <option value="domain">领域顺序</option>
          <option value="name">词条名称</option>
          <option value="priority">内容优先级</option>
        </select></label
      >
      <p>
        显示 <strong data-atlas-visible>{metrics.termCount}</strong> / {metrics.termCount} 个词条
      </p>
    </section>

    <div class="atlas-layout" id="atlas-index" data-atlas-index>
      <nav class="domain-nav" aria-label="领域目录">
        {
          domains.map((domain) => (
            <a href={`#${domain.id}`}>
              <span>{String(domain.order).padStart(2, '0')}</span>
              {domain.shortNameZh}
            </a>
          ))
        }
      </nav>

      <div class="domain-sections" data-atlas-sections>
        {
          domains.map((domain) => {
            const domainTerms = termsByDomain.get(domain.id) ?? [];
            return (
              <section
                id={domain.id}
                class="domain-section"
                data-atlas-domain
                data-ring={domain.ring}
                data-order={domain.order}
                data-name={domainTerms[0]?.data.nameZh ?? domain.nameZh}
                data-priority={Math.min(...domainTerms.map(({ data }) => data.priority), 99)}
                data-term-count={domainTerms.length}
              >
                <header>
                  <p class="meta-label">
                    Domain {String(domain.order).padStart(2, '0')} · {domain.ring}
                  </p>
                  <h2>{domain.nameZh}</h2>
                  <p>{domain.description}</p>
                </header>
                <div class="term-list">
                  {domainTerms.length > 0 ? (
                    domainTerms.map(({ data: term }) => (
                      <a
                        class="term-row"
                        href={`/terms/${term.id}/`}
                        data-priority={term.priority}
                        data-name={term.nameZh}
                        data-search={`${term.nameZh} ${term.nameEn} ${term.abbreviations.join(' ')} ${term.aliases.map((alias) => alias.value).join(' ')}`.toLowerCase()}
                      >
                        <span>
                          <strong>{term.nameZh}</strong>
                          <small>{term.nameEn}</small>
                        </span>
                        <span class="term-summary">{term.summary}</span>
                        <StatusTag status={term.status} />
                      </a>
                    ))
                  ) : (
                    <p class="empty-domain">本领域目录将在批量内容阶段补充。</p>
                  )}
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import '@/scripts/atlas-index';
</script>

<style>
  .atlas-controls {
    display: grid;
    grid-template-columns: repeat(2, minmax(12rem, 18rem)) 1fr;
    align-items: center;
    border-bottom: 1px solid var(--color-line);
    padding: 0 var(--page-gutter);
  }
  .atlas-controls label {
    min-height: 4rem;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2);
    border-right: 1px solid var(--color-line-soft);
    padding: 0 var(--space-3);
  }
  .atlas-domain-mobile {
    display: none !important;
  }
  .atlas-controls label:first-child {
    padding-left: 0;
  }
  .atlas-controls label span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .atlas-controls select {
    min-width: 0;
    min-height: var(--control-height);
    border: 0;
    background: var(--color-black);
    color: var(--color-ink);
  }
  .atlas-controls p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-align: right;
  }
  .atlas-controls strong {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
    font-weight: var(--weight-body);
  }
  .atlas-layout {
    display: grid;
    grid-template-columns: minmax(13rem, 0.22fr) minmax(0, 1fr);
  }
  .atlas-layout[hidden] {
    display: none;
  }
  .domain-nav {
    position: sticky;
    top: var(--header-height);
    max-height: calc(100vh - var(--header-height));
    overflow-y: auto;
    scrollbar-width: thin;
    height: max-content;
    display: grid;
    border-right: 1px solid var(--color-line);
  }
  .domain-nav a {
    min-height: 3.4rem;
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    align-items: center;
    border-bottom: 1px solid var(--color-line-soft);
    padding: 0 var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .domain-nav a:hover {
    background: var(--color-panel);
    color: var(--color-ink);
  }
  .domain-nav span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .domain-section {
    display: grid;
    grid-template-columns: minmax(17rem, 0.36fr) minmax(0, 1fr);
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: calc(var(--header-height) + 1rem);
  }
  .domain-section[hidden] {
    display: none;
  }
  .domain-section > header {
    border-right: 1px solid var(--color-line);
    padding: var(--space-5) var(--page-gutter);
  }
  .domain-section h2 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: var(--weight-body);
    line-height: 1.2;
  }
  .domain-section header > p:last-child {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .term-list {
    min-width: 0;
  }
  .term-row {
    min-height: 7rem;
    display: grid;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(16rem, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-3) var(--page-gutter);
    text-decoration: none;
  }
  .term-row:hover {
    background: var(--color-panel);
  }
  .term-row > span:first-child {
    display: grid;
  }
  .term-row strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--weight-body);
  }
  .term-row small {
    color: var(--color-quiet);
    font-size: var(--text-xs);
  }
  .term-summary {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .empty-domain {
    min-height: 7rem;
    display: flex;
    align-items: center;
    margin: 0;
    padding: var(--space-3) var(--page-gutter);
    color: var(--color-quiet);
    font-size: var(--text-sm);
  }

  @media (max-width: 1100px) {
    .atlas-controls {
      grid-template-columns: repeat(2, 1fr);
      padding: 0;
    }
    .atlas-controls label {
      padding: 0 var(--space-2);
    }
    .atlas-controls p {
      grid-column: 1 / -1;
      border-top: 1px solid var(--color-line-soft);
      padding: var(--space-2);
      text-align: left;
    }
    .atlas-layout {
      grid-template-columns: 1fr;
    }
    .domain-nav {
      position: static;
      grid-template-columns: repeat(3, 1fr);
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .domain-section {
      grid-template-columns: 1fr;
    }
    .domain-section > header {
      border-right: 0;
      border-bottom: 1px solid var(--color-line-soft);
    }
  }

  @media (max-width: 620px) {
    .atlas-controls {
      grid-template-columns: 1fr;
    }
    .atlas-controls p {
      grid-column: auto;
    }
    .atlas-domain-mobile {
      display: grid !important;
    }
    .atlas-ring-control,
    .domain-nav {
      display: none !important;
    }
    .term-row {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      padding: var(--space-3);
    }
    .term-summary {
      display: -webkit-box;
      overflow: hidden;
      font-size: var(--text-sm);
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
    .term-row :global(.status-tag) {
      justify-self: start;
    }
  }

  .faceoff-portal-banner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: center;
    margin: var(--space-4) 0 var(--space-5);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
    transition: border-color var(--duration-quick);
  }

  .faceoff-portal-banner:hover {
    border-color: var(--color-accent);
  }

  .portal-badge {
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.6rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-display);
    white-space: nowrap;
  }

  .portal-content h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-display);
    color: var(--color-ink);
  }

  .portal-content p {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .portal-action {
    flex-shrink: 0;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: #ffffff;
    padding: 0.5rem 1.1rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-display);
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform var(--duration-quick),
      background-color var(--duration-quick),
      border-color var(--duration-quick);
  }

  .portal-action:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: #ffffff;
  }

  .portal-action:active {
    transform: scale(0.98);
  }

  @media (max-width: 768px) {
    .faceoff-portal-banner {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .portal-action {
      justify-self: start;
    }
  }
</style>
