---
import SearchExperience from '@/components/search/SearchExperience.astro';
import StatusTag from '@/components/ui/StatusTag.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadProjectContent } from '@/lib/content/io';
import { isSelectableTerm } from '@/lib/content/visibility';
import { deriveSiteMetrics } from '@/lib/site/metrics';
import '@/styles/atlas.css';

const project = await loadProjectContent();
const { domains, terms } = project;
const publicTerms = terms.filter(({ data }) => isSelectableTerm(data));
const metrics = deriveSiteMetrics(project);
const termsByDomain = new Map(
  domains.map((domain) => [
    domain.id,
    publicTerms
      .filter((term) => term.data.domain === domain.id)
      .sort(
        (a, b) => a.data.priority - b.data.priority || a.data.nameZh.localeCompare(b.data.nameZh),
      ),
  ]),
);
---

<BaseLayout
  title="知识库"
  description="按领域查找 AI-Native 已收录的中文 AI 词条。"
  structuredDataType="CollectionPage"
>
  <main id="main-content" class="atlas-page">
    <!-- 顶部宏大且通透的知识库 Hero -->
    <header class="page-intro atlas-hero">
      <div class="atlas-hero-content">
        <span class="atlas-eyebrow"
          >Knowledge Base · {metrics.domainCount} Domains · {metrics.verifiedTermCount} Verified Terms</span
        >
        <h1>知识库</h1>
        <p class="atlas-hero-lead">
          按领域系统查找中文 AI 核心词条，沿前置依赖、技术组成、场景对比与工程应用关系继续阅读。当前 {
            metrics.verifiedTermCount
          } 个核心词条均已严格核验。
        </p>
      </div>

      <!-- 核心指标统计卡片 -->
      <div class="atlas-hero-stats" aria-label="知识库核心统计">
        <div class="atlas-stat-pill">
          <span class="atlas-stat-num">{metrics.domainCount}</span>
          <span class="atlas-stat-desc">专业技术领域</span>
        </div>
        <div class="atlas-stat-pill">
          <span class="atlas-stat-num">{metrics.verifiedTermCount}</span>
          <span class="atlas-stat-desc">已核验词条</span>
        </div>
        <a href="/atlas/faceoff/" class="atlas-stat-pill" aria-label="查看 12 组概念对决台">
          <span class="atlas-stat-num">12 组</span>
          <span class="atlas-stat-desc">技术对决台 →</span>
        </a>
      </div>
    </header>

    <!-- 易混概念同屏 PK 对决台入口 Banner (12 组工业级前沿技术方案对比) -->
    <section class="atlas-faceoff-banner" aria-label="易混概念对决台入口">
      <div class="atlas-portal-badge">⚡ 认知实战专区</div>
      <div class="atlas-portal-content">
        <h2>易混概念同屏 PK 对决台</h2>
        <p>
          分不清 RAG 还是微调？分不清 Function Calling 还是 MCP？12 组工业级前沿技术方案（含 OpenAI
          o1 / DeepSeek-R1 / Claude 3.7 / Gemini 2.0 等前沿架构）左右分屏对比、5
          维量化权衡与场景选型自测。
        </p>
      </div>
      <a href="/atlas/faceoff/" class="atlas-portal-action"> 进入 12 组概念对决台 → </a>
    </section>

    <!-- 检索集成容器 -->
    <div class="atlas-search-wrapper">
      <SearchExperience compact={true} emptyBehavior="index" indexTarget="#atlas-index" />
    </div>

    <!-- 知识库控制与筛选工具条 -->
    <section class="atlas-controls" data-atlas-controls aria-label="图鉴目录控制">
      <div class="atlas-controls-group">
        <label class="atlas-control-field atlas-domain-mobile">
          <span class="atlas-control-label">当前领域</span>
          <div class="atlas-select-wrapper">
            <select data-atlas-domain-mobile aria-label="当前领域">
              {domains.map((domain) => <option value={domain.id}>{domain.shortNameZh}</option>)}
            </select>
          </div>
        </label>
        <label class="atlas-control-field atlas-ring-control">
          <span class="atlas-control-label">领域范围</span>
          <div class="atlas-select-wrapper">
            <select data-atlas-ring aria-label="领域范围">
              <option value="all">全部领域</option>
              <option value="core">核心领域</option>
              <option value="extended">扩展领域</option>
            </select>
          </div>
        </label>
        <label class="atlas-control-field">
          <span class="atlas-control-label">排序方式</span>
          <div class="atlas-select-wrapper">
            <select data-atlas-sort aria-label="排序方式">
              <option value="domain">领域顺序</option>
              <option value="name">词条名称</option>
              <option value="priority">内容优先级</option>
            </select>
          </div>
        </label>
      </div>
      <div class="atlas-counter-pill">
        <span class="atlas-counter-dot" aria-hidden="true"></span>
        <p style="margin: 0;">
          显示 <strong data-atlas-visible>{metrics.termCount}</strong> / {metrics.termCount} 个词条
        </p>
      </div>
    </section>

    <!-- 知识库主布局 (侧边目录 Rail + 领域词条卡片网格) -->
    <div class="atlas-layout" id="atlas-index" data-atlas-index>
      <nav class="domain-nav" aria-label="领域目录">
        <div class="domain-nav-header">
          <span class="domain-nav-title">领域目录</span>
          <span class="domain-nav-count">{domains.length} DOMAINS</span>
        </div>
        {
          domains.map((domain) => {
            const count = termsByDomain.get(domain.id)?.length ?? 0;
            return (
              <a href={`#${domain.id}`} class="domain-nav-item" title={domain.nameZh}>
                <span class="domain-nav-order">{String(domain.order).padStart(2, '0')}</span>
                <span class="domain-nav-text">{domain.shortNameZh}</span>
                <span class="domain-nav-badge">{count}</span>
              </a>
            );
          })
        }
      </nav>

      <div class="domain-sections" data-atlas-sections>
        {
          domains.map((domain) => {
            const domainTerms = termsByDomain.get(domain.id) ?? [];
            return (
              <section
                id={domain.id}
                class="domain-section"
                data-atlas-domain
                data-ring={domain.ring}
                data-order={domain.order}
                data-name={domainTerms[0]?.data.nameZh ?? domain.nameZh}
                data-priority={Math.min(...domainTerms.map(({ data }) => data.priority), 99)}
                data-term-count={domainTerms.length}
              >
                <header class="domain-section-header">
                  <div class="domain-meta-bar">
                    <div class="domain-tags-group">
                      <span class="domain-order-tag">
                        Domain {String(domain.order).padStart(2, '0')}
                      </span>
                      <span class="domain-ring-tag" data-ring={domain.ring}>
                        {domain.ring === 'core' ? '核心领域' : '扩展领域'}
                      </span>
                    </div>
                    <span class="domain-nav-count">{domainTerms.length} 个已收录词条</span>
                  </div>
                  <h2>{domain.nameZh}</h2>
                  <p class="domain-section-desc">{domain.description}</p>
                </header>
                <div class="term-list">
                  {domainTerms.length > 0 ? (
                    domainTerms.map(({ data: term }) => (
                      <a
                        class="term-row"
                        href={`/terms/${term.id}/`}
                        data-priority={term.priority}
                        data-name={term.nameZh}
                        data-search={`${term.nameZh} ${term.nameEn} ${term.abbreviations.join(' ')} ${term.aliases.map((alias) => alias.value).join(' ')}`.toLowerCase()}
                      >
                        <div class="term-card-top">
                          <div class="term-card-titles">
                            <strong>{term.nameZh}</strong>
                            <small>{term.nameEn}</small>
                          </div>
                          <StatusTag status={term.status} />
                        </div>
                        <p class="term-summary">{term.summary}</p>
                        <div class="term-card-footer">
                          <span class="term-card-action">查看词条详情与关系</span>
                          <span class="term-card-arrow" aria-hidden="true">
                            →
                          </span>
                        </div>
                      </a>
                    ))
                  ) : (
                    <p class="empty-domain">本领域目录将在批量内容阶段补充。</p>
                  )}
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  import '@/scripts/atlas-index';
</script>
