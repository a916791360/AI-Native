---
import PageIntro from '@/components/layout/PageIntro.astro';
import SearchExperience from '@/components/search/SearchExperience.astro';
import StatusTag from '@/components/ui/StatusTag.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadProjectContent } from '@/lib/content/io';

const { domains, terms } = await loadProjectContent();
const termsByDomain = new Map(
  domains.map((domain) => [
    domain.id,
    terms
      .filter((term) => term.data.domain === domain.id)
      .sort(
        (a, b) => a.data.priority - b.data.priority || a.data.nameZh.localeCompare(b.data.nameZh),
      ),
  ]),
);
---

<BaseLayout title="知识图鉴" description="按领域查找 AI-Native 已收录的中文 AI 词条。">
  <main id="main-content">
    <PageIntro
      eyebrow="Knowledge atlas · 12 domains"
      title="知识图鉴"
      description="先按领域定位问题，再沿前置、组成、比较与应用关系继续阅读。当前 12 个代表词条均已核验。"
    />

    <SearchExperience compact={true} emptyBehavior="index" indexTarget="#atlas-index" />

    <div class="atlas-layout" id="atlas-index">
      <nav class="domain-nav" aria-label="领域目录">
        {
          domains.map((domain) => (
            <a href={`#${domain.id}`}>
              <span>{String(domain.order).padStart(2, '0')}</span>
              {domain.shortNameZh}
            </a>
          ))
        }
      </nav>

      <div class="domain-sections">
        {
          domains.map((domain) => {
            const domainTerms = termsByDomain.get(domain.id) ?? [];
            return (
              <section id={domain.id} class="domain-section">
                <header>
                  <p class="meta-label">
                    Domain {String(domain.order).padStart(2, '0')} · {domain.ring}
                  </p>
                  <h2>{domain.nameZh}</h2>
                  <p>{domain.description}</p>
                </header>
                <div class="term-list">
                  {domainTerms.length > 0 ? (
                    domainTerms.map(({ data: term }) => (
                      <a
                        class="term-row"
                        href={`/terms/${term.id}/`}
                        data-search={`${term.nameZh} ${term.nameEn} ${term.abbreviations.join(' ')} ${term.aliases.map((alias) => alias.value).join(' ')}`.toLowerCase()}
                      >
                        <span>
                          <strong>{term.nameZh}</strong>
                          <small>{term.nameEn}</small>
                        </span>
                        <span class="term-summary">{term.summary}</span>
                        <StatusTag status={term.status} />
                      </a>
                    ))
                  ) : (
                    <p class="empty-domain">本领域目录将在批量内容阶段补充。</p>
                  )}
                </div>
              </section>
            );
          })
        }
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .atlas-layout {
    display: grid;
    grid-template-columns: minmax(13rem, 0.22fr) minmax(0, 1fr);
  }
  .atlas-layout[hidden] {
    display: none;
  }
  .domain-nav {
    position: sticky;
    top: 0;
    height: max-content;
    display: grid;
    border-right: 1px solid var(--color-line);
  }
  .domain-nav a {
    min-height: 3.4rem;
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    align-items: center;
    border-bottom: 1px solid var(--color-line-soft);
    padding: 0 var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .domain-nav a:hover {
    background: var(--color-panel);
    color: var(--color-ink);
  }
  .domain-nav span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }
  .domain-section {
    display: grid;
    grid-template-columns: minmax(17rem, 0.36fr) minmax(0, 1fr);
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: 1rem;
  }
  .domain-section > header {
    border-right: 1px solid var(--color-line);
    padding: var(--space-5) var(--page-gutter);
  }
  .domain-section h2 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 400;
    line-height: 1.2;
  }
  .domain-section header > p:last-child {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .term-list {
    min-width: 0;
  }
  .term-row {
    min-height: 7rem;
    display: grid;
    grid-template-columns: minmax(10rem, 0.45fr) minmax(16rem, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-3) var(--page-gutter);
    text-decoration: none;
  }
  .term-row:hover {
    background: var(--color-panel);
  }
  .term-row > span:first-child {
    display: grid;
  }
  .term-row strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
  }
  .term-row small {
    color: var(--color-quiet);
    font-size: var(--text-xs);
  }
  .term-summary {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .empty-domain {
    min-height: 7rem;
    display: flex;
    align-items: center;
    margin: 0;
    padding: var(--space-3) var(--page-gutter);
    color: var(--color-quiet);
    font-size: var(--text-sm);
  }

  @media (max-width: 900px) {
    .atlas-layout {
      grid-template-columns: 1fr;
    }
    .domain-nav {
      position: static;
      grid-template-columns: repeat(3, 1fr);
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .domain-section {
      grid-template-columns: 1fr;
    }
    .domain-section > header {
      border-right: 0;
      border-bottom: 1px solid var(--color-line-soft);
    }
  }

  @media (max-width: 620px) {
    .domain-nav {
      grid-template-columns: repeat(2, 1fr);
    }
    .term-row {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }
    .term-summary {
      font-size: 1rem;
    }
    .term-row :global(.status-tag) {
      justify-self: start;
    }
  }
</style>
