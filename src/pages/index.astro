---
import SearchForm from '@/components/ui/SearchForm.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LEARNING_MODULES, getQuestionsForModule } from '@/data/learning';
import { loadCaseStudies } from '@/lib/cases/io';
import { caseHref } from '@/lib/cases/presentation';
import { loadProjectContent } from '@/lib/content/io';
import { deriveSiteMetrics } from '@/lib/site/metrics';

const [project, cases] = await Promise.all([loadProjectContent(), loadCaseStudies()]);
const metrics = deriveSiteMetrics(project);
const firstQuestion = getQuestionsForModule(LEARNING_MODULES[0]!.id)[0]!;
const goldenCase = cases[0]!.data;
---

<BaseLayout
  description="面向中文 AI 初学者与产品人的落地型学习系统，通过基础判断、连续案例和完整项目建立 AI 产品能力。"
  structuredDataType="CollectionPage"
>
  <main id="main-content" class="home-page">
    <header class="home-hero">
      <div class="home-intro">
        <p class="eyebrow">6 stages · 3 learning levels</p>
        <h1>AI 产品经理<br />系统学习路径</h1>
        <p class="home-lead">
          从单点判断进入连续案例，再用同一个业务对象完成六关项目评审：学会何时使用
          AI、怎样控制失败，以及如何对价值、质量、成本和上线负责。
        </p>
        <div class="home-actions">
          <a class="primary-action" href={`/learn/questions/${firstQuestion.id}/`}>
            从第 01 题开始学习 <span aria-hidden="true">→</span>
          </a>
          <a class="secondary-action" href="/learn/">查看 6 阶段课程地图</a>
        </div>
        <p class="access-note">唯一默认起点 · 无需登录 · 不写作业 · 不保存个人进度</p>
      </div>

      <section class="learning-method" aria-labelledby="learning-method-heading">
        <p class="meta-label">三层学习结构</p>
        <h2 id="learning-method-heading">先练判断，再把判断连成项目</h2>
        <ol>
          <li>
            <span>01</span>
            <div><strong>Level 1 · 单点判断</strong><small>24 题建立基础判断和共同语言</small></div>
          </li>
          <li>
            <span>02</span>
            <div>
              <strong>Level 2 · 连续案例</strong><small>在同一情境中比较连续决策与后果</small>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <strong>Level 3 · 完整项目</strong><small>六个 Gate 形成可复核的项目档案</small>
            </div>
          </li>
        </ol>
        <a class="case-preview-link" href={caseHref(goldenCase.id)}>
          查看黄金项目：{goldenCase.title}
          <span aria-hidden="true">→</span>
        </a>
      </section>
    </header>

    <section class="course-overview" aria-labelledby="course-overview-heading">
      <header>
        <div>
          <p class="eyebrow">课程地图</p>
          <h2 class="section-heading" id="course-overview-heading">6 个阶段，一条学习主线</h2>
          <p>六阶段贯穿三层学习；现有 24 题负责 Level 1 基础判断，不再单独承担完整项目训练。</p>
        </div>
        <a href="/learn/">完整查看课程地图 <span aria-hidden="true">→</span></a>
      </header>

      <ol class="home-modules">
        {
          LEARNING_MODULES.map((module) => {
            const questions = getQuestionsForModule(module.id);
            return (
              <li data-accent={module.accent}>
                <div class="module-meta">
                  <span>{module.index}</span>
                  <small>
                    第 {questions[0]?.index}–{questions.at(-1)?.index} 题
                  </small>
                </div>
                <h3>{module.title}</h3>
                <p>{module.summary}</p>
                <dl>
                  <dt>这阶段要会判断</dt>
                  <dd>{module.decision}</dd>
                </dl>
              </li>
            );
          })
        }
      </ol>

      <div class="course-start">
        <div>
          <p class="meta-label">第一步</p>
          <strong>{firstQuestion.question}</strong>
          <small>从“这个问题是否真的需要 AI”开始建立判断标准。</small>
        </div>
        <a class="primary-action" href={`/learn/questions/${firstQuestion.id}/`}>
          开始第 01 题 <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <section class="knowledge-band" aria-labelledby="knowledge-heading">
      <div class="knowledge-intro">
        <p class="eyebrow">按需查阅</p>
        <h2 class="section-heading" id="knowledge-heading">遇到概念时，再进入知识库</h2>
        <p>不需要先背完 300 个词条。学习中遇到陌生概念，再搜索解释、阅读路线和关系。</p>
        <SearchForm />
      </div>
      <div class="knowledge-register" data-learning-foundation>
        <a href="/atlas/">
          <span>{metrics.verifiedTermCount} VERIFIED</span>
          <strong>已核验深度词条</strong>
          <small>从解释、边界到应用逐层阅读</small>
        </a>
        <a href="/routes/">
          <span>{metrics.publishedRouteCount} ROUTES</span>
          <strong>主题阅读路线</strong>
          <small>补齐案例背后的前置知识</small>
        </a>
        <a href="/graph/">
          <span>{metrics.relationCount} RELATIONS</span>
          <strong>概念关系图谱</strong>
          <small>查看前置、组成、比较与应用</small>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-hero {
    min-height: 38rem;
    display: grid;
    grid-template-columns: minmax(0, 0.58fr) minmax(23rem, 0.42fr);
    border-bottom: 1px solid var(--color-line);
  }

  .home-intro,
  .learning-method {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-7) var(--page-gutter);
  }

  .home-intro {
    border-right: 1px solid var(--color-line);
  }

  .home-intro h1 {
    max-width: 10em;
    margin: var(--space-3) 0 var(--space-3);
    font-family: var(--font-display);
    font-size: 5.75rem;
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .home-lead {
    max-width: 39rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lead);
    text-wrap: pretty;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-top: var(--space-5);
  }

  .primary-action,
  .secondary-action {
    min-height: 3.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0 var(--space-4);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      background var(--transition-fast),
      color var(--transition-fast);
  }

  .primary-action {
    background: var(--color-prerequisite);
    color: var(--color-black);
  }

  .primary-action:hover {
    background: var(--color-focus);
    transform: translateY(-2px);
  }

  .primary-action:active {
    transform: translateY(0);
  }

  .secondary-action {
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .secondary-action:hover {
    border-color: var(--color-prerequisite);
    color: var(--color-ink);
  }

  .access-note {
    margin: var(--space-2) 0 0;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .learning-method {
    background: var(--color-panel);
  }

  .learning-method .meta-label {
    color: var(--color-application);
  }

  .learning-method h2 {
    max-width: 13em;
    margin: var(--space-3) 0 var(--space-4);
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .learning-method ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .learning-method li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-2);
    border-top: 1px solid var(--color-line);
    padding: var(--space-2) 0;
  }

  .learning-method li > span {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .learning-method strong,
  .learning-method small {
    display: block;
  }

  .case-preview-link {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .case-preview-link:hover {
    border-color: var(--color-application);
    color: var(--color-ink);
  }

  .learning-method strong {
    font-size: var(--text-base);
    font-weight: 500;
  }

  .learning-method small {
    margin-top: 0.15rem;
    color: var(--color-muted);
  }

  .course-overview {
    border-bottom: 1px solid var(--color-line);
  }

  .course-overview > header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-5);
    align-items: end;
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-6) var(--page-gutter) var(--space-5);
  }

  .course-overview > header p:not(.eyebrow) {
    max-width: 44rem;
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
  }

  .course-overview > header > a {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-bottom: 1px solid var(--color-prerequisite);
    color: var(--color-prerequisite);
    text-decoration: none;
  }

  .home-modules {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home-modules > li {
    min-width: 0;
    min-height: 17rem;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--color-line-soft);
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-4) var(--page-gutter);
  }

  .home-modules > li:nth-child(3n) {
    border-right: 0;
  }

  .module-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .home-modules li[data-accent='prerequisite'] .module-meta > span {
    color: var(--color-prerequisite);
  }

  .home-modules li[data-accent='component'] .module-meta > span {
    color: var(--color-component);
  }

  .home-modules li[data-accent='comparison'] .module-meta > span {
    color: var(--color-comparison);
  }

  .home-modules li[data-accent='application'] .module-meta > span {
    color: var(--color-application);
  }

  .home-modules h3 {
    margin: var(--space-3) 0 var(--space-1);
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .home-modules > li > p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .home-modules dl {
    margin: auto 0 0;
    border-top: 1px solid var(--color-line-soft);
    padding-top: var(--space-2);
  }

  .home-modules dt {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .home-modules dd {
    margin: 0.2rem 0 0;
    color: var(--color-ink);
    font-size: var(--text-sm);
  }

  .course-start {
    display: flex;
    gap: var(--space-5);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--page-gutter);
    background: var(--color-panel);
  }

  .course-start strong,
  .course-start small {
    display: block;
  }

  .course-start strong {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 400;
  }

  .course-start small {
    margin-top: 0.2rem;
    color: var(--color-muted);
  }

  .knowledge-band {
    display: grid;
    grid-template-columns: minmax(20rem, 0.38fr) minmax(0, 0.62fr);
    border-bottom: 1px solid var(--color-line);
  }

  .knowledge-intro {
    border-right: 1px solid var(--color-line);
    padding: var(--space-6) var(--page-gutter);
  }

  .knowledge-intro > p:not(.eyebrow) {
    max-width: 34rem;
    margin: var(--space-3) 0 var(--space-4);
    color: var(--color-muted);
  }

  .knowledge-register {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .knowledge-register a {
    min-width: 0;
    min-height: 18rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-right: 1px solid var(--color-line-soft);
    padding: var(--space-4);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .knowledge-register a:last-child {
    border-right: 0;
  }

  .knowledge-register a:hover {
    background: var(--color-panel);
  }

  .knowledge-register span,
  .knowledge-register small {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .knowledge-register strong {
    margin: var(--space-2) 0 var(--space-1);
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 400;
  }

  @media (max-width: 1080px) {
    .home-intro h1 {
      font-size: 4.5rem;
    }

    .home-modules {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-modules > li:nth-child(3n) {
      border-right: 1px solid var(--color-line-soft);
    }

    .home-modules > li:nth-child(2n) {
      border-right: 0;
    }
  }

  @media (max-width: 820px) {
    .home-hero,
    .knowledge-band {
      grid-template-columns: 1fr;
    }

    .home-hero {
      min-height: 0;
    }

    .home-intro,
    .learning-method,
    .knowledge-intro {
      padding-block: var(--space-6);
    }

    .home-intro,
    .knowledge-intro {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .course-overview > header {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .course-overview > header > a {
      width: max-content;
    }

    .knowledge-register a {
      min-height: 13rem;
    }
  }

  @media (max-width: 576px) {
    .home-intro h1 {
      font-size: 3.25rem;
    }

    .home-actions,
    .course-start {
      align-items: stretch;
      flex-direction: column;
    }

    .home-actions a,
    .course-start > a {
      width: 100%;
    }

    .secondary-action {
      justify-content: flex-start;
      padding-inline: 0;
    }

    .learning-method h2 {
      font-size: 2.15rem;
    }

    .home-modules,
    .knowledge-register {
      grid-template-columns: 1fr;
    }

    .home-modules > li,
    .home-modules > li:nth-child(2n),
    .home-modules > li:nth-child(3n),
    .knowledge-register a {
      min-height: 0;
      border-right: 0;
    }

    .home-modules > li {
      min-height: 15rem;
    }

    .knowledge-register a {
      border-bottom: 1px solid var(--color-line-soft);
      padding-block: var(--space-5);
    }
  }
</style>
