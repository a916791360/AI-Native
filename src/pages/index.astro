---
import RelationField from '@/components/knowledge/RelationField.astro';
import SearchForm from '@/components/ui/SearchForm.astro';
import StatusTag from '@/components/ui/StatusTag.astro';
import { PLANNED_ROUTES } from '@/config/navigation';
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadProjectContent } from '@/lib/content/io';

const { domains } = await loadProjectContent();
const featuredDomains = domains.filter((domain) => domain.ring === 'core').slice(0, 5);
---

<BaseLayout>
  <main id="main-content" class="home-page">
    <section class="home-hero" aria-labelledby="page-title">
      <div class="home-intro">
        <p class="eyebrow">一套可以沿关系继续学习的 AI 知识体系</p>
        <h1 id="page-title">从听懂 AI，<br />到判断与设计。</h1>
        <p class="home-promise">{SITE.promise}</p>
        <SearchForm />
        <div class="legend" aria-label="关系图例">
          <span class="prerequisite"><i></i>前置</span>
          <span class="component"><i></i>组成</span>
          <span class="comparison"><i></i>比较</span>
          <span class="application"><i></i>应用</span>
        </div>
      </div>
      <RelationField />
    </section>

    <section class="route-band" aria-labelledby="routes-heading">
      <header>
        <p class="eyebrow">Learning routes</p>
        <h2 class="section-heading" id="routes-heading">从查询一个词，到建立一条理解路径</h2>
      </header>
      <div class="route-list">
        <a class="route-item route-live" href="/routes/rag-from-zero/">
          <span class="route-number">01</span>
          <span><strong>RAG 从零到理解与应用</strong><small>3 章 · 12 个代表词条</small></span>
          <StatusTag status="published" />
        </a>
        {
          PLANNED_ROUTES.map((route, index) => (
            <div class="route-item">
              <span class="route-number">0{index + 2}</span>
              <span>
                <>
                  <strong>{route.name}</strong>
                  <small>内容结构将在后续阶段建立</small>
                </>
              </span>
              <StatusTag status="planned" />
            </div>
          ))
        }
      </div>
    </section>

    <section class="domain-band" aria-labelledby="domains-heading">
      <div class="domain-heading">
        <p class="eyebrow">Knowledge domains</p>
        <h2 class="section-heading" id="domains-heading">先定位领域，再看概念如何相连</h2>
      </div>
      <nav class="domain-list" aria-label="核心领域">
        {
          featuredDomains.map((domain, index) => (
            <a href={`/atlas/#${domain.id}`}>
              <span>0{index + 1}</span>
              <strong>{domain.shortNameZh}</strong>
              <small>{domain.description}</small>
            </a>
          ))
        }
      </nav>
    </section>
  </main>
</BaseLayout>

<style>
  .home-hero {
    min-height: calc(100svh - var(--header-height));
    display: grid;
    grid-template-columns: minmax(24rem, 0.42fr) minmax(40rem, 0.58fr);
    border-bottom: 1px solid var(--color-line);
  }

  .home-intro {
    min-width: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--color-line);
    padding: clamp(2.5rem, 5vw, 4.5rem) var(--page-gutter) 2rem;
  }

  .home-intro h1 {
    max-width: 9em;
    margin: clamp(1.4rem, 4vh, 2.5rem) 0 1.4rem;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 5vw, 5.25rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .home-promise {
    max-width: 32rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lead);
    text-wrap: pretty;
  }

  .home-intro :global(.search-form) {
    margin-top: clamp(2rem, 6vh, 4rem);
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-4);
    margin-top: auto;
    padding-top: var(--space-6);
  }

  .legend span {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .legend i {
    width: 1.5rem;
    height: 2px;
    display: inline-block;
    background: currentColor;
  }

  .prerequisite {
    color: var(--color-prerequisite);
  }
  .component {
    color: var(--color-component);
  }
  .comparison {
    color: var(--color-comparison);
  }
  .application {
    color: var(--color-application);
  }

  .route-band {
    display: grid;
    grid-template-columns: minmax(18rem, 0.42fr) minmax(0, 1fr);
    border-bottom: 1px solid var(--color-line);
  }

  .route-band > header {
    border-right: 1px solid var(--color-line);
    padding: var(--space-7) var(--page-gutter);
  }

  .route-list {
    display: grid;
  }

  .route-item {
    min-height: 7.7rem;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-3) var(--page-gutter);
    color: var(--color-muted);
    text-decoration: none;
  }

  .route-live:hover {
    background: var(--color-panel);
    color: var(--color-ink);
  }

  .route-number {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .route-item > span:nth-child(2) {
    display: grid;
    gap: 0.25rem;
  }

  .route-item strong {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
  }

  .route-item small {
    font-size: var(--text-sm);
  }

  .domain-band {
    display: grid;
    grid-template-columns: minmax(18rem, 0.3fr) minmax(0, 1fr);
  }

  .domain-heading {
    border-right: 1px solid var(--color-line);
    padding: var(--space-7) var(--page-gutter);
  }

  .domain-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .domain-list a {
    min-height: 18rem;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--color-line);
    padding: var(--space-4);
    text-decoration: none;
  }

  .domain-list a:hover {
    background: var(--color-panel);
  }
  .domain-list span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .domain-list strong {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
  }
  .domain-list small {
    margin-top: var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.55;
  }

  @media (max-width: 980px) {
    .home-hero {
      grid-template-columns: 1fr;
    }
    .home-intro {
      min-height: 38rem;
      border-right: 0;
    }
    .route-band,
    .domain-band {
      grid-template-columns: 1fr;
    }
    .route-band > header,
    .domain-heading {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .domain-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .domain-list a {
      min-height: 13rem;
    }
  }

  @media (max-width: 560px) {
    .home-intro {
      min-height: 35rem;
      padding-top: var(--space-6);
    }
    .home-intro h1 {
      font-size: 3rem;
    }
    .route-item {
      min-height: 8.5rem;
      grid-template-columns: 2rem minmax(0, 1fr);
    }
    .route-item :global(.status-tag) {
      grid-column: 2;
      justify-self: start;
    }
    .domain-list {
      grid-template-columns: 1fr;
    }
    .domain-list a {
      min-height: 9rem;
    }
  }
</style>
