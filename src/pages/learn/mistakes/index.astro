---
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LEARNING_QUESTIONS, getLearningModule, getLearningTier } from '@/data/learning';
import { getDevilsAdvocate } from '@/lib/learning/devils-advocate';

const breadcrumbs = [{ label: '学习中心', href: '/learn/' }, { label: '错题攻坚' }];

const mistakeBank = LEARNING_QUESTIONS.map((question) => {
  const tier = getLearningTier(question.tierId);
  const module = getLearningModule(question.moduleId);
  return {
    id: question.id,
    index: question.index,
    tierCode: tier?.code ?? 'T1',
    tierTitle: tier?.title ?? '',
    moduleIndex: module?.index ?? 1,
    moduleTitle: module?.title ?? '',
    shortTitle: question.shortTitle,
    question: question.question,
    scenario: question.scenario,
    facts: question.facts,
    principle: question.principle,
    checks: question.checks,
    options: question.options.map((option) => ({
      id: option.id,
      label: option.label,
      assessment: option.assessment,
      feedback: option.feedback,
      advocate: getDevilsAdvocate(question, option),
    })),
  };
});
---

<BaseLayout
  title="错题攻坚专区 · AI 产品判断"
  description="针对此前未选到推荐方案的判断题进行专项重练。选项随机打散，重新答对即可销项消灭。"
>
  <main id="main-content" class="mistakes-page" data-mistakes-page>
    <div class="mistakes-breadcrumbs">
      <Breadcrumbs trail={breadcrumbs} />
    </div>

    <section class="mistakes-status-bar" aria-label="错题攻坚概况">
      <div class="status-summary">
        <span class="status-badge">错题攻坚</span>
        <p class="status-text">
          待消灭错题：<strong data-active-count>0</strong> 题
          <span class="status-sub">（已答对即刻移出错题本）</span>
        </p>
      </div>
      <div class="status-actions">
        <button type="button" class="btn-text" data-clear-all>清空错题本</button>
        <a href="/learn/" class="btn-link">返回学习中心</a>
      </div>
    </section>

    <!-- 空状态：无错题 -->
    <section class="mistakes-empty" data-empty-view hidden>
      <div class="empty-card">
        <span class="empty-icon" aria-hidden="true">✓</span>
        <h2>暂无待攻坚的错题</h2>
        <p>太棒了！你在前面的判断题中全部命中推荐方案，或者已经成功消灭了所有存量错题。</p>
        <div class="empty-actions">
          <a href="/learn/" class="btn-primary">返回学习中心继续刷题 →</a>
          <a href="/learn/complete/" class="btn-secondary">查看三层结业全景</a>
        </div>
      </div>
    </section>

    <!-- 攻坚作战区 -->
    <article class="mistakes-arena" data-arena-view hidden>
      <header class="arena-head">
        <p class="arena-meta">
          <span class="tier-chip" data-tier-chip>T1</span>
          <span data-module-label>阶段 1</span>
          <span class="arena-cursor" data-arena-cursor>错题 1 / 1</span>
        </p>
        <h1 data-question-title>题目加载中...</h1>
      </header>

      <section class="scenario-section">
        <div class="scenario-box">
          <p class="meta-label">情境</p>
          <p data-scenario-text>情境加载中...</p>
        </div>
        <div class="facts-box">
          <p class="meta-label">已知条件</p>
          <ol class="facts-list" data-facts-list></ol>
        </div>
      </section>

      <section class="options-section">
        <header class="options-head">
          <h2>重新做出你的决策</h2>
          <p class="options-hint">
            选项顺序已重新打散。按 <kbd>1</kbd>–<kbd>4</kbd> 或点击选项提交。
          </p>
        </header>

        <ol class="option-list" data-option-list></ol>
      </section>

      <!-- 攻坚反馈与反诘区 -->
      <section class="feedback-section" data-feedback-section hidden>
        <div class="feedback-card" data-feedback-card>
          <div class="verdict-banner" data-verdict-banner>
            <span class="verdict-icon" data-verdict-icon>✓</span>
            <strong data-verdict-title>攻坚成功！已从错题本消灭</strong>
          </div>
          <p class="feedback-why" data-feedback-why></p>

          <div class="devils-advocate-box" data-advocate-box hidden>
            <div class="advocate-header">
              <span class="advocate-role" data-advocate-role>评审反诘</span>
            </div>
            <p class="advocate-challenge" data-advocate-challenge></p>
            <p class="advocate-defense" data-advocate-defense></p>
          </div>

          <div class="principle-box" data-principle-box hidden>
            <p class="meta-label">核心原则与落地检查</p>
            <blockquote data-principle-quote></blockquote>
            <ul class="checks-list" data-checks-list></ul>
          </div>

          <div class="next-action-bar">
            <button type="button" class="btn-primary" data-next-question>攻坚下一题 →</button>
            <button type="button" class="btn-text" data-skip-question>暂跳过这题</button>
          </div>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>

<script
  is:inline
  id="mistake-bank-data"
  type="application/json"
  set:html={JSON.stringify(mistakeBank)}
/>

<script>
  const PROGRESS_KEY = 'ai-native.progress';

  interface OptionData {
    id: string;
    label: string;
    assessment: 'recommended' | 'conditional' | 'risky';
    feedback: string;
    advocate: {
      role: string;
      roleIcon: string;
      challenge: string;
      defenseKey: string;
    };
  }

  interface QuestionData {
    id: string;
    index: string;
    tierCode: string;
    tierTitle: string;
    moduleIndex: number;
    moduleTitle: string;
    shortTitle: string;
    question: string;
    scenario: string;
    facts: string[];
    principle: string;
    checks: string[];
    options: OptionData[];
  }

  interface ProgressData {
    answered: string[];
    missed: string[];
    choices: Record<string, number>;
    lastVisited: string | null;
  }

  const rawData = document.getElementById('mistake-bank-data')?.textContent;
  const questionBank: QuestionData[] = rawData ? JSON.parse(rawData) : [];
  const questionMap = new Map<string, QuestionData>(questionBank.map((q) => [q.id, q]));

  const readProgress = (): ProgressData => {
    try {
      const stored = JSON.parse(localStorage.getItem(PROGRESS_KEY) ?? '{}');
      return {
        answered: Array.isArray(stored.answered) ? stored.answered : [],
        missed: Array.isArray(stored.missed) ? stored.missed : [],
        choices:
          stored.choices && typeof stored.choices === 'object' && !Array.isArray(stored.choices)
            ? stored.choices
            : {},
        lastVisited: typeof stored.lastVisited === 'string' ? stored.lastVisited : null,
      };
    } catch {
      return { answered: [], missed: [], choices: {}, lastVisited: null };
    }
  };

  const saveProgress = (progress: ProgressData) => {
    try {
      localStorage.setItem(PROGRESS_KEY, JSON.stringify(progress));
    } catch {
      /* storage unavailable */
    }
  };

  // Fisher-Yates 随机打散选项，打破位置记忆
  const shuffleOptions = <T,>(array: T[]): T[] => {
    const copy = [...array];
    for (let i = copy.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      const temp = copy[i]!;
      copy[i] = copy[j]!;
      copy[j] = temp;
    }
    return copy;
  };

  const activeCountEl = document.querySelector<HTMLElement>('[data-active-count]');
  const emptyView = document.querySelector<HTMLElement>('[data-empty-view]');
  const arenaView = document.querySelector<HTMLElement>('[data-arena-view]');
  const tierChip = document.querySelector<HTMLElement>('[data-tier-chip]');
  const moduleLabel = document.querySelector<HTMLElement>('[data-module-label]');
  const cursorEl = document.querySelector<HTMLElement>('[data-arena-cursor]');
  const questionTitle = document.querySelector<HTMLElement>('[data-question-title]');
  const scenarioText = document.querySelector<HTMLElement>('[data-scenario-text]');
  const factsList = document.querySelector<HTMLElement>('[data-facts-list]');
  const optionList = document.querySelector<HTMLElement>('[data-option-list]');
  const feedbackSection = document.querySelector<HTMLElement>('[data-feedback-section]');
  const verdictBanner = document.querySelector<HTMLElement>('[data-verdict-banner]');
  const verdictIcon = document.querySelector<HTMLElement>('[data-verdict-icon]');
  const verdictTitle = document.querySelector<HTMLElement>('[data-verdict-title]');
  const feedbackWhy = document.querySelector<HTMLElement>('[data-feedback-why]');
  const advocateBox = document.querySelector<HTMLElement>('[data-advocate-box]');
  const advocateRole = document.querySelector<HTMLElement>('[data-advocate-role]');
  const advocateChallenge = document.querySelector<HTMLElement>('[data-advocate-challenge]');
  const advocateDefense = document.querySelector<HTMLElement>('[data-advocate-defense]');
  const principleBox = document.querySelector<HTMLElement>('[data-principle-box]');
  const principleQuote = document.querySelector<HTMLElement>('[data-principle-quote]');
  const checksList = document.querySelector<HTMLElement>('[data-checks-list]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-next-question]');
  const skipBtn = document.querySelector<HTMLButtonElement>('[data-skip-question]');
  const clearAllBtn = document.querySelector<HTMLButtonElement>('[data-clear-all]');

  let currentIndex = 0;
  let activeQuestions: QuestionData[] = [];
  let currentShuffledOptions: OptionData[] = [];
  let answeredCurrent = false;

  const refreshQuestions = () => {
    const progress = readProgress();
    activeQuestions = progress.missed
      .map((id) => questionMap.get(id))
      .filter((q): q is QuestionData => Boolean(q));

    if (activeCountEl) {
      activeCountEl.textContent = String(activeQuestions.length);
    }

    if (activeQuestions.length === 0) {
      if (emptyView) emptyView.hidden = false;
      if (arenaView) arenaView.hidden = true;
      return;
    }

    if (emptyView) emptyView.hidden = true;
    if (arenaView) arenaView.hidden = false;

    if (currentIndex >= activeQuestions.length) {
      currentIndex = 0;
    }
    renderCurrentQuestion();
  };

  const renderCurrentQuestion = () => {
    const q = activeQuestions[currentIndex];
    if (!q) return;

    answeredCurrent = false;
    currentShuffledOptions = shuffleOptions(q.options);

    if (tierChip) tierChip.textContent = q.tierCode;
    if (moduleLabel) moduleLabel.textContent = `阶段 ${q.moduleIndex} · ${q.moduleTitle}`;
    if (cursorEl) {
      cursorEl.textContent = `错题 ${currentIndex + 1} / ${activeQuestions.length}`;
    }
    if (questionTitle) questionTitle.textContent = q.question;
    if (scenarioText) scenarioText.textContent = q.scenario;

    if (factsList) {
      factsList.innerHTML = '';
      q.facts.forEach((fact, idx) => {
        const li = document.createElement('li');
        li.innerHTML = `<span>${String(idx + 1).padStart(2, '0')}</span> ${fact}`;
        factsList.appendChild(li);
      });
    }

    if (feedbackSection) feedbackSection.hidden = true;

    if (optionList) {
      optionList.innerHTML = '';
      currentShuffledOptions.forEach((option, idx) => {
        const key = String.fromCharCode(65 + idx);
        const li = document.createElement('li');
        li.className = 'option-item';
        li.dataset.optionId = option.id;
        li.dataset.assessment = option.assessment;

        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'option-button';
        button.innerHTML = `
          <span class="option-key" aria-hidden="true">${key}</span>
          <span class="option-label">${option.label}</span>
        `;
        button.addEventListener('click', () => chooseOption(idx));
        li.appendChild(button);
        optionList.appendChild(li);
      });
    }
  };

  const chooseOption = (index: number) => {
    if (answeredCurrent) return;
    const option = currentShuffledOptions[index];
    const q = activeQuestions[currentIndex];
    if (!option || !q) return;

    answeredCurrent = true;
    const isCorrect = option.assessment === 'recommended';

    // 视觉反馈
    const optionButtons = optionList?.querySelectorAll<HTMLElement>('.option-item');
    optionButtons?.forEach((item, idx) => {
      if (idx === index) {
        item.dataset.selected = 'true';
        item.dataset.result = isCorrect ? 'correct' : 'wrong';
      } else {
        item.dataset.dimmed = 'true';
      }
    });

    if (feedbackSection) feedbackSection.hidden = false;
    if (feedbackWhy) feedbackWhy.textContent = option.feedback;

    if (isCorrect) {
      // 成功销项
      const progress = readProgress();
      progress.missed = progress.missed.filter((id) => id !== q.id);
      saveProgress(progress);

      if (verdictBanner) verdictBanner.className = 'verdict-banner success';
      if (verdictIcon) verdictIcon.textContent = '✓';
      if (verdictTitle) verdictTitle.textContent = '攻坚成功！此题已从错题本消灭';

      if (advocateBox) advocateBox.hidden = true;

      // 展开核心原则与检查清单
      if (principleBox) principleBox.hidden = false;
      if (principleQuote) principleQuote.textContent = q.principle;
      if (checksList) {
        checksList.innerHTML = '';
        q.checks.forEach((chk, idx) => {
          const li = document.createElement('li');
          li.innerHTML = `<span>${String(idx + 1).padStart(2, '0')}</span> ${chk}`;
          checksList.appendChild(li);
        });
      }

      if (nextBtn) {
        nextBtn.textContent =
          progress.missed.length === 0 ? '完成全部攻坚！查看状态' : '攻坚下一题 →';
      }
      if (activeCountEl) activeCountEl.textContent = String(progress.missed.length);
    } else {
      // 仍然选择错误：保留错题，强化反诘
      if (verdictBanner) verdictBanner.className = 'verdict-banner warning';
      if (verdictIcon) verdictIcon.textContent = '✕';
      if (verdictTitle) verdictTitle.textContent = '该方案在业务评审中未获通过';

      if (advocateBox) {
        advocateBox.hidden = false;
        if (advocateRole) {
          advocateRole.textContent = `${option.advocate.roleIcon} 评审反诘 · ${option.advocate.role}`;
        }
        if (advocateChallenge) advocateChallenge.textContent = option.advocate.challenge;
        if (advocateDefense) advocateDefense.textContent = option.advocate.defenseKey;
      }

      if (principleBox) principleBox.hidden = true;

      if (nextBtn) nextBtn.textContent = '换下一题攻坚 →';
    }
  };

  nextBtn?.addEventListener('click', () => {
    refreshQuestions();
  });

  skipBtn?.addEventListener('click', () => {
    if (activeQuestions.length > 1) {
      currentIndex = (currentIndex + 1) % activeQuestions.length;
      renderCurrentQuestion();
    }
  });

  clearAllBtn?.addEventListener('click', () => {
    if (confirm('确认清空错题本？清空后所有错题记录将被移除。')) {
      const progress = readProgress();
      progress.missed = [];
      saveProgress(progress);
      refreshQuestions();
    }
  });

  // 键盘快捷键 1-4
  document.addEventListener('keydown', (event) => {
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target;
    if (target instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;

    if (!answeredCurrent) {
      const digit = Number(event.key);
      if (digit >= 1 && digit <= currentShuffledOptions.length) {
        event.preventDefault();
        chooseOption(digit - 1);
        return;
      }
    } else {
      if (event.key === 'Enter' || event.key === 'ArrowRight') {
        event.preventDefault();
        refreshQuestions();
      }
    }
  });

  // 初始化
  refreshQuestions();
</script>

<style>
  .mistakes-page {
    width: min(100%, var(--content-standard));
    margin-inline: auto;
    padding: var(--space-6) var(--page-gutter) var(--space-7);
  }

  .mistakes-breadcrumbs {
    width: min(100%, var(--content-standard));
    margin: var(--space-3) auto var(--space-4);
  }

  .mistakes-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5);
  }

  .status-summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .status-badge {
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    padding: 0.15rem 0.6rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-display);
    letter-spacing: 0.05em;
  }

  .status-text {
    margin: 0;
    color: var(--color-ink);
    font-size: var(--text-sm);
  }

  .status-text strong {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-base);
  }

  .status-sub {
    color: var(--color-quiet);
    font-size: var(--text-xs);
  }

  .status-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .btn-text {
    border: none;
    background: none;
    color: var(--color-quiet);
    font-size: var(--text-xs);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    padding: var(--space-1) var(--space-2);
  }

  .btn-text:hover {
    color: var(--color-error);
  }

  .btn-link {
    color: var(--color-ink);
    font-size: var(--text-xs);
    text-decoration: none;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.75rem;
    transition: border-color var(--duration-quick);
  }

  .btn-link:hover {
    border-color: var(--color-control-border);
    background: var(--color-panel-raised);
  }

  /* 空状态卡片 */
  .mistakes-empty {
    margin: var(--space-7) 0;
  }

  .empty-card {
    text-align: center;
    max-width: 38rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
  }

  .empty-icon {
    display: inline-grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-wash);
    color: var(--color-accent);
    font-size: 1.8rem;
    font-weight: var(--weight-display);
    margin-bottom: var(--space-3);
  }

  .empty-card h2 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-display);
    color: var(--color-ink);
  }

  .empty-card p {
    margin: 0 0 var(--space-5);
    color: var(--color-muted);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .empty-actions {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-block;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: oklch(0.2 0.04 120);
    padding: 0.55rem 1.35rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-display);
    text-decoration: none;
    cursor: pointer;
    transition: transform var(--duration-quick);
  }

  .btn-primary:active {
    transform: scale(0.98);
  }

  .btn-secondary {
    display: inline-block;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: var(--color-panel);
    color: var(--color-ink);
    padding: 0.55rem 1.35rem;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: border-color var(--duration-quick);
  }

  .btn-secondary:hover {
    border-color: var(--color-control-border);
  }

  /* 竞技场 */
  .arena-head {
    max-width: var(--reading-max);
  }

  .arena-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-quiet);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    margin: 0 0 var(--space-2);
  }

  .tier-chip {
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    padding: 0.1rem 0.45rem;
    color: var(--color-accent);
  }

  .arena-cursor {
    margin-left: auto;
    color: var(--color-accent-strong);
    font-weight: var(--weight-display);
  }

  .arena-head h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: var(--weight-display);
    line-height: 1.25;
    letter-spacing: var(--tracking-display);
    color: var(--color-ink);
  }

  .scenario-section {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line-soft);
  }

  .scenario-box .meta-label,
  .facts-box .meta-label,
  .principle-box .meta-label {
    color: var(--color-quiet);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-1);
  }

  .scenario-box p:last-child {
    margin: var(--space-1) 0 0;
    color: var(--color-ink);
    font-size: var(--text-base);
    line-height: 1.75;
  }

  .facts-list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts-list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2);
    border-left: 2px solid var(--color-line);
    padding: 0.25rem 0 0.25rem var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .facts-list li span {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

