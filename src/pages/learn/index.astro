---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LEARNING_MODULES, getQuestionsForModule } from '@/data/learning';
import { loadCaseStudies } from '@/lib/cases/io';
import { caseHref, gateHref } from '@/lib/cases/presentation';

const firstQuestion = getQuestionsForModule(LEARNING_MODULES[0]!.id)[0]!;
const cases = await loadCaseStudies();
const goldenCase = cases[0]!.data;
const firstGate = goldenCase.gates[0]!;
---

<BaseLayout
  title="AI 产品经理学习中心"
  description="通过六个能力阶段、三层学习方式和一个完整黄金项目，从零建立可迁移的 AI 产品判断。"
  structuredDataType="CollectionPage"
>
  <main id="main-content" class="learn-page">
    <header class="course-hero">
      <div class="course-title">
        <p class="eyebrow">AI product manager · 3 learning levels</p>
        <h1>从单点判断，<br />走到完整项目。</h1>
        <p>
          六个能力阶段贯穿基础判断、连续案例和完整项目。新学习者仍从第 01
          题开始，再把判断放进同一个真实业务对象。
        </p>
        <a class="hero-start" href={`/learn/questions/${firstQuestion.id}/`}>
          从第 01 题开始学习 <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="course-outcome">
        <p class="meta-label">完成三层学习后，你能够</p>
        <h2>把一个 AI 想法，整理成可评审的产品方案</h2>
        <ul>
          <li><span>01</span>判断场景是否真的需要 AI</li>
          <li><span>02</span>比较方案并说明技术取舍</li>
          <li><span>03</span>设计人机边界与失败恢复</li>
          <li><span>04</span>定义质量、成本和上线护栏</li>
        </ul>
      </div>
    </header>

    <section class="learning-levels" aria-labelledby="learning-levels-heading">
      <header>
        <p class="eyebrow">Learning architecture</p>
        <h2 id="learning-levels-heading">三层不是三条主线，而是逐步加深的同一条路径</h2>
        <p>
          默认从 Level 1 开始。有基础的学习者可以按需查看黄金项目，但案例入口不会替代唯一默认起点。
        </p>
      </header>
      <ol>
        <li data-level="foundation">
          <span>Level 1</span>
          <h3>单点判断</h3>
          <p>24 道基础题，每次聚焦一个产品取舍，建立共同语言和判断原则。</p>
          <a href={`/learn/questions/${firstQuestion.id}/`}
            >从第 01 题开始学习 <span aria-hidden="true">→</span></a
          >
        </li>
        <li data-level="case">
          <span>Level 2</span>
          <h3>连续案例</h3>
          <p>围绕每日用户反馈分析，连续比较事实、未知项、方案后果和材料变化。</p>
          <a href={gateHref(goldenCase.id, firstGate.id)}>从 Gate 01 查看连续决策</a>
        </li>
        <li data-level="capstone">
          <span>Level 3</span>
          <h3>完整项目</h3>
          <p>同一个业务对象通过六个 Gate，形成完整 AI 产品评审档案。</p>
          <a href={caseHref(goldenCase.id)}>查看黄金项目档案</a>
        </li>
      </ol>
    </section>

    <section class="course-map" aria-labelledby="curriculum-heading">
      <header class="course-guide">
        <div class="guide-copy">
          <p class="eyebrow">从这里开始</p>
          <h2 id="curriculum-heading">Level 1 · 按顺序完成 6 个阶段</h2>
          <p>
            每阶段连续完成 4 道基础判断题。先选择，再看反馈；这一步建立判断，不等同于完成项目交付。
          </p>
        </div>
        <dl class="curriculum-facts">
          <div><dt>层级</dt><dd>Level 1</dd></div>
          <div><dt>练习</dt><dd>24 基础题</dd></div>
          <div><dt>方式</dt><dd>判断 · 反馈 · 继续</dd></div>
        </dl>
        <div class="guide-actions">
          <a class="primary" href={`/learn/questions/${firstQuestion.id}/`}>
            从第 01 题开始学习 <span aria-hidden="true">→</span>
          </a>
          <a class="secondary" href="/learn/questions/">查看 24 题目录</a>
        </div>
      </header>

      <ol class="course-modules">
        {
          LEARNING_MODULES.map((module) => {
            const questions = getQuestionsForModule(module.id);
            const first = questions[0]!;
            const last = questions.at(-1)!;
            return (
              <li id={`module-${module.index}`} data-accent={module.accent}>
                <span class="module-number">{module.index}</span>
                <div class="module-copy">
                  <p class="meta-label">Stage {module.index}</p>
                  <h3>{module.title}</h3>
                  <p>{module.summary}</p>
                </div>
                <div class="module-focus">
                  <p>
                    第 {first.index}–{last.index} 题
                  </p>
                  <strong>{module.decision}</strong>
                  <small>{module.outcome}</small>
                </div>
                <a
                  class:list={{ 'module-action': true, primary: module.index === '01' }}
                  href={`/learn/questions/${first.id}/`}
                >
                  {module.index === '01' ? '开始阶段 01' : `进入第 ${first.index} 题`}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            );
          })
        }
      </ol>
    </section>
  </main>
</BaseLayout>

<style>
  .course-hero {
    min-height: 32rem;
    display: grid;
    grid-template-columns: minmax(0, 0.58fr) minmax(22rem, 0.42fr);
    border-bottom: 1px solid var(--color-line);
  }

  .course-title,
  .course-outcome {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-7) var(--page-gutter);
  }

  .course-title {
    border-right: 1px solid var(--color-line);
  }

  .course-title h1 {
    max-width: 9em;
    margin: var(--space-3) 0 var(--space-3);
    font-family: var(--font-display);
    font-size: 5.75rem;
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: 0;
  }

  .course-title > p:not(.eyebrow) {
    max-width: 38rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }

  .hero-start {
    width: max-content;
    min-height: 3.25rem;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
    background: var(--color-prerequisite);
    padding: 0 var(--space-4);
    color: var(--color-black);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      background var(--transition-fast);
  }

  .hero-start:hover {
    background: var(--color-focus);
    transform: translateY(-2px);
  }

  .course-outcome {
    background: var(--color-panel);
  }

  .course-outcome .meta-label {
    color: var(--color-application);
  }

  .course-outcome h2 {
    max-width: 13em;
    margin: var(--space-3) 0 var(--space-4);
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .course-outcome ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course-outcome li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-2);
    border-top: 1px solid var(--color-line);
    padding: 0.65rem 0;
    color: var(--color-muted);
  }

  .course-outcome li span {
    color: var(--color-application);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .course-map {
    border-bottom: 1px solid var(--color-line);
  }

  .learning-levels {
    border-bottom: 1px solid var(--color-line);
  }

  .learning-levels > header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.45fr);
    gap: var(--space-6);
    align-items: end;
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-6) var(--page-gutter) var(--space-4);
  }

  .learning-levels > header h2 {
    max-width: 19em;
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .learning-levels > header > p:not(.eyebrow) {
    margin: 0;
    color: var(--color-muted);
  }

  .learning-levels > ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .learning-levels li {
    min-height: 19rem;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--color-line-soft);
    padding: var(--space-4) var(--page-gutter);
  }

  .learning-levels li:last-child {
    border-right: 0;
  }

  .learning-levels li > span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .learning-levels li[data-level='foundation'] > span {
    color: var(--color-prerequisite);
  }

  .learning-levels li[data-level='case'] > span {
    color: var(--color-component);
  }

  .learning-levels li[data-level='capstone'] > span {
    color: var(--color-application);
  }

  .learning-levels h3 {
    margin: var(--space-3) 0 var(--space-1);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
  }

  .learning-levels li > p {
    color: var(--color-muted);
  }

  .learning-levels li > a {
    min-height: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    padding-inline: var(--space-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .learning-levels li[data-level='foundation'] > a {
    border: 0;
    background: var(--color-prerequisite);
    color: var(--color-black);
    font-weight: 600;
  }

  .course-guide {
    display: grid;
    grid-template-columns: minmax(22rem, 1fr) minmax(20rem, 0.75fr) auto;
    gap: var(--space-5);
    align-items: center;
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-5) var(--page-gutter);
  }

  .guide-copy h2 {
    margin: var(--space-1) 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .guide-copy > p:not(.eyebrow) {
    max-width: 38rem;
    margin: 0;
    color: var(--color-muted);
  }

  .curriculum-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--color-line-soft);
    border-bottom: 1px solid var(--color-line-soft);
  }

  .curriculum-facts div {
    border-right: 1px solid var(--color-line-soft);
    padding: var(--space-2);
  }

  .curriculum-facts div:last-child {
    border-right: 0;
  }

  .curriculum-facts dt {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .curriculum-facts dd {
    margin: 0.2rem 0 0;
    color: var(--color-ink);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .guide-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: stretch;
  }

  .guide-actions a {
    min-height: 3.25rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: 0 var(--space-4);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .guide-actions .primary {
    background: var(--color-prerequisite);
    color: var(--color-black);
    transition:
      transform var(--transition-fast),
      background var(--transition-fast);
  }

  .guide-actions .primary:hover {
    background: var(--color-focus);
    transform: translateY(-2px);
  }

  .guide-actions .secondary {
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
  }

  .guide-actions .secondary:hover {
    border-color: var(--color-prerequisite);
    color: var(--color-ink);
  }

  .course-modules {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course-modules > li {
    min-height: 13rem;
    display: grid;
    grid-template-columns: 3rem minmax(15rem, 0.9fr) minmax(17rem, 0.9fr) minmax(10rem, auto);
    gap: var(--space-4);
    align-items: center;
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-4) var(--page-gutter);
  }

  .course-modules > li:last-child {
    border-bottom: 0;
  }

  .module-number {
    align-self: start;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .course-modules li[data-accent='prerequisite'] .module-number {
    color: var(--color-prerequisite);
  }

  .course-modules li[data-accent='component'] .module-number {
    color: var(--color-component);
  }

  .course-modules li[data-accent='comparison'] .module-number {
    color: var(--color-comparison);
  }

  .course-modules li[data-accent='application'] .module-number {
    color: var(--color-application);
  }

  .module-copy h3 {
    margin: 0.3rem 0 var(--space-1);
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .module-copy > p:not(.meta-label) {
    max-width: 32rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .module-focus {
    border-top: 1px solid var(--color-line-soft);
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-2) 0;
  }

  .module-focus p,
  .module-focus small {
    margin: 0;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .module-focus strong {
    display: block;
    margin: 0.35rem 0;
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .module-action {
    min-height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-line);
    padding: 0 var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    white-space: nowrap;
  }

  .module-action:hover {
    border-color: var(--color-prerequisite);
    color: var(--color-ink);
  }

  .module-action.primary {
    border-bottom: 0;
    background: var(--color-prerequisite);
    color: var(--color-black);
    font-weight: 600;
  }

  @media (max-width: 1120px) {
    .course-title h1 {
      font-size: 4.5rem;
    }

    .course-guide {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.8fr);
    }

    .guide-actions {
      grid-column: 1 / -1;
      align-items: center;
      flex-direction: row;
    }

    .course-modules > li {
      grid-template-columns: 3rem minmax(15rem, 0.9fr) minmax(17rem, 1fr);
    }

    .module-action {
      grid-column: 2 / -1;
      width: max-content;
    }
  }

  @media (max-width: 820px) {
    .course-hero,
    .course-guide,
    .learning-levels > header {
      grid-template-columns: 1fr;
    }

    .learning-levels > ol {
      grid-template-columns: 1fr;
    }

    .learning-levels li {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--color-line-soft);
      padding-block: var(--space-5);
    }

    .learning-levels li > a {
      margin-top: var(--space-4);
    }

    .course-hero {
      min-height: 0;
    }

    .course-title,
    .course-outcome {
      padding-block: var(--space-6);
    }

    .course-title {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .guide-actions {
      grid-column: auto;
    }

    .course-modules > li {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .module-focus,
    .module-action {
      grid-column: 2;
    }
  }

  @media (max-width: 576px) {
    .course-title h1 {
      font-size: 3.25rem;
    }

    .course-outcome h2,
    .guide-copy h2 {
      font-size: 2.15rem;
    }

    .hero-start {
      width: 100%;
      justify-content: center;
    }

    .course-guide {
      gap: var(--space-4);
      padding-block: var(--space-5);
    }

    .curriculum-facts {
      grid-template-columns: 1fr;
    }

    .curriculum-facts div {
      border-right: 0;
      border-bottom: 1px solid var(--color-line-soft);
    }

    .curriculum-facts div:last-child {
      border-bottom: 0;
    }

    .guide-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .course-modules > li {
      min-height: 0;
      gap: var(--space-3);
      padding-block: var(--space-5);
    }

    .module-action,
    .module-action.primary {
      width: 100%;
      justify-content: space-between;
      padding-inline: var(--space-3);
    }
  }
</style>
