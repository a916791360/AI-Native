---
import PageIntro from '@/components/layout/PageIntro.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  LEARNING_MODULES,
  LEARNING_QUESTIONS,
  LEARNING_TIERS,
  getQuestionsForModule,
  getQuestionsForTier,
} from '@/data/learning';

const total = LEARNING_QUESTIONS.length;
const order = LEARNING_QUESTIONS.map((question) => question.id);
const firstQuestionId = LEARNING_QUESTIONS[0]!.id;

const tiers = LEARNING_TIERS.map((tier) => ({
  id: tier.id,
  code: tier.code,
  title: tier.title,
  goal: tier.goal,
  questionIds: getQuestionsForTier(tier.id).map((question) => question.id),
}));

const rows = LEARNING_MODULES.map((module) => ({
  index: module.index,
  title: module.title,
  decision: module.decision,
  cells: LEARNING_TIERS.map((tier) => {
    const questions = getQuestionsForModule(module.id, tier.id);
    return {
      tierId: tier.id,
      questionIds: questions.map((question) => question.id),
    };
  }),
}));
---

<BaseLayout
  title="结业 · 三层训练"
  description={`走完 ${total} 道判断题后，这里记录三层训练的完成情况，并给出下一步。`}
>
  <main
    id="main-content"
    class="complete-page"
    data-complete
    data-total={total}
    data-question-order={JSON.stringify(order)}
  >
    <PageIntro
      eyebrow={`三层训练 · ${total} questions`}
      title="结业 · 三层训练"
      description={`三层递进，每层把六个阶段完整走一遍：先认得出概念，再判断得了边界，最后做得了取舍。走完 ${total} 题，你就把同一套判断方法在三种深度上各练了一遍。`}
    />

    <section class="complete-status" aria-label="完成情况" aria-live="polite">
      <p class="status-count">
        <strong data-complete-count>0</strong>
        <span>/ {total} 题已答</span>
      </p>
      <p class="status-note" data-complete-note>
        进度记录在本机浏览器，不上传、不注册账号。答满 {total} 题后，这里会显示结业状态。
      </p>
      <a class="status-action" href={`/learn/questions/${firstQuestionId}/`} data-complete-next>
        从第 01 题开始 →
      </a>
    </section>

    <section class="complete-tiers" aria-labelledby="tiers-heading">
      <h2 id="tiers-heading">三层完成情况</h2>
      <ol>
        {
          tiers.map((tier) => (
            <li data-tier-ids={JSON.stringify(tier.questionIds)}>
              <div class="tier-row-head">
                <span class="tier-code">{tier.code}</span>
                <h3>{tier.title}</h3>
                <small data-tier-progress>0 / {tier.questionIds.length}</small>
              </div>
              <p>{tier.goal}</p>
              <div class="tier-rail">
                <span data-tier-rail />
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="complete-matrix" aria-labelledby="matrix-heading">
      <h2 id="matrix-heading">六个阶段 × 三层</h2>
      <p class="matrix-note">每一格是「这一层的这个阶段」的完成题数，答满会标记出来。</p>
      <div class="matrix-scroll">
        <table>
          <caption class="screen-reader-only">六个阶段在每一层的完成题数</caption>
          <thead>
            <tr>
              <th scope="col">阶段</th>
              {
                tiers.map((tier) => (
                  <th scope="col">
                    {tier.code} {tier.title}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <th scope="row">
                    <span>{row.index}</span>
                    {row.title}
                  </th>
                  {row.cells.map((cell) => (
                    <td data-cell-ids={JSON.stringify(cell.questionIds)}>
                      <span data-cell-progress>0 / {cell.questionIds.length}</span>
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="complete-next" aria-labelledby="next-heading">
      <h2 id="next-heading">下一步</h2>
      <p>判断题练的是判断力；把判断放进连续情境，才形成可交付的产品能力。</p>
      <div class="next-grid">
        <a href="/learn/cases/">
          <span>案例库</span>
          <strong>连续案例</strong>
          <small>同一个业务对象，连续六次评审</small>
        </a>
        <a href="/learn/cases/user-feedback-analysis/">
          <span>黄金项目</span>
          <strong>完整项目</strong>
          <small>每日用户反馈分析与产品改进</small>
        </a>
        <a href="/atlas/">
          <span>知识库</span>
          <strong>查漏补缺</strong>
          <small>按领域查阅词条，补齐判断依据</small>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const page = document.querySelector<HTMLElement>('[data-complete]');

  if (page) {
    const PROGRESS_KEY = 'ai-native.progress';
    const total = Number(page.dataset.total ?? '0');
    const countEl = page.querySelector<HTMLElement>('[data-complete-count]');
    const noteEl = page.querySelector<HTMLElement>('[data-complete-note]');
    const nextEl = page.querySelector<HTMLAnchorElement>('[data-complete-next]');
    const tierRows = [...page.querySelectorAll<HTMLElement>('[data-tier-ids]')];
    const cells = [...page.querySelectorAll<HTMLElement>('[data-cell-ids]')];

    let answered = new Set<string>();
    try {
      const stored = JSON.parse(localStorage.getItem(PROGRESS_KEY) ?? '{"answered":[]}');
      if (Array.isArray(stored.answered)) answered = new Set(stored.answered);
    } catch {
      /* localStorage unavailable; progress is optional */
    }

    const readIds = (element: HTMLElement, attribute: string): string[] => {
      try {
        const parsed = JSON.parse(element.dataset[attribute] ?? '[]');
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    };

    let doneCells = 0;
    cells.forEach((cell) => {
      const ids = readIds(cell, 'cellIds');
      const hit = ids.filter((id) => answered.has(id)).length;
      const label = cell.querySelector<HTMLElement>('[data-cell-progress]');
      if (label) label.textContent = `${hit} / ${ids.length}`;
      if (ids.length > 0 && hit === ids.length) {
        cell.dataset.cellDone = 'true';
        doneCells += 1;
      }
    });

    let doneTiers = 0;
    tierRows.forEach((row) => {
      const ids = readIds(row, 'tierIds');
      const hit = ids.filter((id) => answered.has(id)).length;
      const label = row.querySelector<HTMLElement>('[data-tier-progress]');
      if (label) label.textContent = `${hit} / ${ids.length}`;
      const rail = row.querySelector<HTMLElement>('[data-tier-rail]');
      if (rail)
        rail.style.width = `${ids.length === 0 ? 0 : Math.round((hit / ids.length) * 100)}%`;
      if (ids.length > 0 && hit === ids.length) {
        row.dataset.tierDone = 'true';
        doneTiers += 1;
      }
    });

    const bankIds = readIds(page, 'questionOrder');
    const answeredInBank = bankIds.filter((id) => answered.has(id)).length;

    if (countEl) countEl.textContent = String(answeredInBank);

    if (total > 0 && answeredInBank === total) {
      page.dataset.completeState = 'done';
      if (noteEl) {
        noteEl.textContent = `三层训练已全部完成：${doneTiers} 层结业、${doneCells} 个阶段格子答满。建议进入案例库，把判断放进连续情境。`;
      }
      if (nextEl) {
        nextEl.href = '/learn/cases/';
        nextEl.textContent = '进入连续案例 →';
      }
    }
  }
</script>

<style>
  .complete-page {
    width: min(72rem, calc(100% - 3rem));
    margin-inline: auto;
    padding-bottom: var(--space-7);
  }

  .complete-status {
    display: grid;
    gap: var(--space-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
    padding: 1.6rem 1.5rem;
    margin-bottom: var(--space-5);
  }

  .status-count {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-mono);
  }

  .status-count strong {
    font-size: 2.4rem;
    line-height: 1;
  }

  .status-count span {
    color: var(--color-quiet);
    font-size: var(--text-sm);
  }

  .status-note {
    max-width: 48rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.75;
  }

  .status-action {
    justify-self: start;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: oklch(0.2 0.04 120);
    padding: 0.6rem 1.2rem;
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .complete-tiers,
  .complete-matrix,
  .complete-next {
    margin-bottom: var(--space-5);
  }

  .complete-tiers h2,
  .complete-matrix h2,
  .complete-next h2 {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--weight-display);
    line-height: 1.25;
  }

  .complete-tiers ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .complete-tiers li {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
    padding: var(--space-3);
  }

  .complete-tiers li[data-tier-done='true'] {
    border-color: var(--color-accent);
  }

  .tier-row-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .tier-code {
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    padding: 0.1rem 0.5rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .tier-row-head h3 {
    flex: 1;
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--weight-display);
  }

  .tier-row-head small {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .complete-tiers li > p {
    margin: var(--space-2) 0 var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-xs);
    line-height: 1.7;
  }

  .tier-rail {
    height: 3px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--color-line-soft);
  }

  .tier-rail > span {
    display: block;
    width: 0;
    height: 100%;
    background: var(--color-accent);
  }

  .matrix-note {
    margin: 0 0 var(--space-2);
    color: var(--color-quiet);
    font-size: var(--text-xs);
  }

  .matrix-scroll {
    overflow-x: auto;
  }

  .complete-matrix table {
    width: 100%;
    min-width: 32rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .complete-matrix th,
  .complete-matrix td {
    border: 1px solid var(--color-line-soft);
    padding: var(--space-2);
    text-align: left;
  }

  .complete-matrix thead th {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-body);
    letter-spacing: 0.06em;
  }

  .complete-matrix tbody th {
    font-weight: var(--weight-body);
  }

  .complete-matrix tbody th span {
    margin-right: 0.4rem;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .complete-matrix td span {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .complete-matrix td[data-cell-done='true'] {
    background: var(--color-accent-wash);
  }

  .complete-matrix td[data-cell-done='true'] span {
    color: var(--color-accent);
  }

  .complete-next > p {
    max-width: 48rem;
    margin: 0 0 var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .next-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-3);
  }

  .next-grid a {
    display: grid;
    gap: 0.25rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    text-decoration: none;
  }

  .next-grid a:hover {
    border-color: var(--color-control-border);
    background: var(--color-panel);
  }

  .next-grid span {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .next-grid strong {
    font-size: var(--text-base);
    font-weight: var(--weight-display);
  }

  .next-grid small {
    color: var(--color-quiet);
    font-size: var(--text-xs);
    line-height: 1.7;
  }
</style>
