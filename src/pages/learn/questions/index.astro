---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LEARNING_MODULES, LEARNING_QUESTIONS, getQuestionsForModule } from '@/data/learning';
---

<BaseLayout
  title="AI 产品判断题库"
  description="24 道循序渐进的 AI 产品判断题，通过选择、反馈和判断依据建立 AI 产品能力。"
>
  <main id="main-content" class="bank-page">
    <header class="bank-hero">
      <div>
        <p class="eyebrow">AI product judgment bank</p>
        <h1>24 道题，练成<br />AI 产品判断力。</h1>
      </div>
      <div class="bank-intro">
        <strong>无需填写作业。</strong>
        <p>
          每题阅读一个真实情境，选择你认为合理的决策，立即查看取舍依据。题目从模型边界逐步进入完整上线判断。
        </p>
        <dl>
          <div><dt>阶段</dt><dd>6</dd></div>
          <div><dt>题目</dt><dd>{LEARNING_QUESTIONS.length}</dd></div>
          <div><dt>方式</dt><dd>选择 · 反馈 · 继续</dd></div>
        </dl>
      </div>
    </header>

    <nav class="stage-index" aria-label="题库阶段">
      {
        LEARNING_MODULES.map((module) => (
          <a href={`#stage-${module.index}`}>
            {module.index} {module.title}
          </a>
        ))
      }
    </nav>

    <div class="stage-list">
      {
        LEARNING_MODULES.map((module) => {
          const questions = getQuestionsForModule(module.id);
          return (
            <section id={`stage-${module.index}`} class="stage" data-accent={module.accent}>
              <header>
                <span>{module.index}</span>
                <div>
                  <p class="meta-label">Stage {module.index} · 4 questions</p>
                  <h2>{module.title}</h2>
                  <p>{module.summary}</p>
                </div>
              </header>
              <ol>
                {questions.map((question) => (
                  <li>
                    <a href={`/learn/questions/${question.id}/`}>
                      <span>{question.index}</span>
                      <div>
                        <small>{question.shortTitle}</small>
                        <strong>{question.question}</strong>
                      </div>
                      <i aria-hidden="true">→</i>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          );
        })
      }
    </div>
  </main>
</BaseLayout>

<style>
  .bank-hero {
    min-height: 32rem;
    display: grid;
    grid-template-columns: 0.58fr 0.42fr;
    border-bottom: 1px solid var(--color-line);
  }
  .bank-hero > div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-7) var(--page-gutter);
  }
  .bank-hero > div:first-child {
    border-right: 1px solid var(--color-line);
  }
  .bank-hero h1 {
    max-width: 10em;
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 6.8vw, 7rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0;
  }
  .bank-intro {
    background: var(--color-panel);
  }
  .bank-intro > strong {
    color: var(--color-prerequisite);
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
  }
  .bank-intro > p {
    max-width: 34rem;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }
  .bank-intro dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: var(--space-4) 0 0;
    border-top: 1px solid var(--color-line);
  }
  .bank-intro dl div {
    padding: var(--space-2) var(--space-2) 0 0;
  }
  .bank-intro dt {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .bank-intro dd {
    margin: 0.35rem 0 0;
    color: var(--color-ink);
  }
  .stage-index {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    position: sticky;
    top: var(--header-height);
    z-index: 2;
    background: var(--color-black);
    border-bottom: 1px solid var(--color-line);
  }
  .stage-index a {
    min-height: 3.5rem;
    display: flex;
    align-items: center;
    border-right: 1px solid var(--color-line);
    padding: 0.65rem var(--space-2);
    color: var(--color-muted);
    font-size: var(--text-xs);
    text-decoration: none;
  }
  .stage-index a:hover {
    background: var(--color-panel);
    color: var(--color-ink);
  }
  .stage {
    display: grid;
    grid-template-columns: minmax(18rem, 0.32fr) minmax(0, 0.68fr);
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: calc(var(--header-height) + 3.5rem);
  }
  .stage > header {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-3);
    align-content: start;
    border-right: 1px solid var(--color-line);
    padding: var(--space-6) var(--page-gutter);
  }
  .stage > header > span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
  }
  .stage[data-accent='prerequisite'] > header > span {
    color: var(--color-prerequisite);
  }
  .stage[data-accent='component'] > header > span {
    color: var(--color-component);
  }
  .stage[data-accent='comparison'] > header > span {
    color: var(--color-comparison);
  }
  .stage[data-accent='application'] > header > span {
    color: var(--color-application);
  }
  .stage h2 {
    margin: var(--space-1) 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 2.3rem;
    font-weight: 400;
  }
  .stage header p:last-child {
    max-width: 29rem;
    margin: 0;
    color: var(--color-muted);
  }
  .stage ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stage li {
    border-bottom: 1px solid var(--color-line-soft);
  }
  .stage li:last-child {
    border-bottom: 0;
  }
  .stage li a {
    min-height: 9rem;
    display: grid;
    grid-template-columns: 3rem 1fr 2rem;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--page-gutter);
    color: var(--color-ink);
    text-decoration: none;
  }
  .stage li a:hover {
    background: var(--color-panel);
  }
  .stage li a > span,
  .stage li small {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .stage li strong {
    display: block;
    max-width: 32em;
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.35;
  }
  .stage li i {
    color: var(--color-prerequisite);
    font-style: normal;
  }
  @media (max-width: 900px) {
    .bank-hero,
    .stage {
      grid-template-columns: 1fr;
    }
    .bank-hero > div:first-child,
    .stage > header {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .stage-index {
      grid-template-columns: repeat(3, 1fr);
      position: static;
    }
  }
  @media (max-width: 620px) {
    .bank-hero {
      min-height: auto;
    }
    .bank-hero > div {
      padding-block: var(--space-6);
    }
    .bank-hero h1 {
      font-size: 3.45rem;
    }
    .bank-intro dl {
      grid-template-columns: 1fr;
    }
    .bank-intro dl div {
      border-top: 1px solid var(--color-line-soft);
      padding-block: 0.75rem;
    }
    .stage-index {
      grid-template-columns: 1fr 1fr;
    }
    .stage > header {
      grid-template-columns: 2rem 1fr;
    }
    .stage li a {
      grid-template-columns: 2rem 1fr 1rem;
      min-height: 8rem;
    }
  }
</style>
