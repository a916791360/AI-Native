---
import type { GetStaticPaths } from 'astro';

import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  LEARNING_QUESTIONS,
  getLearningQuestionContext,
  type LearningQuestion,
} from '@/data/learning';

export const getStaticPaths = (() =>
  LEARNING_QUESTIONS.map((question) => ({
    params: { id: question.id },
    props: { question },
  }))) satisfies GetStaticPaths;

const { question } = Astro.props as { question: LearningQuestion };
const context = getLearningQuestionContext(question.id)!;
const { module, moduleQuestions, modulePosition, previous, next, nextModule, isModuleEnd } =
  context;
const continuationHref = next ? `/learn/questions/${next.id}/` : '/learn/';
const continuationKicker =
  nextModule && isModuleEnd
    ? `进入阶段 ${nextModule.index}`
    : next
      ? `继续第 ${next.index} 题`
      : '完成主线';
const continuationTitle =
  nextModule && isModuleEnd ? nextModule.title : next ? next.shortTitle : '回到课程总结';
---

<BaseLayout title={question.question} description={question.scenario}>
  <main id="main-content" class="question-page">
    <section class="course-location" aria-labelledby="course-location-heading">
      <div class="course-location-title">
        <p class="meta-label" id="course-location-heading">课程位置</p>
        <span>阶段 {module.index} / 06</span>
        <strong>{module.title}</strong>
      </div>
      <div class="course-location-progress">
        <div>
          <span>本阶段</span>
          <strong>{modulePosition + 1} / {moduleQuestions.length}</strong>
        </div>
        <ol aria-label={`本阶段第 ${modulePosition + 1} 题，共 ${moduleQuestions.length} 题`}>
          {
            moduleQuestions.map((item, index) => (
              <li aria-current={item.id === question.id ? 'step' : undefined}>
                <span class="visually-hidden">第 {index + 1} 题</span>
              </li>
            ))
          }
        </ol>
        <div>
          <span>全程</span>
          <strong>{question.index} / {String(LEARNING_QUESTIONS.length).padStart(2, '0')}</strong>
        </div>
      </div>
      <a href="/learn/">返回课程目录</a>
    </section>

    <header class="question-head">
      <div class="question-position">
        <p class="eyebrow">Question {question.index}</p>
        <strong
          ><span>{question.index}</span> / {
            String(LEARNING_QUESTIONS.length).padStart(2, '0')
          }</strong
        >
      </div>
      <div class="question-title">
        <p class="meta-label">{question.shortTitle}</p>
        <h1>{question.question}</h1>
      </div>
    </header>

    <section class="question-context" aria-labelledby="scenario-heading">
      <div>
        <p class="meta-label">Scenario</p>
        <h2 id="scenario-heading">情境</h2>
        <p>{question.scenario}</p>
      </div>
      <ol aria-label="已知条件">
        {
          question.facts.map((fact, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              {fact}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="decision" aria-labelledby="decision-heading" data-question>
      <header>
        <p class="eyebrow">Make a judgment</p>
        <h2 id="decision-heading">你会选择哪一种决策？</h2>
        <p>先做选择，再查看这条路径的价值与风险。选择不会被记录。</p>
      </header>
      <div class="option-list" role="group" aria-label="决策选项">
        {
          question.options.map((option, index) => (
            <button
              type="button"
              data-option
              data-assessment={option.assessment}
              data-feedback={option.feedback}
              data-option-label={option.label}
              aria-pressed="false"
            >
              <span>{String.fromCharCode(65 + index)}</span>
              <strong>{option.label}</strong>
              <i aria-hidden="true">选择</i>
            </button>
          ))
        }
      </div>
      <div class="choice-feedback" data-feedback-panel hidden aria-live="polite" tabindex="-1">
        <div>
          <p class="meta-label" data-feedback-kicker>判断反馈</p>
          <h3 data-feedback-title></h3>
        </div>
        <p data-feedback-copy></p>
        <a href={continuationHref} data-next-step>
          <span>{continuationKicker}</span>
          <strong>{continuationTitle}</strong>
          <i aria-hidden="true">→</i>
        </a>
      </div>
    </section>

    <section class="reasoning" aria-labelledby="reasoning-heading">
      <header>
        <p class="eyebrow">Decision logic</p>
        <h2 id="reasoning-heading">不只记答案，记住判断方法</h2>
      </header>
      <div class="principle">
        <p class="meta-label">核心原则</p>
        <blockquote>{question.principle}</blockquote>
      </div>
      <div class="checks">
        <p class="meta-label">下次遇到类似问题，检查</p>
        <ol>
          {
            question.checks.map((check, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                {check}
              </li>
            ))
          }
        </ol>
      </div>
      <nav aria-label="相关知识词条">
        <p class="meta-label">按需深挖</p>
        {
          question.references.map((reference) => (
            <a href={`/terms/${reference.id}/`}>{reference.label}</a>
          ))
        }
      </nav>
    </section>

    <nav class="question-nav" aria-label="题目导航">
      {
        previous ? (
          <a class="previous" href={`/learn/questions/${previous.id}/`}>
            <>
              <span>上一题 · {previous.index}</span>
              <strong>{previous.shortTitle}</strong>
            </>
          </a>
        ) : (
          <a class="previous" href="/learn/questions/">
            <>
              <span>返回</span>
              <strong>题库总览</strong>
            </>
          </a>
        )
      }
      {
        next ? (
          <a class="next" href={`/learn/questions/${next.id}/`}>
            <>
              <span>
                {nextModule && isModuleEnd
                  ? `进入阶段 ${nextModule.index}`
                  : `下一题 · ${next.index}`}
              </span>
              <strong>{nextModule && isModuleEnd ? nextModule.title : next.shortTitle}</strong>
            </>
          </a>
        ) : (
          <a class="next" href="/learn/">
            <>
              <span>完成主线</span>
              <strong>回到课程总结</strong>
            </>
          </a>
        )
      }
    </nav>
  </main>
</BaseLayout>

<script>
  const assessmentCopy = {
    recommended: ['推荐路径', '这条路径最符合当前情境'],
    conditional: ['有条件成立', '这条路径需要补充条件'],
    risky: ['高风险路径', '这条路径忽略了关键约束'],
  };
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-option]')];
  const panel = document.querySelector<HTMLElement>('[data-feedback-panel]');
  const kicker = document.querySelector<HTMLElement>('[data-feedback-kicker]');
  const title = document.querySelector<HTMLElement>('[data-feedback-title]');
  const copy = document.querySelector<HTMLElement>('[data-feedback-copy]');

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const assessment = button.dataset.assessment as keyof typeof assessmentCopy;
      const [label = '', heading = ''] = assessmentCopy[assessment];
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      if (!panel || !kicker || !title || !copy) return;
      panel.dataset.assessment = assessment;
      kicker.textContent = label;
      title.textContent = heading;
      copy.textContent = button.dataset.feedback ?? '';
      panel.hidden = false;
      panel.focus({ preventScroll: true });
    }),
  );
</script>

<style>
  .course-location {
    min-height: 7.5rem;
    display: grid;
    grid-template-columns: minmax(18rem, 0.42fr) minmax(24rem, 0.43fr) auto;
    align-items: stretch;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-black);
  }
  .course-location-title,
  .course-location-progress,
  .course-location > a {
    min-width: 0;
    border-right: 1px solid var(--color-line);
    padding: var(--space-2) var(--page-gutter);
  }
  .course-location-title {
    display: grid;
    grid-template-columns: auto 1fr;
    align-content: center;
    gap: 0.35rem var(--space-2);
  }
  .course-location-title .meta-label {
    grid-column: 1 / -1;
  }
  .course-location-title > span,
  .course-location-progress span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .course-location-title > strong {
    overflow: hidden;
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .course-location-progress {
    display: grid;
    grid-template-columns: auto minmax(8rem, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
  }
  .course-location-progress > div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .course-location-progress strong {
    color: var(--color-ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
  }
  .course-location-progress ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(1rem, 1fr));
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .course-location-progress li {
    height: 3px;
    background: var(--color-line);
  }
  .course-location-progress li[aria-current='step'] {
    background: var(--color-prerequisite);
  }
  .course-location > a {
    min-height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .course-location > a {
    border-right: 0;
  }
  .course-location > a:hover {
    background: var(--color-panel);
    color: var(--color-ink);
  }
  .question-head {
    min-height: 24rem;
    display: grid;
    grid-template-columns: minmax(16rem, 0.28fr) minmax(0, 0.72fr);
    border-bottom: 1px solid var(--color-line);
  }
  .question-position,
  .question-title {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-6) var(--page-gutter);
  }
  .question-position {
    border-right: 1px solid var(--color-line);
    background: var(--color-panel);
  }
  .question-position strong {
    margin-top: var(--space-4);
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
  }
  .question-position strong span {
    color: var(--color-prerequisite);
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
  }
  .question-title h1 {
    max-width: 13em;
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.6vw, 5.7rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: 0;
  }
  .question-context {
    display: grid;
    grid-template-columns: minmax(22rem, 0.55fr) minmax(22rem, 0.45fr);
    border-bottom: 1px solid var(--color-line);
  }
  .question-context > div,
  .question-context > ol {
    margin: 0;
    padding: var(--space-5) var(--page-gutter);
  }
  .question-context > div {
    border-right: 1px solid var(--color-line);
  }
  .question-context h2 {
    margin: var(--space-1) 0;
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 400;
  }
  .question-context > div > p:last-child {
    max-width: 45rem;
    margin-bottom: 0;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }
  .question-context > ol {
    list-style: none;
  }
  .question-context li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    border-top: 1px solid var(--color-line-soft);
    padding: 0.85rem 0;
    color: var(--color-muted);
  }
  .question-context li span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .decision {
    padding: var(--space-7) var(--page-gutter);
    border-bottom: 1px solid var(--color-line);
  }
  .decision > header {
    max-width: 50rem;
    margin-bottom: var(--space-4);
  }
  .decision h2,
  .reasoning h2 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 3.5vw, 3.6rem);
    font-weight: 400;
  }
  .decision > header > p:last-child {
    margin: 0;
    color: var(--color-muted);
  }
  .option-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--color-line);
  }
  .option-list button {
    min-height: 13rem;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    grid-template-rows: 1fr auto;
    gap: var(--space-2);
    border: 0;
    border-right: 1px solid var(--color-line);
    background: transparent;
    padding: var(--space-4);
    color: var(--color-ink);
    cursor: pointer;
    text-align: left;
  }
  .option-list button:last-child {
    border-right: 0;
  }
  .option-list button:hover,
  .option-list button[aria-pressed='true'] {
    background: var(--color-panel);
  }
  .option-list button[aria-pressed='true'] {
    box-shadow: inset 0 -3px var(--color-prerequisite);
  }
  .option-list button > span {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
  }
  .option-list button strong {
    align-self: start;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    line-height: 1.45;
  }
  .option-list button i {
    grid-column: 2;
    align-self: end;
    color: var(--color-quiet);
    font-size: var(--text-xs);
    font-style: normal;
  }
  .choice-feedback {
    display: grid;
    grid-template-columns: minmax(14rem, 0.25fr) minmax(18rem, 0.5fr) minmax(13rem, 0.25fr);
    margin-top: var(--space-3);
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    outline: none;
  }
  .choice-feedback > div,
  .choice-feedback > p,
  .choice-feedback > a {
    margin: 0;
    padding: var(--space-4);
  }
  .choice-feedback > div,
  .choice-feedback > p {
    border-right: 1px solid var(--color-line);
  }
  .choice-feedback h3 {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
  }
  .choice-feedback > p {
    align-self: center;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }
  .choice-feedback > a {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--color-ink);
    text-decoration: none;
  }
  .choice-feedback > a:hover {
    background: var(--color-black);
  }
  .choice-feedback > a span {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .choice-feedback > a strong {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
  }
  .choice-feedback > a i {
    align-self: flex-end;
    margin-top: var(--space-2);
    color: var(--color-prerequisite);
    font-style: normal;
  }
  .choice-feedback[data-assessment='recommended'] .meta-label {
    color: var(--color-prerequisite);
  }
  .choice-feedback[data-assessment='conditional'] .meta-label {
    color: var(--color-comparison);
  }
  .choice-feedback[data-assessment='risky'] .meta-label {
    color: var(--color-application);
  }
  .reasoning {
    display: grid;
    grid-template-columns: 0.3fr 0.32fr 0.38fr;
    border-bottom: 1px solid var(--color-line);
  }
  .reasoning > * {
    min-width: 0;
    border-right: 1px solid var(--color-line);
    padding: var(--space-6) var(--page-gutter);
  }
  .reasoning > *:last-child {
    border-right: 0;
  }
  .reasoning blockquote {
    margin: var(--space-3) 0 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1.45;
  }
  .checks ol {
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .checks li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    border-top: 1px solid var(--color-line-soft);
    padding: 0.7rem 0;
    color: var(--color-muted);
  }
  .checks li span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .reasoning nav a {
    min-height: 3rem;
    display: flex;
    align-items: center;
    border-bottom: 1px solid var(--color-line-soft);
    color: var(--color-muted);
    text-decoration: none;
  }
  .reasoning nav a:hover {
    color: var(--color-ink);
  }
  .question-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .question-nav a {
    min-height: 10rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-4) var(--page-gutter);
    color: var(--color-ink);
    text-decoration: none;
  }
  .question-nav a:first-child {
    border-right: 1px solid var(--color-line);
  }
  .question-nav a:hover {
    background: var(--color-panel);
  }
  .question-nav .next {
    text-align: right;
  }
  .question-nav span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .question-nav strong {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 400;
  }
  @media (max-width: 900px) {
    .course-location {
      grid-template-columns: 1fr 1fr;
    }
    .course-location-progress {
      border-right: 0;
    }
    .course-location > a {
      grid-column: 1 / -1;
      border-top: 1px solid var(--color-line);
    }
    .reasoning {
      grid-template-columns: 1fr 1fr;
    }
    .reasoning > header {
      grid-column: 1 / -1;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .option-list {
      grid-template-columns: 1fr;
    }
    .option-list button {
      min-height: 8rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .option-list button:last-child {
      border-bottom: 0;
    }
  }
  @media (max-width: 700px) {
    .question-head,
    .question-context,
    .choice-feedback,
    .reasoning {
      grid-template-columns: 1fr;
    }
    .question-position,
    .question-context > div,
    .choice-feedback > div,
    .choice-feedback > p,
    .reasoning > * {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .question-position {
      min-height: 10rem;
    }
    .question-position strong {
      margin-top: var(--space-2);
    }
    .question-position strong span {
      font-size: 3.5rem;
    }
    .question-title h1 {
      font-size: 3rem;
    }
    .decision {
      padding-block: var(--space-6);
    }
    .question-nav a {
      min-height: 8rem;
    }
  }
  @media (max-width: 520px) {
    .course-location {
      grid-template-columns: 1fr;
    }
    .course-location-title,
    .course-location-progress {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .course-location > a {
      grid-column: auto;
      border-top: 0;
    }
  }
</style>
