---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { resolveTermChainPosition } from '@/lib/content/chain';
import { loadProjectContent } from '@/lib/content/io';
import {
  LEARNING_QUESTIONS,
  PM_ACTIONS,
  getLearningQuestionContext,
  getQuestionsForTier,
  type LearningQuestion,
} from '@/data/learning';

export const getStaticPaths = (async () => {
  const [terms, project] = await Promise.all([getCollection('terms'), loadProjectContent()]);
  const termSummaries: Record<string, string> = Object.fromEntries(
    terms.map((term) => [term.data.id, term.data.summary]),
  );
  const chainByTermId = Object.fromEntries(
    terms.flatMap((term) => {
      const position = resolveTermChainPosition(term.data, project.chain);
      return position
        ? [
            [
              term.data.id,
              {
                order: position.order,
                nameZh: position.station.nameZh,
              },
            ] as const,
          ]
        : [];
    }),
  );
  const termIdsByQuestionId = Object.fromEntries(
    LEARNING_QUESTIONS.map((question) => [
      question.id,
      question.references.map((reference) => reference.id),
    ]),
  );
  return LEARNING_QUESTIONS.map((question) => ({
    params: { id: question.id },
    props: {
      question,
      termSummaries,
      chainByTermId,
      referencedTermIds: termIdsByQuestionId[question.id] ?? [],
    },
  }));
}) satisfies GetStaticPaths;

const { question, termSummaries, chainByTermId, referencedTermIds } = Astro.props as {
  question: LearningQuestion;
  termSummaries: Record<string, string>;
  chainByTermId: Record<string, { order: number; nameZh: string }>;
  referencedTermIds: string[];
};

const referencedStations = Array.from(
  new Map(
    referencedTermIds.flatMap((termId) => {
      const station = chainByTermId[termId];
      return station ? [[station.order, station] as const] : [];
    }),
  ).values(),
).sort((left, right) => left.order - right.order);

const context = getLearningQuestionContext(question.id)!;
const {
  tier,
  module,
  moduleQuestions,
  modulePosition,
  tierPosition,
  previous,
  next,
  nextModule,
  nextTier,
  isModuleEnd,
} = context;

const assessmentCopy = {
  recommended: ['推荐路径', '这条路径最符合当前情境'],
  conditional: ['有条件成立', '这条路径需要补充条件'],
  risky: ['高风险路径', '这条路径忽略了关键约束'],
} as const;

const total = LEARNING_QUESTIONS.length;
const tierTotal = getQuestionsForTier(tier.id).length;
const overallPosition = Number(question.index);
const progressPercent = Math.round((overallPosition / total) * 100);

const continuationHref = next ? `/learn/questions/${next.id}/` : '/learn/complete/';
const continuationKicker = nextTier
  ? `进入 ${nextTier.code} ${nextTier.title}`
  : nextModule && isModuleEnd
    ? `进入阶段 ${nextModule.index}`
    : next
      ? `继续第 ${next.index} 题`
      : '三层训练完成';
const continuationTitle = nextTier
  ? nextTier.prompt
  : nextModule && isModuleEnd
    ? nextModule.title
    : next
      ? next.shortTitle
      : '回到学习中心';

const pmAction = PM_ACTIONS[question.id];
// 学习库 → 某层 → 某阶段 → 某题。中间两层都指向 /learn/ 的锚点，
// 点击时侧栏与主区会自动展开对应层（LearningCatalog 里的 openFor）。
const breadcrumbTrail = [
  { label: '开始学习', href: '/learn/' },
  { label: `${tier.code} ${tier.title}`, href: `/learn/#tier-${tier.code}` },
  { label: `阶段 ${module.index}`, href: `/learn/#module-${tier.code}-${module.index}` },
  { label: question.shortTitle },
];
---

<BaseLayout title={question.question} description={question.scenario}>
  <main
    id="main-content"
    class="question-page"
    data-question-page
    data-question-id={question.id}
    data-answer-count={question.options.length}
    data-next-href={continuationHref}
  >
    <div class="question-breadcrumbs">
      <Breadcrumbs trail={breadcrumbTrail} />
    </div>

    <section class="progress" aria-label="学习进度">
      <div class="shell progress-inner">
        <p class="progress-tier">
          <span class="tier-chip">{tier.code}</span>
          <strong>{tier.title}</strong>
          <span class="progress-module">阶段 {module.index} · {module.title}</span>
        </p>
        <div class="progress-rail">
          <span style={`width: ${progressPercent}%`}></span>
        </div>
        <p class="progress-stats">
          <span class="progress-position">
            {question.index}
            <i>/ {total}</i>
          </span>
          <span data-progress-answered>已答 0 / {total}</span>
          <span data-progress-missed>错 0</span>
        </p>
        {
          referencedStations.length > 0 && (
            <p class="question-chain" aria-label="本题认知链路定位">
              <span>认知链路</span>
              {referencedStations.map((station, index) => (
                <span class="question-chain-station">
                  {index > 0 && <i aria-hidden="true">·</i>}
                  <a href={`/map/#station-${station.order}`}>
                    第 {station.order} 站 · {station.nameZh}
                  </a>
                </span>
              ))}
            </p>
          )
        }
      </div>
    </section>

    <article class="sheet">
      <header class="q-head" data-reveal>
        <p class="meta-label">
          {tier.code} · 第 {tierPosition + 1} / {tierTotal} 题 · 阶段 {module.index} 第 {
            modulePosition + 1
          } / {moduleQuestions.length} 题
        </p>
        <h1>{question.question}</h1>
      </header>

      <section class="scenario" aria-labelledby="scenario-heading" data-reveal>
        <div class="scenario-copy">
          <p class="meta-label">情境</p>
          <p id="scenario-heading">{question.scenario}</p>
        </div>
        <ol class="facts" aria-label="已知条件">
          {
            question.facts.map((fact, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                {fact}
              </li>
            ))
          }
        </ol>
      </section>

      <section class="decision" aria-labelledby="decision-heading" data-reveal>
        <header class="decision-head">
          <h2 id="decision-heading">你会选择哪一种决策？</h2>
          <p class="decision-hint">
            先做选择，再展开每条路径的判断。键盘按 <kbd>1</kbd>–<kbd>{question.options.length}</kbd> 作答。
          </p>
        </header>

        <ol class="option-list" data-option-list>
          {
            question.options.map((option, index) => (
              <li data-option-item data-assessment={option.assessment}>
                <button type="button" data-option aria-pressed="false">
                  <span class="option-key" aria-hidden="true">
                    {String.fromCharCode(65 + index)}
                  </span>
                  <span class="option-label">{option.label}</span>
                  <span class="option-marker" data-option-marker>
                    你的选择
                  </span>
                </button>
                <details class="option-feedback" data-option-feedback>
                  <summary>查看这条路径的判断</summary>
                  <p class="option-verdict">{assessmentCopy[option.assessment][0]}</p>
                  <p class="option-why">{option.feedback}</p>
                </details>
              </li>
            ))
          }
        </ol>
        <p class="screen-reader-only" aria-live="polite" data-announce></p>
      </section>

      <section class="reasoning" aria-labelledby="reasoning-heading" data-reveal>
        <header class="reasoning-head">
          <h2 id="reasoning-heading">不只记答案，记住判断方法</h2>
        </header>
        {/* 标记为 open 是为了让禁用 JS 的读者直接读到原则；脚本会在启用 JS 时收起，答完再展开。 */}
        <details class="principle" data-principle open>
          <summary>
            <span class="meta-label">核心原则</span>
            <i>答完后展开</i>
          </summary>
          <blockquote>{question.principle}</blockquote>
        </details>
        <div class="checks">
          <p class="meta-label">下次遇到类似问题，检查</p>
          <ol>
            {
              question.checks.map((check, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  {check}
                </li>
              ))
            }
          </ol>
        </div>
        <nav class="refs" aria-label="相关知识库条目">
          <p class="meta-label">按需深挖 · 读完再回题</p>
          {
            question.references.map((reference) => (
              <a href={`/terms/${reference.id}/`}>
                <strong>{reference.label}</strong>
                <span>{termSummaries[reference.id]}</span>
                <small>读全文 →</small>
              </a>
            ))
          }
        </nav>
      </section>

      {
        pmAction && (
          <section class="pm-action" aria-labelledby="pm-action-heading" data-reveal>
            <p class="eyebrow">PM 落地</p>
            <h2 id="pm-action-heading">如果你是产品经理，下一步做什么</h2>
            <p>{pmAction}</p>
          </section>
        )
      }

      <nav class="question-nav" aria-label="题目导航">
        {
          previous ? (
            <a class="previous" href={`/learn/questions/${previous.id}/`}>
              <span>上一题 · {previous.index}</span>
              <strong>{previous.shortTitle}</strong>
            </a>
          ) : (
            <a class="previous" href="/learn/">
              <span>返回</span>
              <strong>学习中心</strong>
            </a>
          )
        }
        <a class="next" href={continuationHref} data-next-step>
          <span>{continuationKicker}</span>
          <strong>{continuationTitle}</strong>
          <i aria-hidden="true">→</i>
        </a>
      </nav>
    </article>
  </main>
</BaseLayout>

<script>
  const PROGRESS_KEY = 'ai-native.progress';
  const page = document.querySelector<HTMLElement>('[data-question-page]');

  if (page) {
    const questionId = page.dataset.questionId ?? '';
    const answerCount = Number(page.dataset.answerCount ?? '0');
    const nextHref = page.dataset.nextHref ?? '';
    const total = document.querySelectorAll('[data-progress-answered]').length
      ? Number(
          document
            .querySelector<HTMLElement>('[data-progress-answered]')
            ?.textContent?.split('/')[1] ?? '0',
        )
      : 0;
    const items = [...page.querySelectorAll<HTMLElement>('[data-option-item]')];
    const answeredLabel = page.querySelector<HTMLElement>('[data-progress-answered]');
    const missedLabel = page.querySelector<HTMLElement>('[data-progress-missed]');
    const announce = page.querySelector<HTMLElement>('[data-announce]');
    const principle = page.querySelector<HTMLDetailsElement>('[data-principle]');

    interface Progress {
      answered: string[];
      missed: string[];
      choices: Record<string, number>;
      lastVisited: string | null;
    }

    const readProgress = (): Progress => {
      try {
        const stored = JSON.parse(localStorage.getItem(PROGRESS_KEY) ?? '{}');
        return {
          answered: Array.isArray(stored.answered) ? stored.answered : [],
          missed: Array.isArray(stored.missed) ? stored.missed : [],
          choices:
            stored.choices && typeof stored.choices === 'object' && !Array.isArray(stored.choices)
              ? stored.choices
              : {},
          lastVisited: typeof stored.lastVisited === 'string' ? stored.lastVisited : null,
        };
      } catch {
        return { answered: [], missed: [], choices: {}, lastVisited: null };
      }
    };

    const renderStats = (progress: Progress) => {
      if (answeredLabel) {
        answeredLabel.textContent = `已答 ${progress.answered.length} / ${total}`;
      }
      if (missedLabel) {
        missedLabel.textContent = `错 ${progress.missed.length}`;
      }
    };

    let progress = readProgress();
    renderStats(progress);

    /** 把「已选哪一条」的视觉与展开状态应用到页面上。 */
    const applyChoice = (index: number) => {
      items.forEach((other, otherIndex) => {
        other.dataset.state = otherIndex === index ? 'chosen' : 'other';
        other
          .querySelector('[data-option]')
          ?.setAttribute('aria-pressed', String(otherIndex === index));
        const details = other.querySelector<HTMLDetailsElement>('[data-option-feedback]');
        if (details) details.open = true;
      });
      page.dataset.answered = 'true';
      if (principle) principle.open = true;
    };

    const answer = (index: number) => {
      const item = items[index];
      if (!item || page.dataset.answered === 'true') return;

      applyChoice(index);

      const correct = item.dataset.assessment === 'recommended';
      progress = readProgress();
      progress = {
        answered: progress.answered.includes(questionId)
          ? progress.answered
          : [...progress.answered, questionId],
        missed: correct
          ? progress.missed.filter((id) => id !== questionId)
          : progress.missed.includes(questionId)
            ? progress.missed
            : [...progress.missed, questionId],
        choices: { ...progress.choices, [questionId]: index },
        lastVisited: questionId,
      };
      try {
        localStorage.setItem(PROGRESS_KEY, JSON.stringify(progress));
      } catch {
        /* localStorage unavailable; progress is optional */
      }
      renderStats(progress);

      if (announce) {
        announce.textContent = correct
          ? '选择正确。已展开全部路径的判断依据。'
          : '这条路径不是推荐选项。已展开全部路径的判断依据，可对照查看。';
      }
      page.querySelector<HTMLElement>('[data-next-step]')?.focus({ preventScroll: true });
    };

    // 重访已答过的题：恢复上次的选择与全部判断依据，方便复习；不重复播报。
    const previousChoice = progress.choices[questionId];
    if (progress.answered.includes(questionId) && typeof previousChoice === 'number') {
      if (items[previousChoice]) applyChoice(previousChoice);
      else if (principle) principle.open = true;
    } else if (principle) {
      principle.open = false;
    }

    items.forEach((item, index) => {
      item.querySelector('[data-option]')?.addEventListener('click', () => answer(index));
    });

    document.addEventListener('keydown', (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey) return;
      const target = event.target;
      if (target instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;

      const digit = Number(event.key);
      if (Number.isInteger(digit) && digit >= 1 && digit <= answerCount) {
        event.preventDefault();
        answer(digit - 1);
        return;
      }
      if (event.key === 'ArrowRight' && page.dataset.answered === 'true' && nextHref) {
        event.preventDefault();
        window.location.assign(nextHref);
      }
    });
  }
</script>

<style>
  /* Hallmark · genre: editorial · macrostructure: Narrative Workflow · design-system: design.md
   * designed-as-app · 答题页：单列选项 + 就地反馈，正文级字号，无整体外框
   */
  .progress {
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in oklch, var(--color-black) 88%, var(--color-panel));
  }
  /* 与 .sheet 同宽，否则进度条内容会比题面更靠左。 */
  .progress-inner {
    width: min(100%, var(--content-standard));
    margin-inline: auto;
    display: grid;
    grid-template-columns: auto minmax(6rem, 1fr) auto;
    gap: var(--space-3) var(--space-4);
    align-items: center;
    padding: var(--space-2) var(--page-gutter);
  }
  .progress-tier {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    font-size: var(--text-sm);
  }
  .tier-chip {
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-pill);
    padding: 0.1rem 0.5rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }
  .progress-tier strong {
    color: var(--color-ink);
    font-weight: var(--weight-display);
    white-space: nowrap;
  }
  .progress-module {
    overflow: hidden;
    color: var(--color-quiet);
    font-size: var(--text-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .progress-rail {
    position: relative;
    height: 3px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--color-line-soft);
  }
  .progress-rail > span {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }
  .progress-stats {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }
  .progress-position {
    color: var(--color-ink);
  }
  .progress-position i {
    color: var(--color-quiet);
    font-style: normal;
  }

  .sheet {
    width: min(100%, var(--content-standard));
    margin-inline: auto;
    padding: var(--space-6) var(--page-gutter) var(--space-7);
  }
  .question-page {
    padding-bottom: var(--space-6);
  }
  /* 与 .progress-inner / .sheet 同宽同内边距，否则面包屑会比题面更靠左。 */
  .question-breadcrumbs {
    width: min(100%, var(--content-standard));
    margin: var(--space-3) auto var(--space-2);
    padding-inline: var(--page-gutter);
  }

  .q-head {
    max-width: var(--reading-max);
  }
  .q-head .meta-label {
    color: var(--color-quiet);
  }
  .q-head h1 {
    margin: var(--space-2) 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: var(--weight-display);
    line-height: 1.18;
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .scenario {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line-soft);
  }
  .scenario-copy {
    max-width: var(--reading-max);
  }
  .scenario-copy .meta-label {
    color: var(--color-quiet);
  }
  .scenario-copy p:last-child {
    margin: var(--space-1) 0 0;
    color: var(--color-ink);
    font-size: var(--text-lead);
    line-height: 1.8;
    text-wrap: pretty;
  }
  /* 已知条件用竖线做条目语言，和上方的段落分开；字号提到正文级，
     否则右栏会读成注释、左栏留出大片空白。 */
  .facts {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .facts li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-2);
    border-left: 2px solid var(--color-line);
    padding: 0.35rem 0 0.35rem var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-base);
    line-height: 1.7;
  }
  .facts li > span {
    color: var(--color-accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .decision {
    margin-top: var(--space-6);
  }
  .decision-head h2,
  .reasoning-head h2,
  .pm-action h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--weight-display);
    line-height: 1.25;
    letter-spacing: var(--tracking-display);
  }
  .decision-hint {
    margin: var(--space-1) 0 0;
    color: var(--color-quiet);
    font-size: var(--text-sm);
  }
  kbd {
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-sm);
    padding: 0.05rem 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  /* 选项是一条一条读的，不是并排比较的——所以永远单列。
     3–4 个选项排成多列时，中文标签会被压成 3 行、反馈被压成 6 行小字，
     而反馈恰恰是这一页最需要读的内容。 */
  .option-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  [data-option-item] {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-panel);
    overflow: hidden;
  }
  [data-option-item] button {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--space-3);
    align-items: center;
    width: 100%;
    border: 0;
    background: none;
    padding: var(--space-3) var(--space-4);
    text-align: left;
  }
  [data-option-item] button:hover {
    background: var(--color-panel-raised);
  }
  .option-key {
    display: grid;
    place-items: center;
    width: var(--control-size-sm);
    height: var(--control-size-sm);
    border: 1px solid var(--color-control-border);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .option-label {
    max-width: var(--reading-max);
    font-size: var(--text-lead);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .option-marker {
    display: none;
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  [data-option-item][data-state='chosen'] {
    border-color: var(--color-accent);
    background: var(--color-accent-wash);
  }
  [data-option-item][data-state='chosen'] .option-key {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  [data-option-item][data-state='chosen'] .option-marker {
    display: inline;
  }
  [data-option-item][data-state='other'] button {
    color: var(--color-muted);
  }

  /* 反馈缩进到与选项标签左对齐，读起来是「这一条的说明」，不是另起一段。 */
  .option-feedback {
    border-top: 1px solid var(--color-line-soft);
    padding: 0 var(--space-4) var(--space-3)
