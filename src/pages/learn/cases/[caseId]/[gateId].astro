---
import type { GetStaticPaths } from 'astro';

import CaseGateDesk from '@/components/cases/CaseGateDesk.astro';
import CasePrdExporter from '@/components/cases/CasePrdExporter.astro';
import CaseStageDirectory from '@/components/cases/CaseStageDirectory.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TermPopover from '@/components/ui/TermPopover.astro';
import { loadCaseStudies } from '@/lib/cases/io';
import type { CaseStudy } from '@/lib/cases/schema';
import { CASE_STAGE_LABELS, caseHref, gateHref, getGateContext } from '@/lib/cases/presentation';
import '@/styles/case-study.css';

export const getStaticPaths = (async () => {
  const cases = await loadCaseStudies();
  return cases.flatMap(({ data }) =>
    data.gates.map((gate) => ({
      params: { caseId: data.id, gateId: gate.id },
      props: { caseStudy: data, gateId: gate.id },
    })),
  );
}) satisfies GetStaticPaths;

const { caseStudy, gateId } = Astro.props as { caseStudy: CaseStudy; gateId: string };
const context = getGateContext(caseStudy, gateId)!;
const { gate, previous, next, resources, accumulatedArtifacts } = context;
const formedArtifactIds = new Set(accumulatedArtifacts.map(({ id }) => id));
// 案例库 → 案例 → 关卡。「案例位置」条已经报了 Gate 03/06 与返回项目档案，
// 但它没有可点回案例库的路径——面包屑补的正是这一段上行。
const breadcrumbTrail = [
  { label: '案例库', href: '/learn/cases/' },
  { label: caseStudy.title, href: caseHref(caseStudy.id) },
  { label: `Gate ${String(gate.order).padStart(2, '0')} · ${gate.title}` },
];
---

<BaseLayout title={`${gate.title} · ${caseStudy.title}`} description={gate.question}>
  <main id="main-content" class="case-shell">
    <div class="case-breadcrumbs">
      <Breadcrumbs trail={breadcrumbTrail} />
    </div>

    <section class="case-location" aria-label="案例位置">
      <div class="location-case-info">
        <span class="location-label">连续案例</span>
        <strong class="location-case-title">{caseStudy.title}</strong>
      </div>
      <div class="location-stage-stepper">
        <span class="location-gate-text">Gate {String(gate.order).padStart(2, '0')} / 06</span>
        <ol class="gate-mini-dots" aria-label="关卡进度导航">
          {
            caseStudy.gates.map((g) => (
              <li class="gate-mini-dot" data-active={g.id === gate.id ? 'true' : undefined}>
                <a href={gateHref(caseStudy.id, g.id)} title={`Gate 0${g.order} · ${g.title}`}>
                  <span>G0{g.order}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <small class="location-note">项目阶段 · 不记录完成状态</small>
      </div>
      <div class="location-actions">
        <button type="button" class="location-prd-preview-btn" data-open-prd-modal>
          <span>📑 预览 PRD</span>
        </button>
        <a href={caseHref(caseStudy.id)} class="location-back-link">返回项目档案</a>
      </div>
    </section>

    <header class="gate-heading">
      <div class="gate-number">
        <p class="meta-label">Gate</p>
        <strong>{String(gate.order).padStart(2, '0')}</strong>
      </div>
      <div class="gate-title">
        <div class="gate-stage-tag-row">
          <span class="gate-stage-pill">{CASE_STAGE_LABELS[gate.stageId]}</span>
          <span class="gate-order-tag">Stage 0{gate.order} of 06</span>
        </div>
        <h1>{gate.title}</h1>
        <div class="gate-challenge-box">
          <span class="challenge-tag">PM 核心决策题</span>
          <p>{gate.question}</p>
        </div>
      </div>
    </header>

    <div class="gate-artifact-trail" aria-label="材料演进">
      <div class="trail-label">
        <span class="trail-kicker">项目材料逐步形成</span>
        <small>各关卡决策对应 PRD 章节</small>
      </div>
      <ol class="trail-pipeline">
        {
          caseStudy.artifacts.map((artifact, idx) => (
            <li
              class="trail-step"
              data-formed={formedArtifactIds.has(artifact.id) ? 'true' : undefined}
            >
              <span class="trail-step-num">0{idx + 1}</span>
              <span class="trail-step-title">{artifact.title}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <CaseGateDesk caseStudy={caseStudy} gate={gate} resources={resources} />

    {
      gate.order === 6 ? (
        <section class="gate-capstone-export" aria-labelledby="capstone-export-heading">
          <div class="capstone-export-body">
            <div class="capstone-badge">
              <span class="badge-icon">🎯</span>
              <span>六阶段推演成果闭环</span>
            </div>
            <h3 id="capstone-export-heading">已完成全部 6 关！组装你的《AI 产品立项 PRD》</h3>
            <p>
              将你在各关卡中确定的决策方案、前置成立条件核验以及风险规避动作，一键组装为大厂评审级专业
              Markdown 文档。
            </p>
          </div>
          <button type="button" class="capstone-export-btn" data-open-prd-modal>
            <span>📑 组装并导出我的 PRD →</span>
          </button>
        </section>
      ) : (
        <div class="archive-export-banner" style="margin: var(--space-4) var(--page-gutter) 0;">
          <p>
            <strong>PRD 随阶段生成中：</strong>当前处于 Gate 0{gate.order}
            。你可以随时预览或导出当前已沉淀的立项 PRD（未做选择的关卡自动按推荐基准填充）。
          </p>
          <button type="button" class="archive-export-btn" data-open-prd-modal>
            <span>📑 预览立项 PRD 草稿</span>
          </button>
        </div>
      )
    }

    <nav class="case-navigation" aria-label="案例关卡导航">
      <a href={previous ? gateHref(caseStudy.id, previous.id) : caseHref(caseStudy.id)}>
        <span>{previous ? `上一关 · Gate ${String(previous.order).padStart(2, '0')}` : '返回'}</span
        >
        <strong>{previous?.title ?? '项目档案与六关目录'}</strong>
      </a>
      <a
        href={next ? gateHref(caseStudy.id, next.id) : `${caseHref(caseStudy.id)}#project-archive`}
      >
        <span>{next ? `继续 · Gate ${String(next.order).padStart(2, '0')}` : '六关结束'}</span>
        <strong>{next?.title ?? '查看完整项目档案'}</strong>
      </a>
    </nav>

    <CaseStageDirectory caseStudy={caseStudy} currentGateId={gate.id} />
  </main>
  <CasePrdExporter caseStudy={caseStudy} />
  <TermPopover />
</BaseLayout>
