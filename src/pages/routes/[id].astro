---
import type { GetStaticPaths } from 'astro';

import StatusTag from '@/components/ui/StatusTag.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadProjectContent } from '@/lib/content/io';

export const getStaticPaths = (async () => {
  const { routes, terms } = await loadProjectContent();
  const termNames = Object.fromEntries(terms.map(({ data }) => [data.id, data.nameZh]));
  return routes.map(({ data }) => ({ params: { id: data.id }, props: { route: data, termNames } }));
}) satisfies GetStaticPaths;

const { route, termNames } = Astro.props;
const routeTerms = route.chapters.flatMap((chapter: { terms: { id: string }[] }) => chapter.terms);
const firstTerm = routeTerms[0];
---

<BaseLayout title={route.nameZh} description={route.summary}>
  <main id="main-content">
    <header class="route-hero">
      <div>
        <p class="eyebrow">
          Learning route {String(route.order).padStart(2, '0')} · {
            route.status === 'published' ? '已发布' : '草稿'
          }
        </p>
        <h1>{route.nameZh}</h1>
      </div>
      <div class="route-summary">
        <StatusTag status={route.status} />
        <p>{route.summary}</p>
        <dl>
          <div><dt>章节</dt><dd>{route.chapters.length}</dd></div><div>
            <dt>代表词条</dt><dd>{route.estimatedTerms}</dd>
          </div>
        </dl>
        {
          firstTerm && (
            <a class="route-start" href={`/terms/${firstTerm.id}/`}>
              从第一篇开始阅读
            </a>
          )
        }
      </div>
    </header>
    <div class="route-body">
      <aside>
        <section>
          <p class="meta-label">适合谁</p>
          <ul>{route.audience.map((item: string) => <li>{item}</li>)}</ul>
        </section>
        <section>
          <p class="meta-label">学习目标</p>
          <ul>{route.learningGoals.map((goal: string) => <li>{goal}</li>)}</ul>
        </section>
        <section>
          <p class="meta-label">完成后</p>
          <ul>{route.outcomes.map((outcome: string) => <li>{outcome}</li>)}</ul>
        </section>
      </aside>
      <ol class="route-chapters">
        {
          route.chapters.map(
            (
              chapter: { id: string; title: string; transition: string; terms: { id: string }[] },
              index: number,
            ) => (
              <li id={chapter.id}>
                <span class="chapter-number">0{index + 1}</span>
                <div>
                  <h2>{chapter.title}</h2>
                  <p>{chapter.transition}</p>
                  <ol class="chapter-terms">
                    {chapter.terms.map((term) => (
                      <li>
                        <span>
                          {String(
                            routeTerms.findIndex((step: { id: string }) => step.id === term.id) + 1,
                          ).padStart(2, '0')}
                        </span>
                        <a href={`/terms/${term.id}/`}>{termNames[term.id] ?? term.id}</a>
                      </li>
                    ))}
                  </ol>
                </div>
              </li>
            ),
          )
        }
      </ol>
    </div>
  </main>
</BaseLayout>

<style>
  .route-hero {
    min-height: 34rem;
    display: grid;
    grid-template-columns: minmax(24rem, 1fr) minmax(20rem, 0.45fr);
    border-bottom: 1px solid var(--color-line);
  }
  .route-hero > div {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-7) var(--page-gutter);
  }
  .route-hero > div:first-child {
    border-right: 1px solid var(--color-line);
  }
  .route-hero h1 {
    max-width: 11em;
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 7vw, 6.8rem);
    font-weight: 400;
    line-height: 0.98;
  }
  .route-summary {
    align-items: flex-start;
  }
  .route-summary > p {
    margin: var(--space-4) 0;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }
  .route-start {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: var(--space-4);
    border: 1px solid var(--color-prerequisite);
    padding: 0 var(--space-3);
    color: var(--color-prerequisite);
    text-decoration: none;
  }
  .route-start:hover {
    background: var(--color-prerequisite);
    color: var(--color-black);
  }
  dl {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: var(--space-4) 0 0;
    border-top: 1px solid var(--color-line);
  }
  dl div {
    padding-top: var(--space-3);
  }
  dt {
    color: var(--color-quiet);
    font-size: var(--text-xs);
  }
  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2rem;
  }
  .route-body {
    display: grid;
    grid-template-columns: minmax(16rem, 0.28fr) minmax(0, 1fr);
  }
  .route-body > aside {
    border-right: 1px solid var(--color-line);
    padding: var(--space-6) var(--page-gutter);
  }
  .route-body aside ul {
    margin: var(--space-4) 0 0;
    padding-left: 1.2rem;
    color: var(--color-muted);
  }
  .route-body aside section + section {
    margin-top: var(--space-5);
    border-top: 1px solid var(--color-line-soft);
    padding-top: var(--space-4);
  }
  .route-chapters {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .route-chapters > li {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-6) var(--page-gutter);
  }
  .chapter-number {
    color: var(--color-prerequisite);
    font-family: var(--font-display);
    font-size: 2.8rem;
  }
  .route-chapters h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 400;
  }
  .route-chapters p {
    max-width: 43rem;
    margin: var(--space-2) 0 var(--space-4);
    color: var(--color-muted);
  }
  .chapter-terms {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chapter-terms li {
    min-height: 3.5rem;
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: center;
    border-top: 1px solid var(--color-line-soft);
  }
  .chapter-terms span {
    color: var(--color-quiet);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  @media (max-width: 760px) {
    .route-hero,
    .route-body {
      grid-template-columns: 1fr;
    }
    .route-hero > div:first-child,
    .route-body > aside {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .route-chapters > li {
      grid-template-columns: 3rem minmax(0, 1fr);
    }
    .chapter-number {
      font-size: 2rem;
    }
    .chapter-terms {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .route-start {
      display: none;
    }
    .route-hero {
      min-height: 0;
    }
  }
</style>
