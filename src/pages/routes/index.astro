---
import PageIntro from '@/components/layout/PageIntro.astro';
import StatusTag from '@/components/ui/StatusTag.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadProjectContent } from '@/lib/content/io';
import { deriveSiteMetrics } from '@/lib/site/metrics';

const project = await loadProjectContent();
const metrics = deriveSiteMetrics(project);
const routes = project.routes
  .map(({ data }) => data)
  .sort((left, right) => left.order - right.order);
---

<BaseLayout title="学习路线" description="沿四条有顺序的词条路线系统学习 AI。">
  <main id="main-content" class="routes-page">
    <PageIntro
      eyebrow={`Learning routes · ${metrics.publishedRouteCount} published`}
      title="学习路线"
      description="路线不是完成率游戏，而是把前置概念、关键组成和判断问题排成一条能够解释为什么的阅读顺序。"
    />

    <section class="route-register" aria-label="已发布学习路线">
      {
        routes.map((route) => (
          <article class="route-entry">
            <div class="route-index">
              <span class="meta-label">Route {String(route.order).padStart(2, '0')}</span>
              <strong>{String(route.order).padStart(2, '0')}</strong>
            </div>
            <div class="route-copy">
              <StatusTag status={route.status} />
              <h2>
                <a href={`/routes/${route.id}/`}>{route.nameZh}</a>
              </h2>
              <p>{route.summary}</p>
              <dl>
                <div>
                  <>
                    <dt>章节</dt>
                    <dd>{route.chapters.length}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>代表词条</dt>
                    <dd>{route.estimatedTerms}</dd>
                  </>
                </div>
              </dl>
              <a class="route-link" href={`/routes/${route.id}/`}>
                查看完整学习顺序
              </a>
            </div>
            <ol class="chapter-preview">
              {route.chapters.map((chapter, index) => (
                <li>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <strong>{chapter.title}</strong>
                  <small>{chapter.terms.length} 个词条</small>
                </li>
              ))}
            </ol>
          </article>
        ))
      }
    </section>
  </main>
</BaseLayout>

<style>
  .route-entry {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .route-index {
    min-height: 3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-2) 1.25rem;
  }
  .route-index strong {
    color: var(--color-prerequisite);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1;
  }
  .route-copy {
    border-bottom: 1px solid var(--color-line);
    padding: 1.25rem;
  }
  .route-copy h2 {
    margin: var(--space-2) 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 650;
    line-height: 1.35;
  }
  .route-copy h2 a {
    text-decoration: none;
  }
  .route-copy h2 a:hover {
    color: var(--color-prerequisite);
  }
  .route-copy > p {
    max-width: 40rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .route-copy dl {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: var(--space-3) 0 0;
    border-top: 1px solid var(--color-line-soft);
  }
  .route-copy dl div {
    padding-top: var(--space-2);
  }
  .route-copy dt {
    color: var(--color-quiet);
    font-size: var(--text-xs);
  }
  .route-copy dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
  }
  .route-link {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    margin-top: var(--space-3);
    border-bottom: 1px solid var(--color-prerequisite);
    color: var(--color-prerequisite);
    text-decoration: none;
  }
  .chapter-preview {
    margin: 0;
    padding: var(--space-1) 1.25rem var(--space-2);
    list-style: none;
  }
  .chapter-preview li {
    min-height: 3.25rem;
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-2) 0;
  }
  .chapter-preview span {
    color: var(--color-component);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .chapter-preview strong {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
  }
  .chapter-preview small {
    color: var(--color-quiet);
    font-size: var(--text-xs);
  }

  @media (max-width: 580px) {
    .route-copy {
      padding: var(--space-3);
    }
    .chapter-preview {
      padding-inline: var(--space-3);
    }
    .chapter-preview li {
      grid-template-columns: 2rem 1fr;
    }
    .chapter-preview small {
      grid-column: 2;
    }
  }
</style>
