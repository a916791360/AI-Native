---
import PageIntro from '@/components/layout/PageIntro.astro';
import StatusTag from '@/components/ui/StatusTag.astro';
import { PLANNED_ROUTES } from '@/config/navigation';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { loadProjectContent } from '@/lib/content/io';

const { routes } = await loadProjectContent();
const route = routes[0]?.data;
---

<BaseLayout title="学习路线" description="沿有顺序的词条路线系统学习 AI。">
  <main id="main-content">
    <PageIntro
      eyebrow="Learning routes · ordered reading"
      title="学习路线"
      description="路线不是完成率游戏，而是把前置概念、关键组成和判断问题排成一条能够解释为什么的阅读顺序。"
    />
    {
      route && (
        <section class="featured-route" aria-labelledby="featured-route-title">
          <div class="route-index">
            <span class="meta-label">Route 01 / Draft</span>
            <span class="route-mark">01</span>
          </div>
          <div class="route-copy">
            <StatusTag status="draft" />
            <h2 id="featured-route-title">{route.nameZh}</h2>
            <p>{route.summary}</p>
            <a href={`/routes/${route.id}/`}>查看 3 章学习顺序 →</a>
          </div>
          <ol class="chapter-preview">
            {route.chapters.map((chapter, index) => (
              <li>
                <span>0{index + 1}</span>
                <strong>{chapter.title}</strong>
                <small>{chapter.terms.length} 个词条</small>
              </li>
            ))}
          </ol>
        </section>
      )
    }
    <section class="planned-routes" aria-labelledby="planned-title">
      <header>
        <p class="eyebrow">Next routes</p>
        <h2 class="section-heading" id="planned-title">后续路线</h2>
      </header>
      <div>
        {
          PLANNED_ROUTES.map((item, index) => (
            <article>
              <span class="meta-label">Route 0{index + 2}</span>
              <h3>{item.name}</h3>
              <StatusTag status="planned" />
            </article>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .featured-route {
    min-height: 34rem;
    display: grid;
    grid-template-columns: 9rem minmax(22rem, 0.8fr) minmax(24rem, 1fr);
    border-bottom: 1px solid var(--color-line);
  }
  .route-index {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid var(--color-line);
    padding: var(--space-4);
  }
  .route-mark {
    color: var(--color-prerequisite);
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
  }
  .route-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    border-right: 1px solid var(--color-line);
    padding: var(--space-6) var(--page-gutter);
  }
  .route-copy h2 {
    max-width: 10em;
    margin: var(--space-4) 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.04;
  }
  .route-copy p {
    max-width: 33rem;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-lead);
  }
  .route-copy a {
    margin-top: var(--space-5);
    color: var(--color-prerequisite);
  }
  .chapter-preview {
    display: grid;
    align-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chapter-preview li {
    min-height: 8rem;
    display: grid;
    grid-template-columns: 2.5rem 1fr auto;
    align-items: center;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-line-soft);
    padding: var(--space-3) var(--page-gutter);
  }
  .chapter-preview span {
    color: var(--color-component);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .chapter-preview strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
  }
  .chapter-preview small {
    color: var(--color-quiet);
  }
  .planned-routes {
    display: grid;
    grid-template-columns: minmax(16rem, 0.3fr) 1fr;
  }
  .planned-routes > header {
    border-right: 1px solid var(--color-line);
    padding: var(--space-6) var(--page-gutter);
  }
  .planned-routes > div {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .planned-routes article {
    min-height: 14rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-right: 1px solid var(--color-line);
    padding: var(--space-4);
  }
  .planned-routes h3 {
    margin: auto 0 var(--space-3);
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
  }

  @media (max-width: 860px) {
    .featured-route {
      grid-template-columns: 4rem 1fr;
    }
    .route-index {
      grid-row: 1 / 3;
    }
    .route-copy {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .planned-routes {
      grid-template-columns: 1fr;
    }
    .planned-routes > header {
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
  }

  @media (max-width: 580px) {
    .featured-route {
      grid-template-columns: 1fr;
    }
    .route-index {
      min-height: 5rem;
      grid-row: auto;
      flex-direction: row;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }
    .route-mark {
      font-size: 2.5rem;
    }
    .chapter-preview li {
      grid-template-columns: 2rem 1fr;
    }
    .chapter-preview small {
      grid-column: 2;
    }
    .planned-routes > div {
      grid-template-columns: 1fr;
    }
    .planned-routes article {
      min-height: 9rem;
      border-bottom: 1px solid var(--color-line-soft);
    }
  }
</style>
