import SearchExperience from '@/components/search/SearchExperience.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="搜索 AI-Native 的中文 AI 词条、别名与已核验正文。">
  <main id="main-content" class="search-page">
    <PageIntro
      eyebrow="Search · Terms and verified content"
      title="搜索"
      description="定位概念、辨别边界，并继续沿关系阅读。"
    />
    <SearchExperience />
  </main>
</BaseLayout>
