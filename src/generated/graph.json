    },
    {
      "id": "context-window",
      "label": "上下文窗口",
      "labelEn": "Context Window",
      "url": "/terms/context-window/",
      "summary": "模型一次推理能够共同处理的输入、历史信息、工具结果和输出所占 Token 范围。",
      "domain": "prompt-context-engineering",
      "difficulty": "beginner",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "document-chunking",
      "label": "文档切片",
      "labelEn": "Document Chunking",
      "url": "/terms/document-chunking/",
      "summary": "按结构或语义把长文档拆成较小知识单元，以便建立索引、检索和放入上下文。",
      "domain": "data-retrieval-rag",
      "difficulty": "intermediate",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "embedding",
      "label": "嵌入",
      "labelEn": "Embedding",
      "url": "/terms/embedding/",
      "summary": "把文本、图像或其他对象表示为数值向量，使语义或特征关系可以被计算和比较。",
      "domain": "data-retrieval-rag",
      "difficulty": "intermediate",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "generative-ai",
      "label": "生成式 AI",
      "labelEn": "Generative AI",
      "url": "/terms/generative-ai/",
      "summary": "根据训练中学到的模式生成文本、图像、音频或其他新内容的一类人工智能方法。",
      "domain": "large-language-models-generative-ai",
      "difficulty": "beginner",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "hallucination",
      "label": "幻觉",
      "labelEn": "Hallucination",
      "url": "/terms/hallucination/",
      "summary": "生成模型给出看似合理但无法由事实、输入或可靠证据支持的内容这一现象。",
      "domain": "evaluation-observability-quality",
      "difficulty": "beginner",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "large-language-model",
      "label": "大语言模型",
      "labelEn": "Large Language Model",
      "url": "/terms/large-language-model/",
      "summary": "在大量文本或多模态数据上训练、能够理解和生成语言序列的深度学习模型。",
      "domain": "large-language-models-generative-ai",
      "difficulty": "beginner",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "reranking",
      "label": "重排",
      "labelEn": "Reranking",
      "url": "/terms/reranking/",
      "summary": "使用更精细的相关性模型对初次召回结果再次评分并调整顺序的检索步骤。",
      "domain": "data-retrieval-rag",
      "difficulty": "advanced",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "retrieval",
      "label": "检索",
      "labelEn": "Retrieval",
      "url": "/terms/retrieval/",
      "summary": "根据查询从文档、数据库或其他知识源中找到相关候选信息的过程。",
      "domain": "data-retrieval-rag",
      "difficulty": "intermediate",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "retrieval-augmented-generation",
      "label": "检索增强生成",
      "labelEn": "Retrieval-Augmented Generation",
      "url": "/terms/retrieval-augmented-generation/",
      "summary": "在模型生成回答前检索外部资料，并把候选证据作为上下文提供给生成模型的方法。",
      "domain": "data-retrieval-rag",
      "difficulty": "intermediate",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "token",
      "label": "Token",
      "labelEn": "Token",
      "url": "/terms/token/",
      "summary": "模型读取和生成文本时使用的离散单位，一个 Token 不一定对应一个完整汉字或单词。",
      "domain": "large-language-models-generative-ai",
      "difficulty": "beginner",
      "ring": "core",
      "status": "verified"
    },
    {
      "id": "vector-database",
      "label": "向量数据库",
      "labelEn": "Vector Database",
      "url": "/terms/vector-database/",
      "summary": "专门存储、索引并按相似度查询高维向量的数据系统，常用于语义检索。",
      "domain": "data-retrieval-rag",
      "difficulty": "intermediate",
      "ring": "core",
      "status": "verified"
    }
  ],
  "edges": [
    {
      "id": "ai-compared-with-generative-ai",
