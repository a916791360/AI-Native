    },
    {
      "id": "ai-precedes-generative-ai",
      "source": "artificial-intelligence",
      "target": "generative-ai",
      "type": "prerequisite",
      "explanation": "先理解人工智能的整体范围，才能判断生成式 AI 在其中解决的是哪一类问题。"
    },
    {
      "id": "chunking-component-of-rag",
      "source": "document-chunking",
      "target": "retrieval-augmented-generation",
      "type": "component",
